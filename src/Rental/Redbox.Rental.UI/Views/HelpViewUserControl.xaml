<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.HelpViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="DocumentViewerStyle" TargetType="{x:Type DocumentViewer}" BasedOn="{x:Null}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DocumentViewer}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Focusable="False">
                <Grid Background="{TemplateBinding Control.Background}" KeyboardNavigation.TabNavigation="Local">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ScrollViewer Name="PART_ContentHost" CanContentScroll="True" Grid.Column="0" Focusable="{TemplateBinding UIElement.Focusable}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" IsTabStop="True" Grid.Row="1" TabIndex="1" />
                  <DockPanel Grid.Row="1">
                    <FrameworkElement DockPanel.Dock="Right" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
                  </DockPanel>
                  <ContentControl Name="PART_FindToolBarHost" Visibility="Collapsed" Grid.Column="0" Focusable="{TemplateBinding UIElement.Focusable}" Grid.Row="2" TabIndex="2" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:HelpViewCommands.GoBack}" Executed="GoBackCommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:HelpViewCommands.PageLeft}" Executed="PageLeftCommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:HelpViewCommands.PageRight}" Executed="PageRightCommandBinding_Executed" />
    <CommandBinding x:Name="ShowDocumentCommand" Command="{x:Static local:HelpViewCommands.ShowDocument}" Executed="ShowDocumentCommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:HelpViewCommands.RedboxLogoCommand}" Executed="RedboxLogoCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Name="upperpart_gray_background" Height="568" Width="1024" VerticalAlignment="Top" Background="#EAEAEA" />
    <Grid Name="center_gray_background" Background="#9F9F9F" Margin="0,568,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Height="54" Width="1024">
      <Border Name="back_button" Style="{StaticResource gray_button_style}" Margin="23,0,0,0" Width="114" VerticalAlignment="Center">
        <UIElement.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.GoBack}" />
        </UIElement.InputBindings>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
          <Image Width="21" Height="18" Margin="0,0,15,0" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/back-white-arrow.png" />
          <TextBlock Name="ButtonGoBack_Text" Style="{StaticResource font_target_smaller}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="BACK" />
        </StackPanel>
      </Border>
      <StackPanel Margin="230,0,0,0" Orientation="Horizontal">
        <Border Name="faq_button" Style="{StaticResource gray_button_style}" IsEnabled="False">
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.ShowDocument}" />
          </UIElement.InputBindings>
          <TextBlock Name="ButtonFAQ_Text" Style="{StaticResource gray_button_text_style}" IsEnabled="True" Text="Rental FAQ" />
        </Border>
        <Border Name="terms_button" Style="{StaticResource gray_button_style}">
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.ShowDocument}" />
          </UIElement.InputBindings>
          <TextBlock Name="ButtonTerms_Text" Style="{StaticResource gray_button_text_style}" Text="Rental Terms" />
        </Border>
        <Border Name="terms_redbox_card_button" Style="{StaticResource gray_button_style}">
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.ShowDocument}" />
          </UIElement.InputBindings>
          <TextBlock Name="ButtonTermsRedboxCard_Text" Style="{StaticResource gray_button_text_style}" Text="Redbox Card Terms" />
        </Border>
        <Border Name="privacy_button" Style="{StaticResource gray_button_style}">
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.ShowDocument}" />
          </UIElement.InputBindings>
          <TextBlock Name="ButtonPrivacy_Text" Style="{StaticResource gray_button_text_style}" Text="Privacy" />
        </Border>
        <Border Name="play_pass_button" Style="{StaticResource gray_button_style}" Margin="10,10,10,0" Width="115">
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.ShowDocument}" />
          </UIElement.InputBindings>
          <TextBlock Name="ButtonPlayPass_Text" Style="{StaticResource gray_button_text_style}" Text="Play Pass" />
        </Border>
      </StackPanel>
    </Grid>
    <TextBlock Name="title_label" Margin="25,14,0,0" Width="512" Height="42" Foreground="#2C2E32" VerticalAlignment="Top" HorizontalAlignment="Left" Text="Title" Style="{StaticResource font_target_medium}" />
    <TextBlock Name="contact_redbox_label" Margin="110,29,0,0" Width="600" Height="40" Foreground="#2C2E32" VerticalAlignment="Top" HorizontalAlignment="Left" Text="Contact Redbox customer service at 1.866.REDBOX3 (1.866.733.2693)" Style="{StaticResource font_akzidenz_regular_small}" />
    <TextBlock Name="store_number_label" Margin="864,29,0,0" Width="90" Height="40" Foreground="#FF000000" VerticalAlignment="Top" HorizontalAlignment="Left" Text="Kiosk ID:" Style="{StaticResource font_akzidenz_regular_16}" />
    <TextBlock Name="store_number_text" Margin="945,29,0,0" Width="110" Height="40" Foreground="#FF000000" VerticalAlignment="Top" HorizontalAlignment="Left" Text="Store#" Style="{StaticResource font_akzidenz_regular_16}" />
    <Grid Name="draw_line" Margin="19,69,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="985" Height="3" Background="#2C2E32" />
    <TextBlock Name="page_counter" Margin="470,72,0,0" Width="600" Height="40" Foreground="#2C2E32" VerticalAlignment="Top" HorizontalAlignment="Left" Text="Page" Style="{StaticResource font_akzidenz_regular_tiny}" />
    <Image Name="left_arrow" Margin="0,197,0,0" Height="292" Width="53" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/left-navigation-arrow.png">
      <UIElement.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.PageLeft}" />
      </UIElement.InputBindings>
    </Image>
    <Image Name="right_arrow" Margin="971,197,0,0" Height="292" Width="53" Stretch="Fill" VerticalAlignment="Top" HorizontalAlignment="Left" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/right-navigation-arrow.png">
      <UIElement.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.PageRight}" />
      </UIElement.InputBindings>
    </Image>
    <Rectangle Name="DocumentPageVisual" Margin="85,93,0,0" Width="886" Height="455" VerticalAlignment="Top" HorizontalAlignment="Left" />
    <Grid Name="action_zone_background_border" Margin="0,622,0,0" Width="1024" Height="69" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#303030" />
    <Grid Name="action_zone_background" Margin="0,624,0,0" Width="1024" Height="146" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#3C3C3C" />
    <Image Name="redbox_logo" Margin="50,667,0,0" Width="133" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/redbox-logo.png">
      <UIElement.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.RedboxLogoCommand}" />
      </UIElement.InputBindings>
    </Image>
  </Grid>
</controls:TextToSpeechUserControl>