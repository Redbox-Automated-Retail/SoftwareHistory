<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.HelpViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:designModel="clr-namespace:Redbox.Rental.UI.Models.DesignTime" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:HelpViewCommands.GoBack}" Executed="GoBackCommandBinding_Executed" />
    <CommandBinding x:Name="ShowDocumentCommand" Command="{x:Static local:HelpViewCommands.ShowDocument}" Executed="ShowDocumentCommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:HelpViewCommands.RedboxLogoCommand}" Executed="RedboxLogoCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Name="upperpart_gray_background" Height="568" Width="1024" VerticalAlignment="Top" Background="#EAEAEA" />
    <controls:HelpDocViewUserControl OnHelpPaddleButtonPressed="HandleHelpPaddleButtonPresed" XpsDocument="{Binding XpsDocument}" CurrentPageNumber="{Binding CurrentHelpDocumentPage, Mode=TwoWay}" TotalPageCount="{Binding HelpDocumentPageCount, Mode=OneWayToSource}" CurrentPageText="{Binding CurrentPageText, Mode=OneWayToSource}" PageCounterText="{Binding PageCounterText}" />
    <TextBlock Name="title_label" Margin="25,14,0,0" Width="512" Height="42" Foreground="#2C2E32" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource font_target_medium}" Text="{Binding Path=TitleText, FallbackValue=Title}" />
    <TextBlock Name="contact_redbox_label" Margin="110,29,0,0" Width="600" Height="40" Foreground="#2C2E32" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource font_montserrat_regular_17}" Text="{Binding Path=ContactText, FallbackValue=Contact Redbox customer service at 1.866.REDBOX3 (1.866.733.2693)}" Visibility="{Binding ShowContactText, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}" />
    <TextBlock Name="store_number_label" Margin="864,29,0,0" Width="90" Height="40" Foreground="#FF000000" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource font_montserrat_regular_18}" Text="{Binding Path=StoreNumberLabel, FallbackValue=Kiosk ID:}" />
    <TextBlock Name="store_number_text" Margin="945,29,0,0" Width="110" Height="40" Foreground="#FF000000" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource font_montserrat_regular_18}" Text="{Binding Path=StoreNumberText, FallbackValue=Store#}" />
    <Grid Name="draw_line" Margin="19,69,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="985" Height="3" Background="#2C2E32" />
    <Grid Name="action_zone_background" Margin="0,560,0,0" Width="1024" Height="208" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#380B44">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="4*" />
      </Grid.ColumnDefinitions>
      <Image Name="redbox_logo" Grid.Column="0" Margin="40,50,0,0" Width="133" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/logoWhite.png">
        <UIElement.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{x:Static local:HelpViewCommands.RedboxLogoCommand}" />
        </UIElement.InputBindings>
      </Image>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <ItemsControl Name="top_row_buttons_items_control" ItemsSource="{Binding TopRowButtonList}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,35,0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Redbox:RoundedButton Width="Auto" MinWidth="114" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="13,40,13,0" Style="{StaticResource classic_rubine_radio_button_style}" Command="{x:Static local:HelpViewCommands.ShowDocument}" Visibility="Visible" CornerRadius="22" Tag="{Binding DocumentToShow}" IsEnabled="{Binding IsEnabled}">
                <Grid Height="44">
                  <TextBlock Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_16}" FontSize="15" Margin="22,0,22,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding ButtonText}" />
                  <Border Name="brdDocUpdated" Style="{StaticResource help_updated_border_style}" Visibility="{Binding Path=ShowUpdatedFlag, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
                    <TextBlock Style="{StaticResource help_updated_text_style}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding UpdatedText}" />
                  </Border>
                </Grid>
              </Redbox:RoundedButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Name="bottom_row_buttons_items_control" ItemsSource="{Binding BottomRowButtonList}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,35,0" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Redbox:RoundedButton Width="Auto" MinWidth="114" Height="48" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="13,40,13,0" Style="{StaticResource classic_rubine_radio_button_style}" Command="{x:Static local:HelpViewCommands.ShowDocument}" Visibility="Visible" CornerRadius="22" Tag="{Binding DocumentToShow}" IsEnabled="{Binding IsEnabled}">
                <Grid Height="44">
                  <TextBlock Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_16}" FontSize="15" Margin="22,0,22,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding ButtonText}" />
                  <Border Name="brdDocUpdated" Style="{StaticResource help_updated_border_style}" Visibility="{Binding Path=ShowUpdatedFlag, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
                    <TextBlock Style="{StaticResource help_updated_text_style}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding UpdatedText}" />
                  </Border>
                </Grid>
              </Redbox:RoundedButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Redbox:RoundedButton Name="back_button" Grid.Column="0" Style="{StaticResource white_button_style}" Margin="24,0,18,24" MinWidth="101" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="44" CornerRadius="22" Command="{x:Static local:HelpViewCommands.GoBack}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
          <TextBlock Name="ButtonGoBack_Text" Style="{StaticResource font_museo_slab_900_20}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E42045" Text="{Binding BackButtonText, FallbackValue=Back}" />
        </StackPanel>
      </Redbox:RoundedButton>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>