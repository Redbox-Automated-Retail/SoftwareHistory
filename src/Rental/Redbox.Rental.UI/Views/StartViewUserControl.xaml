<?xml version="1.0" encoding="utf-8"?>
<localControls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.StartViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.RentOrBuyMoviesCommand}" Executed="RentOrBuyMoviesCommandBinding_Executed" CanExecute="RentOrBuyMoviesCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.RentOrBuyGamesCommand}" Executed="RentOrBuyGamesCommandBinding_Executed" CanExecute="RentGamesCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.BuyMoviesOrGamesCommand}" Executed="BuyMoviesOrGamesCommandBinding_Executed" CanExecute="BuyMoviesOrGameCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.PickupProductCommand}" Executed="PickupProductCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.ReturnProductCommand}" Executed="ReturnProductCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.HelpCommand}" Executed="HelpCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.ToggleLanguageModeCommand}" Executed="ToggleLanguageModeCommandBinding_Executed" CanExecute="ToggleLanguageModeCommandBingind_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.ToggleADAModeCommand}" Executed="ToggleADAModeCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.ExitBurnInViewCommand}" Executed="ExitBurnInViewCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.BannerClickCommand}" Executed="BannerClickCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Name="MainGrid" Focusable="False" Background="#FF000000" Width="1500" Height="1152">
    <TextBlock Name="ExitBurnInViewLabel" Style="{StaticResource font_target_large}" Foreground="#FFFFFFFF" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0, 668,0,0" Width="1024" Text="{Binding Path=BurnInViewLabelText, FallbackValue=touch here to rent or return}">
      <UIElement.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.ExitBurnInViewCommand}" />
      </UIElement.InputBindings>
    </TextBlock>
    <Image Name="GrayChevronBackgroundImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/GrayChevronBackground.png" HorizontalAlignment="Left" VerticalAlignment="Top" Height="768" Visibility="{Binding Path=BurnInVisibility, FallbackValue=Visible}" />
    <localControls:RedboxClassicProductCarouselUserControl DataContext="{Binding Path=CarouselModel}" />
    <Grid Name="BurnInGrid" Visibility="{Binding Path=BurnInVisibility, FallbackValue=Visible}">
      <Image Name="LoadingTitlesImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/Loading-titles-image-Alt-carousel.png" VerticalAlignment="Top" HorizontalAlignment="Left" Stretch="None" Visibility="{Binding Path=LoadingTitlesImageVisibility, FallbackValue=Collapsed}" />
      <Grid Name="banner_grid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="328,0,0,0" Width="696" Height="120" Visibility="{Binding Path=BannerVisibility, FallbackValue=Collapsed}">
        <Image Name="banner_image" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" Source="{Binding Path=BannerImage}">
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.BannerClickCommand}" />
          </UIElement.InputBindings>
        </Image>
        <Grid Name="banner_top_line" Background="#A1A1A1" VerticalAlignment="Top" Height="3" />
        <Grid Name="banner_bottom_line" Background="#A1A1A1" VerticalAlignment="Bottom" Height="3" />
      </Grid>
      <Grid Name="box_behind_redbox_logo" HorizontalAlignment="Left" VerticalAlignment="Top" Width="328" Height="120">
        <StackPanel Orientation="Vertical">
          <Grid Height="3" Background="#6F6F6F" />
          <Grid Height="114">
            <Panel.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#8B8B8B" Offset="0" />
                <GradientStop Color="#BBBBBB" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
          </Grid>
          <Grid Height="3" Background="#6F6F6F" />
        </StackPanel>
      </Grid>
      <Grid Name="navigation_side_bar" Margin="8,0,0,0" Width="320" Height="768" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.4">
        <Grid.RowDefinitions>
          <RowDefinition Height="83*" />
          <RowDefinition Height="685*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.RowSpan="2">
          <Grid Width="5" Height="768">
            <Panel.Background>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#E3E3E3" Offset="0" />
                <GradientStop Color="#D1D1D1" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
          </Grid>
          <Grid Width="310">
            <Panel.Background>
              <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#999999" Offset="0" />
                <GradientStop Color="#BEBEBE" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
          </Grid>
          <Grid Width="5">
            <Panel.Background>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#E3E3E3" Offset="0" />
                <GradientStop Color="#D1D1D1" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
          </Grid>
        </StackPanel>
      </Grid>
      <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/kiosk-2-redbox-logo.png" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,35,0,0" Height="66" />
      <StackPanel Margin="25,215,0,0">
        <localControls:RoundedButton x:Name="all_movies_button" Style="{StaticResource classic_red_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="118" Width="290" CornerRadius="30" Command="{x:Static localbase:Commands.RentOrBuyMoviesCommand}" Focusable="False">
          <Grid>
            <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type localControls:RoundedButton}}}">
              <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/kiosk-2-movie-icon.png" Height="145" HorizontalAlignment="Left">
                <UIElement.Clip>
                  <GeometryGroup FillRule="Nonzero">
                    <RectangleGeometry Rect="30,0,120,118" />
                    <RectangleGeometry Rect="0,30,120,58" />
                    <EllipseGeometry RadiusX="30" RadiusY="30" Center="30,30" />
                    <EllipseGeometry RadiusX="30" RadiusY="30" Center="30,88" />
                  </GeometryGroup>
                </UIElement.Clip>
              </Image>
            </DockPanel>
            <StackPanel VerticalAlignment="Center" Margin="100,0,0,0">
              <TextBlock Name="all_movies_button_text_line1" Style="{StaticResource font_bryant_bold_20}" Text="{Binding Path=AllMoviesButtonTextLine1, FallbackValue=RENT}" />
              <TextBlock Name="all_movies_button_text_line2" Style="{Binding Path=AllMoviesButtonTextLine2Style, FallbackValue={StaticResource font_bryant_bold_34}}" Text="{Binding Path=AllMoviesButtonTextLine2, FallbackValue=MOVIES}" />
            </StackPanel>
          </Grid>
        </localControls:RoundedButton>
        <localControls:RoundedButton x:Name="games_button" Style="{StaticResource classic_red_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Height="118" Width="290" CornerRadius="30" Command="{x:Static localbase:Commands.RentOrBuyGamesCommand}" Focusable="False" Visibility="{Binding Path=RentOrBuyGamesButtonVisibility, FallbackValue=Visible}">
          <Grid>
            <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type localControls:RoundedButton}}}">
              <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/kiosk-2-game-icon.png" Height="130" HorizontalAlignment="Left">
                <UIElement.Clip>
                  <GeometryGroup FillRule="Nonzero">
                    <RectangleGeometry Rect="30,0,120,118" />
                    <RectangleGeometry Rect="0,30,120,118" />
                    <EllipseGeometry RadiusX="30" RadiusY="30" Center="30,30" />
                  </GeometryGroup>
                </UIElement.Clip>
              </Image>
            </DockPanel>
            <StackPanel VerticalAlignment="Center" Margin="100,0,0,0">
              <TextBlock Name="games_button_text_line1" TextWrapping="Wrap" Style="{Binding Path=GamesButtonTextLine1Style, FallbackValue={StaticResource font_bryant_bold_20}}" Text="{Binding Path=GamesButtonTextLine1, FallbackValue=RENT}" />
              <TextBlock Name="games_button_text_line2" Style="{StaticResource font_bryant_bold_34}" Text="{Binding Path=GamesButtonTextLine2, FallbackValue=GAMES}" />
            </StackPanel>
          </Grid>
        </localControls:RoundedButton>
        <localControls:RoundedButton x:Name="buy_movies_or_games_button" Style="{StaticResource classic_red_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Height="90" Width="290" CornerRadius="30" Command="{x:Static localbase:Commands.BuyMoviesOrGamesCommand}" Focusable="False" Visibility="{Binding Path=BuyMoviesOrGamesButtonVisibility, FallbackValue=Visible}">
          <Grid>
            <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type localControls:RoundedButton}}}">
              <Grid Height="91">
                <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/kiosk_icon.png" Height="77" VerticalAlignment="Bottom" HorizontalAlignment="Left">
                  <UIElement.Clip>
                    <GeometryGroup FillRule="Nonzero">
                      <RectangleGeometry Rect="0,0,80,48" />
                      <RectangleGeometry Rect="30,20,80,70" />
                      <EllipseGeometry RadiusX="30" RadiusY="30" Center="30,46" />
                    </GeometryGroup>
                  </UIElement.Clip>
                </Image>
              </Grid>
            </DockPanel>
            <StackPanel VerticalAlignment="Center" Margin="100,0,0,0">
              <TextBlock Name="buy_button_text_line1" TextWrapping="Wrap" Style="{Binding Path=BuyMoviesOrGamesButtonTextLine1Style, FallbackValue={StaticResource font_bryant_bold_16}}" Text="{Binding Path=BuyMoviesOrGamesButtonTextLine1, FallbackValue=MOVIES__GAMES}" />
              <TextBlock Name="buy_button_text_line2" Style="{Binding Path=BuyMoviesOrGamesButtonTextLine2Style, FallbackValue={StaticResource font_bryant_bold_28}}" Text="{Binding Path=BuyMoviesOrGamesButtonTextLine2, FallbackValue=FORSALE}" />
            </StackPanel>
          </Grid>
        </localControls:RoundedButton>
      </StackPanel>
      <StackPanel Margin="25,585,0,0">
        <localControls:RoundedButton x:Name="online_pickup_button" Style="{StaticResource classic_yellow_button_style}" Width="290" Height="77" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="39" BorderThickness="2" Command="{x:Static localbase:Commands.PickupProductCommand}" Focusable="False">
          <Grid>
            <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type localControls:RoundedButton}}}">
              <Grid Height="45">
                <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/kiosk-2-pickup-icon.png" Margin="30,0,0,0" HorizontalAlignment="Left" />
              </Grid>
            </DockPanel>
            <StackPanel Margin="100,0,0,0" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource font_bryant_bold_28}" Text="{Binding Path=PickUpButtonText, FallbackValue=PICK UP}" />
            </StackPanel>
          </Grid>
        </localControls:RoundedButton>
        <localControls:RoundedButton x:Name="return_button" Style="{StaticResource classic_yellow_button_style}" Margin="0,10,0,0" Width="290" Height="77" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="39" BorderThickness="2" Command="{x:Static localbase:Commands.ReturnProductCommand}" Focusable="False">
          <Grid>
            <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type localControls:RoundedButton}}}">
              <Grid Height="45">
                <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/kiosk-2-return-icon.png" Margin="30,0,0,0" HorizontalAlignment="Left" />
              </Grid>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="100,0,0,0">
              <TextBlock TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_bryant_bold_28}" Text="{Binding Path=ReturnButtonText, FallbackValue=RETURN}" />
            </StackPanel>
          </Grid>
        </localControls:RoundedButton>
      </StackPanel>
      <Grid Name="ada_turned_on_label_grid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="400,690,0,0" Width="285">
        <TextBlock Name="ada_turned_on_label" Style="{StaticResource font_akzidenz_regular_tiny}" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FFFFFFFF" Text="{Binding Path=AdaTurnedOnLabelText, FallbackValue=Screens will now be ADA-compatible. &#xA;Use the buttons on the left to continue.}" Visibility="{Binding Path=AdaTurnedOnLabelVisibility, FallbackValue=collapsed}" />
      </Grid>
      <localControls:RoundedButton x:Name="handicap_button" Style="{StaticResource classic_gray_button_style}" CornerRadius="31" Margin="695,678,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="62" Height="62" Command="{x:Static localbase:Commands.ToggleADAModeCommand}" Focusable="False">
        <UserControl Name="handicap_button_icon_off" Foreground="#DEDEDE" Style="{StaticResource handicap_icon}" Margin="-2, 4, 0,0" Width="67" Height="67" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
              <SkewTransform />
              <RotateTransform />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </UserControl>
      </localControls:RoundedButton>
      <Grid Name="handicap_button_on" Margin="695, 678, 0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="{Binding Path=AdaTurnedOnLabelVisibility}">
        <UIElement.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.ToggleADAModeCommand}" />
        </UIElement.InputBindings>
        <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top" Width="62" Height="62" Fill="#3C3939" />
        <Ellipse Width="32" Height="32" Margin="40,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="#3C3939" />
        <Ellipse Width="29" Height="29" Margin="42,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="#D7D7D7" />
        <Ellipse HorizontalAlignment="Left" Margin="3,3,1,1" VerticalAlignment="Top" Width="58" Height="58" Fill="#D7D7D7" />
        <TextBlock Foreground="#3C3939" Style="{StaticResource font_akzidenz_bold_tiny}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,8,0,0">ON</TextBlock>
        <UserControl Name="handicap_button_icon_on" Foreground="#3C3939" Style="{StaticResource handicap_icon}" Margin="-2, 4, 0,0" Width="67" Height="67" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
              <SkewTransform />
              <RotateTransform />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </UserControl>
      </Grid>
      <localControls:RoundedButton x:Name="espanol_button" Style="{StaticResource classic_gray_button_style}" CornerRadius="31" Margin="770,678,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="148" Height="62" Command="{x:Static localbase:Commands.ToggleLanguageModeCommand}" Focusable="False">
        <TextBlock VerticalAlignment="Center" Style="{StaticResource font_bryant_bold_18}" Text="{Binding Path=ToggleLanguageButtonText, FallbackValue=ESPAÑOL}" />
      </localControls:RoundedButton>
      <localControls:RoundedButton x:Name="help_button" Style="{StaticResource classic_gray_button_style}" CornerRadius="31" Margin="932,678,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="62" Height="62" Command="{x:Static localbase:Commands.HelpCommand}" Focusable="False">
        <TextBlock Style="{StaticResource font_bryant_bold_28}">?</TextBlock>
      </localControls:RoundedButton>
    </Grid>
  </Grid>
</localControls:TextToSpeechUserControl>