<?xml version="1.0" encoding="utf-8"?>
<localControls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.StartViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.RentOrBuyMoviesCommand}" Executed="RentOrBuyMoviesCommandBinding_Executed" CanExecute="RentOrBuyMoviesCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.RentOrBuyGamesCommand}" Executed="RentOrBuyGamesCommandBinding_Executed" CanExecute="RentGamesCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.RentTVCommand}" Executed="RentTVCommandBinding_Executed" CanExecute="RentTVCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.BuyMoviesCommand}" Executed="BuyMoviesCommandBinding_Executed" CanExecute="BuyMoviesCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.BuyGamesCommand}" Executed="BuyGamesCommandBinding_Executed" CanExecute="BuyGamesCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.PickupProductCommand}" Executed="PickupProductCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.ReturnProductCommand}" Executed="ReturnProductCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.HelpCommand}" Executed="HelpCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.ToggleLanguageModeCommand}" Executed="ToggleLanguageModeCommandBinding_Executed" CanExecute="ToggleLanguageModeCommandBingind_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.ToggleADAModeCommand}" Executed="ToggleADAModeCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.ExitBurnInViewCommand}" Executed="ExitBurnInViewCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.BannerClickCommand}" Executed="BannerClickCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.SignInCommand}" Executed="SignInCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:ReverseBoolToVisibilityConverter x:Key="NotBoolToVisibility" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainGrid" Focusable="False" Background="#FF000000" Width="1500" Height="1152">
    <TextBlock Name="ExitBurnInViewLabel" Style="{StaticResource font_target_large}" Foreground="#E42045" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0, 668,0,0" Width="1024" Text="{Binding Path=BurnInViewLabelText, FallbackValue=touch here to rent or return}">
      <UIElement.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.ExitBurnInViewCommand}" />
      </UIElement.InputBindings>
    </TextBlock>
    <Grid Name="NonBurnInBackground" Background="#FFFFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1024" Height="768" Visibility="{Binding Path=BurnInVisibility, FallbackValue=Visible}" />
    <Image Name="PinkDotsBackgroundImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/backgroundTexture.png" HorizontalAlignment="Left" VerticalAlignment="Top" Height="768" Visibility="{Binding Path=BurnInVisibility, FallbackValue=Visible}" />
    <Grid Visibility="{Binding IsReturnOnlyMode, Converter={StaticResource NotBoolToVisibility}}">
      <Image Name="PurpleGradientImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/horizontalBackgroundGradient.png" HorizontalAlignment="Left" Height="Auto" Margin="0,98,0,489" Width="1024" Visibility="{Binding Path=BurnInVisibility, FallbackValue=Visible}" />
      <localControls:RedboxClassicProductCarouselUserControl DataContext="{Binding Path=CarouselModel}" />
    </Grid>
    <Grid Name="BurnInGrid" Visibility="{Binding Path=BurnInVisibility, FallbackValue=Visible}">
      <Image Name="LoadingTitlesImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/Loading-titles-image-Alt-carousel.png" VerticalAlignment="Top" HorizontalAlignment="Left" Stretch="None" Visibility="{Binding Path=LoadingTitlesImageVisibility, FallbackValue=Collapsed}" />
      <Grid Name="banner_grid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="328,0,0,0" Width="696" Height="120" Visibility="{Binding Path=BannerVisibility, FallbackValue=Collapsed}">
        <Image Name="banner_image" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None" Source="{Binding Path=BannerImage}">
          <UIElement.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.BannerClickCommand}" />
          </UIElement.InputBindings>
        </Image>
      </Grid>
      <Grid Name="navigation_side_bar" Background="#E42045" Margin="8,0,0,0" Width="320" Height="768" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="1.0" />
      <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/logo@2x.png" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="44,35,0,0" Height="60" />
      <StackPanel Margin="25,215,0,0">
        <Redbox:RoundedButton Name="all_movies_button" Style="{StaticResource white_purple_border_gradient_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="290" Command="{x:Static localbase:Commands.RentOrBuyMoviesCommand}" Focusable="False" Height="{Binding Path=AllMoviesButtonHeight, FallbackValue=118}" CornerRadius="{Binding Path=AllMoviesButtonCornerRadius, FallbackValue=59}" Visibility="{Binding IsReturnOnlyMode, Converter={StaticResource NotBoolToVisibility}}">
          <Grid>
            <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type Redbox:RoundedButton}}}">
              <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/movieicon.png" HorizontalAlignment="Left" Margin="28,12,0,12" Width="60" />
            </DockPanel>
            <StackPanel VerticalAlignment="Center" Margin="100,0,0,0">
              <TextBlock Name="all_movies_button_text_line1" Style="{StaticResource font_montserrat_regular_26}" Foreground="#FF000000" Text="{Binding Path=AllMoviesButtonTextLine1, FallbackValue=RENT}" />
              <TextBlock Name="all_movies_button_text_line2" Style="{Binding Path=AllMoviesButtonTextLine2Style, FallbackValue={StaticResource font_museo_slab_900_32}}" Text="{Binding Path=AllMoviesButtonTextLine2, FallbackValue=MOVIES}" />
            </StackPanel>
          </Grid>
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="games_button" Style="{StaticResource white_purple_border_gradient_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Width="290" Command="{x:Static localbase:Commands.RentOrBuyGamesCommand}" Focusable="False" Height="{Binding Path=GamesButtonHeight, FallbackValue=118}" CornerRadius="{Binding Path=GamesButtonCornerRadius, FallbackValue=59}" Visibility="{Binding Path=RentOrBuyGamesButtonVisibility, FallbackValue=Visible}" IsEnabled="{Binding RentGamesEnabled}">
          <Grid>
            <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type Redbox:RoundedButton}}}">
              <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/gameControllerIconCopy.png" HorizontalAlignment="Left" Margin="28,0,0,12" Width="60" RenderTransformOrigin="0.5,0.5">
                <UIElement.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="20.409" />
                    <TranslateTransform />
                  </TransformGroup>
                </UIElement.RenderTransform>
              </Image>
            </DockPanel>
            <StackPanel VerticalAlignment="Center" Margin="100,0,0,0">
              <TextBlock Name="games_button_text_line1" Style="{StaticResource font_montserrat_regular_26}" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding Path=GamesButtonTextLine1, FallbackValue=RENT}" />
              <TextBlock Name="games_button_text_line2" Style="{StaticResource font_museo_slab_900_32}" Text="{Binding Path=GamesButtonTextLine2, FallbackValue=GAMES}" />
            </StackPanel>
          </Grid>
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="tv_button" Style="{StaticResource white_purple_border_gradient_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Height="80" Width="290" CornerRadius="40" Command="{x:Static localbase:Commands.RentTVCommand}" Focusable="False" Visibility="{Binding Path=RentTVButtonVisibility, FallbackValue=Collapsed}" IsEnabled="{Binding RentTVEnabled}">
          <Grid>
            <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type Redbox:RoundedButton}}}">
              <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/tvIcon.png" HorizontalAlignment="Left" Margin="28,8,0,12" Width="50" />
            </DockPanel>
            <StackPanel VerticalAlignment="Center" Margin="100,0,0,0">
              <TextBlock Name="tv_button_text_line1" Style="{StaticResource font_montserrat_regular_26}" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding Path=TVButtonTextLine1, FallbackValue=RENT}" />
              <TextBlock Name="tv_button_text_line2" Style="{StaticResource font_museo_slab_900_32}" Text="{Binding Path=TVButtonTextLine2, FallbackValue=TV}" />
            </StackPanel>
          </Grid>
        </Redbox:RoundedButton>
        <StackPanel Orientation="Horizontal">
          <Redbox:RoundedButton Name="buy_movies_button" Style="{StaticResource white_purple_border_gradient_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" Height="90" CornerRadius="45" Command="{x:Static localbase:Commands.BuyMoviesCommand}" Focusable="False" Width="{Binding Path=BuyMoviesButtonWidth, FallbackValue=290}" Visibility="{Binding Path=BuyMoviesOrGamesButtonVisibility, FallbackValue=Visible}" IsEnabled="{Binding BuyMoviesEnabled}">
            <Grid>
              <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type Redbox:RoundedButton}}}" />
              <StackPanel VerticalAlignment="Center" Margin="{Binding Path=BuyMoviesButtonTextMargin, FallbackValue=15}">
                <TextBlock Name="buy_movies_button_text_line1" Foreground="#FF000000" TextWrapping="Wrap" Style="{Binding Path=BuyMoviesOrGamesButtonTextLine1Style, FallbackValue={StaticResource font_montserrat_regular_22}}" Text="{Binding Path=BuyMoviesOrGamesButtonTextLine1, FallbackValue=BUY}" />
                <TextBlock Name="buy_movies_button_text_line2" Style="{Binding Path=BuyMoviesOrGamesButtonTextLine2Style, FallbackValue={StaticResource font_museo_slab_900_24}}" Text="{Binding Path=BuyMoviesOrGamesButtonTextLine2, FallbackValue=MOVIES}" />
              </StackPanel>
            </Grid>
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="buy_games_button" Style="{StaticResource white_purple_border_gradient_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,0,0" Height="90" Width="135" CornerRadius="45" Command="{x:Static localbase:Commands.BuyGamesCommand}" Focusable="False" Visibility="{Binding Path=BuyGamesButtonVisibility, FallbackValue=Collapsed}" IsEnabled="{Binding BuyGamesEnabled}">
            <Grid>
              <DockPanel LastChildFill="True" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type Redbox:RoundedButton}}}" />
              <StackPanel VerticalAlignment="Center" Margin="15">
                <TextBlock Name="buy_games_button_text_line1" Foreground="#FF000000" TextWrapping="Wrap" Style="{Binding Path=BuyGamesButtonTextLine1Style, FallbackValue={StaticResource font_montserrat_regular_22}}" Text="{Binding Path=BuyGamesButtonTextLine1, FallbackValue=BUY}" />
                <TextBlock Name="buy_games_button_text_line2" Style="{Binding Path=BuyGamesButtonTextLine2Style, FallbackValue={StaticResource font_museo_slab_900_24}}" Text="{Binding Path=BuyGamesButtonTextLine2, FallbackValue=GAMES}" />
              </StackPanel>
            </Grid>
          </Redbox:RoundedButton>
        </StackPanel>
      </StackPanel>
      <StackPanel Margin="25,585,0,0">
        <Redbox:RoundedButton Name="online_pickup_button" Style="{StaticResource warmpurple_white_border_button_style}" Width="290" Height="77" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="39" BorderThickness="2" Command="{x:Static localbase:Commands.PickupProductCommand}" Focusable="False" Visibility="{Binding IsReturnOnlyMode, Converter={StaticResource NotBoolToVisibility}}">
          <TextBlock Style="{StaticResource font_museo_slab_900_36}" Text="{Binding Path=PickUpButtonText, FallbackValue=PICK UP}" />
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="return_button" Style="{StaticResource warmpurple_white_border_button_style}" Margin="0,10,0,0" Width="290" Height="77" VerticalAlignment="Top" HorizontalAlignment="Left" CornerRadius="39" BorderThickness="2" Command="{x:Static localbase:Commands.ReturnProductCommand}" Focusable="False">
          <TextBlock TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_36}" Text="{Binding Path=ReturnButtonText, FallbackValue=RETURN}" />
        </Redbox:RoundedButton>
      </StackPanel>
      <Grid Name="ada_turned_on_label_grid" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="478,640,0,0" Width="285">
        <TextBlock Name="ada_turned_on_label" Style="{StaticResource font_montserrat_regular_11}" Background="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Text="{Binding Path=AdaTurnedOnLabelText, FallbackValue=Screens will now be ADA-compatible. nUse the buttons on the left to continue.}" Visibility="{Binding Path=AdaTurnedOnLabelVisibility, FallbackValue=collapsed}" />
      </Grid>
      <Redbox:RoundedButton Name="handicap_button" Style="{StaticResource rubine_white_border_button_style}" CornerRadius="31" Margin="460,678,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="62" Height="62" Command="{x:Static localbase:Commands.ToggleADAModeCommand}" Focusable="False" Visibility="{Binding IsReturnOnlyMode, Converter={StaticResource NotBoolToVisibility}}">
        <UserControl Name="handicap_button_icon_off" Foreground="#FFFFFFFF" Style="{StaticResource handicap_icon}" Margin="-2, 4, 0,0" Width="67" Height="67" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
              <SkewTransform />
              <RotateTransform />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </UserControl>
      </Redbox:RoundedButton>
      <Grid Name="handicap_button_on" Margin="460, 678, 0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Visibility="{Binding Path=AdaTurnedOnLabelVisibility}">
        <UIElement.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.ToggleADAModeCommand}" />
        </UIElement.InputBindings>
        <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top" Width="62" Height="62" Fill="#E42045" />
        <Ellipse Width="32" Height="32" Margin="40,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="#E42045" />
        <Ellipse Width="29" Height="29" Margin="42,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Fill="#E42045" />
        <Ellipse HorizontalAlignment="Left" Margin="3,3,1,1" VerticalAlignment="Top" Width="58" Height="58" Fill="#E42045" />
        <TextBlock Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_bold_13}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="46,8,0,0">ON</TextBlock>
        <UserControl Name="handicap_button_icon_on" Foreground="#FFFFFFFF" Style="{StaticResource handicap_icon}" Margin="-2, 4, 0,0" Width="67" Height="67" VerticalAlignment="Top" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
          <UIElement.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
              <SkewTransform />
              <RotateTransform />
              <TranslateTransform />
            </TransformGroup>
          </UIElement.RenderTransform>
        </UserControl>
      </Grid>
      <Redbox:RoundedButton Name="espanol_button" Style="{StaticResource rubine_white_border_button_style}" CornerRadius="31" Margin="537,678,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="148" Height="62" Command="{x:Static localbase:Commands.ToggleLanguageModeCommand}" Focusable="False">
        <TextBlock VerticalAlignment="Center" Style="{StaticResource font_montserrat_regular_22}" Text="{Binding Path=ToggleLanguageButtonText, FallbackValue=ESPAÑOL}" />
      </Redbox:RoundedButton>
      <Redbox:RoundedButton Name="help_button" Style="{StaticResource rubine_white_border_button_style}" CornerRadius="31" Margin="697,678,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="62" Height="62" Command="{x:Static localbase:Commands.HelpCommand}" Focusable="False">
        <TextBlock Style="{StaticResource font_montserrat_regular_30}">?</TextBlock>
      </Redbox:RoundedButton>
      <Grid Margin="775,678,0,0" Width="230" Height="62" VerticalAlignment="Top" HorizontalAlignment="Left">
        <Redbox:RoundedButton Name="sign_in_button" CornerRadius="31" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" Height="62" Focusable="False" Style="{StaticResource style_rb_purple_white_border_button}" Command="{x:Static localbase:Commands.SignInCommand}" IsEnabled="{Binding Path=SignInButtonEnabled, FallbackValue=true}" Visibility="{Binding SignInVisibility}">
          <TextBlock Margin="24,0" Style="{StaticResource font_museo_slab_900_28}" Text="{Binding ToggleSignInButtonText, FallbackValue=Sign In}" />
        </Redbox:RoundedButton>
      </Grid>
    </Grid>
  </Grid>
</localControls:TextToSpeechUserControl>