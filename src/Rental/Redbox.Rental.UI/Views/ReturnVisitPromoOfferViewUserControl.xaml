<?xml version="1.0" encoding="utf-8"?>
<local:ViewUserControl x:Class="Redbox.Rental.UI.Views.ReturnVisitPromoOfferViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:ReturnVisitPromoOfferViewUserControlCommands.CloseCommand}" Executed="CloseCommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:ReturnVisitPromoOfferViewUserControlCommands.UseNowCommand}" Executed="UseNowCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Name="MainControl">
    <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/ReturnVisitPromo_bkg.jpg" />
    <StackPanel VerticalAlignment="Top">
      <TextBlock Width="960" Height="95" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,88,0,0" LineHeight="48" Style="{StaticResource font_montserrat_regular_40}" Foreground="#FFFFFFFF" TextWrapping="NoWrap" Text="{Binding TitleText, FallbackValue=Return complete!&#xA;Youve unlocked a special offer}" />
      <TextBlock Width="960" Height="170" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,13,0,0" LineHeight="170" Style="{StaticResource font_montserrat_bold_170}" Foreground="#FFFFFFFF" TextWrapping="NoWrap" Text="{Binding AmountText, FallbackValue=$1.00 OFF}" />
      <TextBlock Width="960" Height="64" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,7,0,0" LineHeight="36" Style="{StaticResource font_montserrat_bold_52}" Foreground="#FFFFFFFF" TextWrapping="NoWrap" Text="{Binding MessageText, FallbackValue=your next 1-night rental}" />
      <TextBlock Width="960" Height="43" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,31,0,0" LineHeight="43" Style="{StaticResource font_montserrat_bold_38}" Foreground="#FFFFFFFF" TextWrapping="NoWrap" Text="{Binding PromoCodeText, FallbackValue=promo code: REDBOX}" />
      <TextBlock Width="242" Height="40" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0" LineHeight="24" Style="{StaticResource font_montserrat_regular_24}" Foreground="#FFFFFFFF" TextWrapping="NoWrap" Text="{Binding ExpirationText, FallbackValue=Expires MM/DD}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,21,0,0">
        <Redbox:RoundedButton Width="242" Height="56" Style="{StaticResource black_with_white_border_button_style}" BackgroundColor="#1B0323" BackgroundGradientColor="#1B0323" BorderThickness="2" UsedDefaultCornerRadius="True" Margin="20,0,20,0" Command="{x:Static local:ReturnVisitPromoOfferViewUserControlCommands.CloseCommand}">
          <TextBlock Name="CloseButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_montserrat_extrabold_20}" Text="{Binding Path=CloseButtonText, FallbackValue=CLOSE}" />
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Width="242" Height="56" Style="{StaticResource white_and_warm_purple_button_style}" UsedDefaultCornerRadius="True" Margin="20,0,20,0" Command="{x:Static local:ReturnVisitPromoOfferViewUserControlCommands.UseNowCommand}">
          <TextBlock Name="UseNowButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_montserrat_extrabold_20}" Text="{Binding Path=UseNowButtonText, FallbackValue=USE NOW}" />
        </Redbox:RoundedButton>
      </StackPanel>
      <TextBlock Width="945" Height="64" HorizontalAlignment="Center" Margin="0,44,0,0" LineHeight="16" Style="{StaticResource font_montserrat_extralight_11}" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding LegalText, FallbackValue='Valid for stated discount off the fee for an eligible 1-night disc or On Demand rental before the expiration date indicated above. 1 use; 1 code per transaction. Your payment card, necessary for rental, is charged the balance of the daily rental fee for a disc and the full daily rental fee for addl discs + tax (except where tax isnt charged) for the 1st rental day. Youre charged the full daily rental fee + tax (if appl.) for addl days you keep each disc. Cant be combined with other offers, applied to prior rentals, or redeemed for cash. May be cancelled/changed at any time. Void where prohibited.'}" />
    </StackPanel>
  </Grid>
</local:ViewUserControl>