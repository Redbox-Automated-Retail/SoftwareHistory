<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.MessagePopupViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" DataContextChanged="TextToSpeechUserControl_DataContextChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:MessagePopupViewCommands.Button1}" Executed="Button1CommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:MessagePopupViewCommands.Button2}" Executed="Button2CommandBinding_Executed" />
  </UIElement.CommandBindings>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="button1_text_style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_target_small_button_overlays}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="button1_style" TargetType="{x:Type Redbox:RoundedButton}" BasedOn="{StaticResource warm_purple_no_border_button_style}">
        <Setter Property="Width" Value="191" />
        <Setter Property="Height" Value="66" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="#FFD3D3D3" />
      </Style>
      <Style x:Key="button2_text_style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_target_small_button_overlays}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="button2_style" TargetType="{x:Type Redbox:RoundedButton}" BasedOn="{StaticResource rubine_no_border_button_style}">
        <Setter Property="Width" Value="171" />
        <Setter Property="Height" Value="66" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BorderBrush" Value="#860C13" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Name="DarkBackground" Background="#FF000000" Opacity="{Binding Path=BackgroundOpacity, FallbackValue=0.6}" />
    <Grid Margin="{Binding Path=MainGridMargin, FallbackValue='128,96,128,96'}">
      <Border Background="#FFFFFFFF" CornerRadius="28" BorderThickness="5" BorderBrush="{Binding Path=BorderBrushColor, FallbackValue=#E42045}" />
      <StackPanel Orientation="Vertical">
        <TextBlock Name="TitleText" TextWrapping="Wrap" Margin="55,46,55,10" Text="{Binding Path=Title, FallbackValue=Culture Specific Title}" Style="{Binding Path=TitleStyle, FallbackValue={StaticResource message_popup_dialog_title_style}}" />
        <DockPanel Margin="62,5" LastChildFill="True">
          <TextBlock Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" Text="{Binding Path=Message, FallbackValue=Culture Specific Message}" Style="{Binding Path=MessageStyle, FallbackValue={StaticResource message_popup_dialog_mesg_style}}" />
          <Grid Name="UserControlContainer" />
        </DockPanel>
      </StackPanel>
      <Grid Name="ButtonGrid" VerticalAlignment="Bottom" Height="80" Margin="0,0,0,21">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Redbox:RoundedButton Name="Button1" UsedDefaultCornerRadius="True" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{x:Static local:MessagePopupViewCommands.Button1}" Style="{Binding Path=Button1Style, FallbackValue={StaticResource button1_style}}" Visibility="{Binding Path=Button1Visibility, FallbackValue=Collapsed}">
          <TextBlock Name="Button1_Text" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{Binding Path=Button1TextStyle, FallbackValue={StaticResource button1_text_style}}" Text="{Binding Path=Button1Text}" />
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="Button2" Grid.Column="1" UsedDefaultCornerRadius="True" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{x:Static local:MessagePopupViewCommands.Button2}" Style="{Binding Path=Button2Style, FallbackValue={StaticResource button2_style}}" Visibility="{Binding Path=Button2Visibility, FallbackValue=Collapsed}">
          <TextBlock Name="Button2_Text" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{Binding Path=Button2TextStyle, FallbackValue={StaticResource button2_text_style}}" Text="{Binding Path=Button2Text}" />
        </Redbox:RoundedButton>
      </Grid>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>