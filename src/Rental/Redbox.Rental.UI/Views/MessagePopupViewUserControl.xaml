<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.MessagePopupViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" DataContextChanged="TextToSpeechUserControl_DataContextChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:MessagePopupViewCommands.Button1}" Executed="Button1CommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:MessagePopupViewCommands.Button2}" Executed="Button2CommandBinding_Executed" />
  </UIElement.CommandBindings>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="button1_text_style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_target_small_button_overlays}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="button1_style" TargetType="{x:Type controls:RoundedButton}" BasedOn="{StaticResource warm_purple_no_border_button_style}">
        <Setter Property="Margin" Value="62,482,0,0" />
        <Setter Property="Width" Value="191" />
      </Style>
      <Style x:Key="button2_text_style" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_target_small_button_overlays}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="button2_style" TargetType="{x:Type controls:RoundedButton}" BasedOn="{StaticResource rubine_no_border_button_style}">
        <Setter Property="Margin" Value="535,482,0,0" />
        <Setter Property="Width" Value="171" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Name="DarkBackground" Background="#FF000000" Opacity="{Binding Path=BackgroundOpacity, FallbackValue=0.6}" />
    <Grid Margin="128,96,128,96">
      <Border Background="#FFFFFFFF" CornerRadius="28" BorderBrush="#E42045" BorderThickness="5">
        <TextBlock Name="TitleText" Margin="55,46" Foreground="#E42045" Text="{Binding Path=Title, FallbackValue=Culture Specific Title}" Style="{Binding Path=TitleStyle, FallbackValue={StaticResource font_target_large_overlays}}" />
      </Border>
      <DockPanel Margin="62,125" LastChildFill="True">
        <TextBlock Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#676565" Text="{Binding Path=Message, FallbackValue=Culture Specific Message}" Style="{Binding Path=MessageStyle, FallbackValue={StaticResource font_target_small_overlays}}" />
        <Grid Name="UserControlContainer" />
      </DockPanel>
      <controls:RoundedButton x:Name="Button1" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="32" BorderBrush="#FFD3D3D3" BorderThickness="2" Height="66" Command="{x:Static local:MessagePopupViewCommands.Button1}" Style="{Binding Path=Button1Style, FallbackValue={StaticResource button1_style}}" Visibility="{Binding Path=Button1Visibility, FallbackValue=Collapsed}">
        <TextBlock Name="Button1_Text" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{Binding Path=Button1TextStyle, FallbackValue={StaticResource button1_text_style}}" Text="{Binding Path=Button1Text}" />
      </controls:RoundedButton>
      <controls:RoundedButton x:Name="Button2" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="32" BorderBrush="#860C13" BorderThickness="3" Height="66" Command="{x:Static local:MessagePopupViewCommands.Button2}" Style="{Binding Path=Button2Style, FallbackValue={StaticResource button2_style}}" Visibility="{Binding Path=Button2Visibility, FallbackValue=Collapsed}">
        <TextBlock Name="Button2_Text" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{Binding Path=Button2TextStyle, FallbackValue={StaticResource button2_text_style}}" Text="{Binding Path=Button2Text}" />
      </controls:RoundedButton>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>