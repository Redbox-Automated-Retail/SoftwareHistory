<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.MessagePopupViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:MessagePopupViewCommands.Button1}" Executed="Button1CommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:MessagePopupViewCommands.Button2}" Executed="Button2CommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Background="#FF000000" Opacity="0.6" />
    <Grid Margin="128, 96,128, 96">
      <Border Background="#FFFFFFFF" CornerRadius="28" BorderBrush="#A21018" BorderThickness="5">
        <TextBlock Name="TitleText" Text="Culture Specific Title" Margin="62,46" Foreground="#B5121B" Style="{StaticResource font_target_large_overlays}" />
      </Border>
      <TextBlock Name="MessageText" TextWrapping="Wrap" Text="Culture Specific Message" Margin="62,146" Foreground="#676565" Style="{StaticResource font_target_small_overlays}" />
      <Border Name="Button1" Margin="62,482,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="32" BorderBrush="#FFD3D3D3" BorderThickness="2" Width="191" Height="66">
        <UIElement.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{x:Static local:MessagePopupViewCommands.Button1}" />
        </UIElement.InputBindings>
        <Border.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#969494" Offset="0" />
            <GradientStop Color="#676666" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Name="Button1_Text" Style="{StaticResource font_target_small_button_overlays}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Button 1" />
      </Border>
      <Border Name="Button2" Margin="535,482,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="32" BorderBrush="#860C13" BorderThickness="3" Width="171" Height="66">
        <UIElement.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{x:Static local:MessagePopupViewCommands.Button2}" />
        </UIElement.InputBindings>
        <Border.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#B50E1B" Offset="0" />
            <GradientStop Color="#8F0E15" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Name="Button2_Text" Style="{StaticResource font_target_small_button_overlays}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Button 2" />
      </Border>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>