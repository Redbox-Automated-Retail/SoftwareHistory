<?xml version="1.0" encoding="utf-8"?>
<local:KeyboardControl x:Class="Redbox.Rental.UI.Views.KeyboardPromoCodeViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls">
  <Border Name="MainControl" Background="#FFFFFFFF" Height="768" Width="1024">
    <Redbox:GridExt Margin="60,20,60,10" RowHeights="40,70,*,420,120">
      <Grid Row="0" HorizontalAlignment="Center">
        <TextBlock Name="MessageTextElem" Margin="25,0" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource keyboard_prompt_message_style}" Text="{Binding Path=MessageText, FallbackValue=Message}" />
      </Grid>
      <Grid Row="1" HorizontalAlignment="Center">
        <Redbox:BorderButton Name="PromoElem" BorderSize="350,64" HorizontalAlignment="Left" Style="{StaticResource border_button_style}" Click="PromoSelected">
          <Grid Background="#00FFFFFF">
            <TextBlock Name="PromoTextElem" Height="32" Width="260" TextWrapping="NoWrap" Style="{StaticResource style_keyboard_input_text}" Text="{Binding Path=KeyboardText}" />
            <TextBlock Name="PromoPromotTextElem" Height="32" Width="auto" Style="{StaticResource style_keyboard_input_text}" Foreground="{StaticResource PromptGrayBrush}" Text="{Binding Path=EmailPromptText, FallbackValue=promo code}" Visibility="{Binding ElementName=PromoTextElem, Path=Text, Converter={StaticResource TextVisibilityConverter}}" />
          </Grid>
        </Redbox:BorderButton>
      </Grid>
      <Grid Row="2" Margin="125,20,125,0">
        <TextBlock Name="ErrorTextElem" Grid.Row="4" VerticalAlignment="Top" Margin="0,0,0,10" Height="auto" Style="{StaticResource keyboard_error_message_style}" TextAlignment="Center" Text="{Binding Path=KeyboardError}" />
        <TextBlock Name="MarketingTextElem" Grid.Row="4" Margin="0" Style="{StaticResource keyboard_marketing_message_style}" TextAlignment="Center" Text="{Binding Path=MarketingText, FallbackValue=Marketing}" />
      </Grid>
      <localControls:KeyboardUserControl x:Name="KeyboardElem" Grid.Row="3" Margin="0,10,0,20" KeyboardMode="PROMOTIONS_CODE" />
      <Rectangle Grid.Row="4" />
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
        <Redbox:RoundedButton Name="CancelButtonElem" Grid.Column="1" Margin="5,20,10,20" Style="{StaticResource style_white_rubine_border_button}" IsEnabled="True" Command="{Binding CancelButtonCommand}">
          <TextBlock Name="CancelButtonTextElem" Margin="50,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding CancelButtonText, FallbackValue=Cancel}" />
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="ContinueButtonElem" Grid.Column="2" Margin="10,20,5,20" Style="{StaticResource style_rb_purple_white_border_button}" IsEnabled="True" Click="ContinueTouched">
          <TextBlock Name="ContinueButtonTextElem" Margin="50,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding ContinueButtonText, FallbackValue=Apply}" />
        </Redbox:RoundedButton>
      </StackPanel>
    </Redbox:GridExt>
  </Border>
</local:KeyboardControl>