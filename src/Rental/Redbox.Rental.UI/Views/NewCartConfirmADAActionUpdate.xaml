<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.NewCartConfirmADAActionUpdate" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <Grid>
    <Grid Name="DarkBackground" Background="#1c0f1e" Opacity="0.89" />
    <Grid Margin="128,132,128,132">
      <Border Grid.Row="0" Grid.RowSpan="2" Background="#FFFFFFFF" CornerRadius="28" Opacity="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Name="TitleText" HorizontalAlignment="Center" Margin="95,40,95,0" Foreground="{StaticResource WarmPurpleBrush}" Style="{StaticResource font_museo_slab_700_36}" Text="{Binding Path=Title, FallbackValue=Update your bag}" />
            <ItemsControl ItemsSource="{Binding DisplayProductModels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Name="ShoppingCartStackPanel" Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <controls:DisplayProductWithSpecialActionADA MinHeight="94" Width="100" Margin="16,40,16,0" VerticalAlignment="Top" DataContext="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Border Grid.Row="1" Background="{StaticResource LightGrayBackgroundBrush}" CornerRadius="0,0,28,28">
            <Redbox:RoundedButton Name="OkButton" Grid.Row="1" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" CornerRadius="30" Height="59" Width="163" Command="{Binding OkButtonCommand}">
              <TextBlock Name="OkButtonText" Style="{StaticResource font_museo_slab_900_28}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=OkButtonText, FallbackValue=Okay}" />
            </Redbox:RoundedButton>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>