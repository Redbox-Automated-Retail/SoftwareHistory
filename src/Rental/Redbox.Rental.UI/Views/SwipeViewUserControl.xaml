<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.SwipeViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:animations="clr-namespace:Redbox.Rental.UI.Controls.Animations" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:SwipeViewCommands.GoBack}" Executed="GoBackCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Background="#E42045">
    <Image Name="ad_image" Width="728" Height="90" VerticalAlignment="Top" Margin="12" />
    <Grid Name="AnimationContainer">
      <animations:SwipeRegularCheckOutUserControl Loaded="SwipeRegularCheckOutUserControl_Loaded" VerticalAlignment="Center" />
    </Grid>
    <Border Name="back_button" BorderBrush="#792d8d" BorderThickness="3" CornerRadius="34" Width="194" Height="66" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="35,665,0,0">
      <Border.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
          <GradientStop Color="WHITE" Offset="0" />
          <GradientStop Color="WHITE" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <UIElement.InputBindings>
        <MouseBinding Gesture="LeftClick" Command="{x:Static local:SwipeViewCommands.GoBack}" />
      </UIElement.InputBindings>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
        <Image Width="31.5" Height="27" Margin="0,0,15,0" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/back-rubine-arrow.png" />
        <TextBlock Name="ButtonGoBack_Text" Style="{StaticResource font_target_small}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E42045" Text="BACK" />
      </StackPanel>
    </Border>
  </Grid>
</controls:TextToSpeechUserControl>