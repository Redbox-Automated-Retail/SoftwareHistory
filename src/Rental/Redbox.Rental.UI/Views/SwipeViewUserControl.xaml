<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.SwipeViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:animations="clr-namespace:Redbox.Rental.UI.Controls.Animations" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:redbox_controls="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" Focusable="False">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:SwipeViewCommands.GoBack}" Executed="GoBackCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Background="#E42045">
    <Image Name="ad_image" Width="728" Height="90" VerticalAlignment="Top" Margin="12" Source="{Binding AdImage}" />
    <Grid Name="AnimationContainer">
      <animations:EMVTapRegularCheckoutUserControl VerticalAlignment="Center" />
    </Grid>
    <redbox_controls:RoundedButton Name="back_button" Style="{StaticResource white_purple_border_gradient_button_style}" Command="{x:Static local:SwipeViewCommands.GoBack}" Width="194" Height="66" CornerRadius="34" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="35,665,0,0">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
        <TextBlock Name="ButtonGoBack_Text" Style="{StaticResource font_museo_slab_900_25}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E42045" Text="{Binding BackButtonText, FallbackValue=Back}" />
      </StackPanel>
    </redbox_controls:RoundedButton>
  </Grid>
</controls:TextToSpeechUserControl>