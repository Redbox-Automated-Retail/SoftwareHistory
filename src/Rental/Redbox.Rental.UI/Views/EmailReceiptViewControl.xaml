<?xml version="1.0" encoding="utf-8"?>
<local:ViewUserControl x:Class="Redbox.Rental.UI.Views.EmailReceiptViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <Grid Name="MainControl">
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E42045" Offset="0.0" />
        <GradientStop Color="#902A7D" Offset="0.5" />
        <GradientStop Color="#491E54" Offset="1.0" />
      </LinearGradientBrush>
    </Panel.Background>
    <DockPanel LastChildFill="True">
      <Grid Background="#FF000000" Height="98" DockPanel.Dock="Bottom" Visibility="{Binding Path=BannerImageVisibility, FallbackValue=Collapsed}">
        <Image Name="AdImage" Width="728" Height="90" Source="{Binding BannerImage}" />
      </Grid>
      <Grid>
        <StackPanel VerticalAlignment="Bottom">
          <TextBlock Name="TitleTextElem" HorizontalAlignment="Center" Margin="0,0,0,44" Style="{StaticResource font_montserrat_bold_40}" LineHeight="56" Foreground="#FFFFFFFF" Text="{Binding TitleText, FallbackValue=Your receipt will be sent to:}" />
          <TextBlock Name="MessageTextElem" HorizontalAlignment="Center" Margin="0,0,0,200" Style="{StaticResource font_montserrat_regular_28}" LineHeight="40" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FFFFFFFF" Text="{Binding MessageText, FallbackValue=bonjovi@gmail.com}" />
          <Redbox:RoundedButton Name="NextButton" Width="237" Height="56" Style="{StaticResource white_button_style}" UsedDefaultCornerRadius="True" Margin="0,0,0,44" Command="{Binding ContinueButtonCommand}">
            <TextBlock Name="CapButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_montserrat_extrabold_20}" Text="{Binding Path=ContinueButtonText, FallbackValue=CONTINUE}" />
          </Redbox:RoundedButton>
          <TextBlock Name="CommentTextElem" Margin="0,0,0,65" HorizontalAlignment="Center" Style="{StaticResource font_montserrat_medium_16}" LineHeight="24" Foreground="#FFFFFFFF" Text="{Binding CommentText, FallbackValue='To update your email, visit redbox.com/account'}" />
        </StackPanel>
      </Grid>
    </DockPanel>
  </Grid>
</local:ViewUserControl>