<?xml version="1.0" encoding="utf-8"?>
<local:ViewUserControl x:Class="Redbox.Rental.UI.Views.EmailReceiptViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <Grid Name="MainControl" Background="{StaticResource RubineRedGradientBrush}">
    <DockPanel LastChildFill="True">
      <Grid Background="#FF000000" Height="98" DockPanel.Dock="Bottom" Visibility="{Binding Path=BannerImageVisibility, FallbackValue=Collapsed}">
        <Image Name="AdImage" Width="728" Height="90" Source="{Binding BannerImage}" />
      </Grid>
      <Grid>
        <StackPanel VerticalAlignment="Bottom">
          <TextBlock Name="TitleTextElem" HorizontalAlignment="Center" Margin="0,0,0,40" Style="{StaticResource font_museo_slab_900_48}" Foreground="#FFFFFFFF" Text="{Binding TitleText, FallbackValue=Your receipt will be sent to:}" />
          <TextBlock Name="MessageTextElem" HorizontalAlignment="Center" Margin="0,0,0,142" Style="{StaticResource font_montserrat_regular_36}" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FFFFFFFF" Text="{Binding MessageText, FallbackValue=bonjovi@gmail.com}" />
          <Redbox:RoundedButton Name="NextButton" Width="237" Height="66" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" UsedDefaultCornerRadius="True" Margin="0,0,0,40" Command="{Binding ContinueButtonCommand}">
            <TextBlock Name="CapButtonText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_25}" Text="{Binding Path=ContinueButtonText, FallbackValue=Continue}" />
          </Redbox:RoundedButton>
          <TextBlock Name="CommentTextElem" Margin="0,0,0,72" HorizontalAlignment="Center" Style="{StaticResource font_montserrat_medium_16}" Foreground="#FFFFFFFF" Text="{Binding CommentText, FallbackValue='To update your email, visit redbox.com/account'}" />
        </StackPanel>
      </Grid>
    </DockPanel>
  </Grid>
</local:ViewUserControl>