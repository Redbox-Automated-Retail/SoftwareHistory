<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.CollectionMessageViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localbase="clr-namespace:Redbox.Rental.UI" DataContextChanged="TextToSpeechUserControl_DataContextChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.CancelDialogCommand}" Executed="CancelDialogCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.MoreCollectionsCommand}" Executed="MoreCollectionsCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.BrowseItemSelectedCommand}" Executed="BrowseItemSelectedCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Background="#00FFFFFF">
    <Grid Name="DarkBackground" Background="#FF000000" Opacity="{Binding Path=BackgroundOpacity, FallbackValue=0.6}" />
    <Grid Margin="145, 125,145, 125">
      <Border Background="#FFFFFFFF" CornerRadius="28" BorderBrush="#E42045" BorderThickness="5">
        <Grid>
          <DockPanel Margin="30,25,30,10">
            <TextBlock Name="TitleText" DockPanel.Dock="Top" HorizontalAlignment="Center" Text="{Binding Path=Title, FallbackValue=Cant find something you like?  Check out our collections}" Style="{Binding Path=TitleStyle, FallbackValue={StaticResource font_montserrat_regular_22}}" />
            <Line DockPanel.Dock="Top" Margin="0,10" StrokeThickness="5" X1="0" X2="700" Y1="0" Y2="0" Stroke="#FF000000" HorizontalAlignment="Center" />
            <controls:RoundedButton x:Name="SeeAllCollectionsButton" Command="{x:Static localbase:Commands.MoreCollectionsCommand}" DockPanel.Dock="Bottom" Style="{StaticResource classic_purple_button_style}" Height="52" CornerRadius="26" Width="300" HorizontalAlignment="Center">
              <TextBlock Name="SeeAllCollectionsButtonText" Style="{StaticResource font_target_smaller}" FontSize="21" Text="{Binding Path=SeeAllCollectionsButtonText, FallbackValue=SEE ALL COLLECTIONS}" />
            </controls:RoundedButton>
            <Line DockPanel.Dock="Bottom" Margin="0,10" StrokeThickness="5" X1="0" X2="700" Y1="0" Y2="0" Stroke="#FF000000" HorizontalAlignment="Center" />
            <Grid Margin="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="50*" />
              </Grid.ColumnDefinitions>
              <controls:DisplayCollectionUserControl x:Name="DisplayCollection1" DataContext="{Binding Path=DisplayCollectionModel1}" />
              <controls:DisplayCollectionUserControl x:Name="DisplayCollection2" Grid.Column="1" DataContext="{Binding Path=DisplayCollectionModel2}" />
            </Grid>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
    <controls:RoundedButton x:Name="CancelButton" Command="{x:Static localbase:Commands.CancelDialogCommand}" Margin="0,100,120,0" Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource classic_gray_button_style}" BorderColor="#E42045" BorderGradientColor="#970E16" BorderThickness="5">
      <TextBlock Text="X" Style="{StaticResource font_montserrat_bold_24}" />
    </controls:RoundedButton>
  </Grid>
</controls:TextToSpeechUserControl>