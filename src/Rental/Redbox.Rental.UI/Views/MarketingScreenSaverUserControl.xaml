<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Views.MarketingScreenSaverUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Storyboard x:Key="GradientCycle" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetName="GradientStop3" Storyboard.TargetProperty="Offset" From="2" To="1" BeginTime="0:0:5" Duration="0:0:10" />
        <DoubleAnimation Storyboard.TargetName="GradientStop2" Storyboard.TargetProperty="Offset" From="1" To="0" BeginTime="0:0:5" Duration="0:0:10" />
        <DoubleAnimation Storyboard.TargetName="GradientStop1" Storyboard.TargetProperty="Offset" From="0" To="-1" BeginTime="0:0:5" Duration="0:0:10" />
        <DoubleAnimation Storyboard.TargetName="GradientStop2" Storyboard.TargetProperty="Offset" From="0" To="1" BeginTime="0:0:20" Duration="0:0:0" />
        <DoubleAnimation Storyboard.TargetName="GradientStop1" Storyboard.TargetProperty="Offset" From="-1" To="0" BeginTime="0:0:20" Duration="0:0:0" />
        <DoubleAnimation Storyboard.TargetName="GradientStop3" Storyboard.TargetProperty="Offset" From="2" To="1" BeginTime="0:0:20" Duration="0:0:0" />
        <ColorAnimation Storyboard.TargetName="GradientStop1" Storyboard.TargetProperty="Color" From="#792d8d" To="#E42045" BeginTime="0:0:20" Duration="0:0:0" />
        <ColorAnimation Storyboard.TargetName="GradientStop2" Storyboard.TargetProperty="Color" From="#E42045" To="#792d8d" BeginTime="0:0:20" Duration="0:0:0" />
        <ColorAnimation Storyboard.TargetName="GradientStop3" Storyboard.TargetProperty="Color" From="#792d8d" To="#E42045" BeginTime="0:0:20" Duration="0:0:0" />
        <DoubleAnimation Storyboard.TargetName="GradientStop3" Storyboard.TargetProperty="Offset" From="2" To="1" BeginTime="0:0:25" Duration="0:0:10" />
        <DoubleAnimation Storyboard.TargetName="GradientStop2" Storyboard.TargetProperty="Offset" From="1" To="0" BeginTime="0:0:25" Duration="0:0:10" />
        <DoubleAnimation Storyboard.TargetName="GradientStop1" Storyboard.TargetProperty="Offset" From="0" To="-1" BeginTime="0:0:25" Duration="0:0:10" />
        <DoubleAnimation Storyboard.TargetName="GradientStop2" Storyboard.TargetProperty="Offset" From="0" To="1" BeginTime="0:0:40" Duration="0:0:0" />
        <ColorAnimation Storyboard.TargetName="GradientStop1" Storyboard.TargetProperty="Color" From="#E42045" To="#792d8d" BeginTime="0:0:40" Duration="0:0:0" />
        <ColorAnimation Storyboard.TargetName="GradientStop2" Storyboard.TargetProperty="Color" From="#792d8d" To="#E42045" BeginTime="0:0:40" Duration="0:0:0" />
        <ColorAnimation Storyboard.TargetName="GradientStop3" Storyboard.TargetProperty="Color" From="#E42045" To="#792d8d" BeginTime="0:0:40" Duration="0:0:0" />
      </Storyboard>
      <Storyboard x:Key="ButtonPulseAnimation" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonShadow" Storyboard.TargetProperty="BlurRadius">
          <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="50" />
          <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <Storyboard x:Key="ButtonSizeAnimation" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BrowseButton" Storyboard.TargetProperty="Width">
          <EasingDoubleKeyFrame KeyTime="0:0:0" Value="385" />
          <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="385" />
          <EasingDoubleKeyFrame KeyTime="0:0:4" Value="100" />
          <EasingDoubleKeyFrame KeyTime="0:0:4.8" Value="100" />
          <EasingDoubleKeyFrame KeyTime="0:0:4.9" Value="80" />
          <EasingDoubleKeyFrame KeyTime="0:0:5.0" Value="100" />
          <EasingDoubleKeyFrame KeyTime="0:0:5.1" Value="100" />
          <EasingDoubleKeyFrame KeyTime="0:0:5.5" Value="385" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BrowseButton" Storyboard.TargetProperty="Height">
          <EasingDoubleKeyFrame KeyTime="0:0:0" Value="100" />
          <EasingDoubleKeyFrame KeyTime="0:0:4.8" Value="100" />
          <EasingDoubleKeyFrame KeyTime="0:0:4.9" Value="80" />
          <EasingDoubleKeyFrame KeyTime="0:0:5" Value="100" />
          <EasingDoubleKeyFrame KeyTime="0:0:5.5" Value="100" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ButtonTransform" Storyboard.TargetProperty="X">
          <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="0" />
          <EasingDoubleKeyFrame KeyTime="0:0:4" Value="120" />
          <EasingDoubleKeyFrame KeyTime="0:0:4.8" Value="120" />
          <EasingDoubleKeyFrame KeyTime="0:0:4.9" Value="110" />
          <EasingDoubleKeyFrame KeyTime="0:0:5.0" Value="120" />
          <EasingDoubleKeyFrame KeyTime="0:0:5.1" Value="120" />
          <EasingDoubleKeyFrame KeyTime="0:0:5.5" Value="0" />
        </DoubleAnimationUsingKeyFrames>
        <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="BrowseButtonGrid" Storyboard.TargetProperty="Margin">
          <EasingThicknessKeyFrame KeyTime="0:0:0" Value="20,0,10,0" />
          <EasingThicknessKeyFrame KeyTime="0:0:4.8" Value="20,0,10,0" />
          <EasingThicknessKeyFrame KeyTime="0:0:4.9" Value="10,0,10,0" />
          <EasingThicknessKeyFrame KeyTime="0:0:5.0" Value="20,0,10,0" />
          <EasingThicknessKeyFrame KeyTime="0:0:5.5" Value="20,0,10,0" />
        </ThicknessAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BrowseButtonText" Storyboard.TargetProperty="Opacity">
          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:3.5" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="0:0:5.5" Value="1" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="LayoutRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="576" />
      <RowDefinition Height="192" />
    </Grid.RowDefinitions>
    <controls:CrossfadeImageRotatorUserControl Grid.Row="0" ImageModels="{Binding ImageModels}" IsAnimationOn="{Binding IsAnimationOn}" />
    <redbox:RoundedButton Name="BottomBarHitTarget" Grid.Row="1" Margin="0" Style="{StaticResource transparent_button_style}" CornerRadius="0" Command="{Binding BrowseCommand}">
      <Grid Row="1" Height="192" Width="1024" IsHitTestVisible="False">
        <Panel.Background>
          <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
            <GradientBrush.GradientStops>
              <GradientStopCollection>
                <GradientStop x:Name="GradientStop1" Color="#792d8d" Offset="0" />
                <GradientStop x:Name="GradientStop2" Color="#E42045" Offset="1" />
                <GradientStop x:Name="GradientStop3" Color="#792d8d" Offset="1" />
              </GradientStopCollection>
            </GradientBrush.GradientStops>
          </LinearGradientBrush>
        </Panel.Background>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Height="14" VerticalAlignment="Top" Background="#1e1123" Opacity=".3" />
        <redbox:RoundedButton Name="BrowseButton" Grid.Row="1" Style="{StaticResource style_white_no_border_button}" Height="100" Width="385" CornerRadius="50" HorizontalAlignment="Right" Margin="319,14,319,0" Panel.ZIndex="1">
          <Grid Name="BrowseButtonGrid" Margin="20,0,10,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/black_hand.png" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Name="BrowseButtonText" Grid.Column="1" Style="{StaticResource font_museo_slab_700_26}" FontSize="30" Foreground="#FF000000" VerticalAlignment="Center" Margin="10,0,20,0" Text="{Binding StartButtonText, FallbackValue=Start Browsing}" />
          </Grid>
          <UIElement.Effect>
            <DropShadowEffect x:Name="ButtonShadow" ShadowDepth="0" Color="White" Opacity="1" BlurRadius="50" />
          </UIElement.Effect>
          <UIElement.RenderTransform>
            <TranslateTransform x:Name="ButtonTransform" />
          </UIElement.RenderTransform>
        </redbox:RoundedButton>
      </Grid>
    </redbox:RoundedButton>
  </Grid>
</UserControl>