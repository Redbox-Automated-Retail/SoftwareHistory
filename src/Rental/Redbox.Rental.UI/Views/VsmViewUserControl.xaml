<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.VsmViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls">
  <Grid Background="#FF000000">
    <Grid.RowDefinitions>
      <RowDefinition Height="{Binding HeaderHeight, FallbackValue=136}" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True">
      <Grid Name="WhiteLineSpacer" DockPanel.Dock="Bottom" Background="#FFFFFFFF" Height="8" />
      <Image Name="RentalsOnTheirWayBackgroundImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/vsm_header_background.png" Stretch="Fill" />
    </DockPanel>
    <TextBlock Name="TitleText" Style="{StaticResource font_montserrat_bold_40}" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=TitleText, FallbackValue=Your discs are on their way}" />
    <Image Name="AdImage" Grid.Row="2" Source="{Binding AdImage, FallbackValue='pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/vsm_default.jpg'}" />
  </Grid>
</controls:TextToSpeechUserControl>