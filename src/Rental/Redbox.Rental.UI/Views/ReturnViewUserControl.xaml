<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.ReturnViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:animations="clr-namespace:Redbox.Rental.UI.Controls.Animations" DataContextChanged="TextToSpeechUserControl_DataContextChanged">
  <UIElement.CommandBindings />
  <Grid Background="#E42045">
    <animations:InsertDiscAnimationUserControl x:Name="InsertDiscAnimation" VerticalAlignment="Center" HorizontalAlignment="Left" />
    <Image Width="728" Height="90" VerticalAlignment="Bottom" Margin="13" Source="{Binding Path=AdImageSource}" Visibility="{Binding Path=AdImageVisibility, FallbackValue=Collapsed}" />
  </Grid>
</controls:TextToSpeechUserControl>