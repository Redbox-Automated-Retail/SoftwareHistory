<?xml version="1.0" encoding="utf-8"?>
<local:ViewUserControl x:Class="Redbox.Rental.UI.Views.JoinedPerksViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <Grid Name="MainControl">
    <localControls:JoinedUserControl x:Name="JoinedElem" />
    <StackPanel Margin="80,30">
      <TextBlock Name="TitleTextElem" HorizontalAlignment="Center" Margin="0,20" Style="{StaticResource font_museo_slab_900_48}" Foreground="#FFFFFFFF" Text="{Binding TitleText, FallbackValue=You re in!}" />
      <TextBlock Name="MessageTextElem" HorizontalAlignment="Center" Style="{StaticResource font_montserrat_bold_24}" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FFFFFFFF" Text="{Binding MessageText, FallbackValue=Snag your free 1-night DVD rental on your&#xA; next visit – and be on the lookout for more Perks}" />
    </StackPanel>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="380" Margin="0,0,0,180">
      <Image Width="240" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/jewel-case-kiosk.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="60" Margin="0,0,0,30">
      <TextBlock Name="FooterTextElem" Grid.Column="1" Foreground="{StaticResource RbPurpleBrush}" TextAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource font_montserrat_regular_14}" Text="{Binding FooterText, FallbackValue='Your free 1-night DVD rental will show up as points in your account&#xA;within 48 hours. By tapping CREATE ACCOUNT, you agree to the terms.'}" />
    </Grid>
  </Grid>
</local:ViewUserControl>