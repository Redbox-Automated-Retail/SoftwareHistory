<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.MultiNightPricingPopupViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:views="clr-namespace:Redbox.Rental.UI.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static views:MultiNightPricingPopupViewUserControlCommands.OneNightCommand}" Executed="OneNightCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:MultiNightPricingPopupViewUserControlCommands.MultiNightCommand}" Executed="MultiNightCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:MultiNightPricingPopupViewUserControlCommands.BuyCommand}" Executed="BuyCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:MultiNightPricingPopupViewUserControlCommands.CancelCommand}" Executed="CancelCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Name="BackgroundGrid" Background="#FF000000" Opacity="0.6" />
    <Border Height="585" Width="558" Background="#FFFFFFFF" CornerRadius="28">
      <Grid>
        <TextBlock Name="HeaderText" Width="470" Height="80" VerticalAlignment="Top" Margin="0,62,0,0" Foreground="#782D8D" TextWrapping="Wrap" Style="{StaticResource font_montserrat_bold_30}" Text="{Binding Path=HeaderText, FallbackValue=Power Rangers - DVD}" />
        <TextBlock Name="DescriptionText" Width="470" Height="30" VerticalAlignment="Top" Margin="0,142,0,0" Foreground="#782D8D" Style="{StaticResource font_montserrat_regular_24}" Text="{Binding Path=DescriptionText, FallbackValue=How do you want to rent it?}" />
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,80,0,0">
          <Redbox:RoundedButton Name="OneNightButton" Width="315" Height="59" Margin="0,24,0,0" CornerRadius="28" Style="{StaticResource style_rb_purple_white_border_button}" Command="{x:Static views:MultiNightPricingPopupViewUserControlCommands.OneNightCommand}" Visibility="{Binding Path=OneNightButtonVisibility, FallbackValue=Visible}">
            <TextBlock Name="OneNightButtonText" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=OneNightButtonText, FallbackValue=$1.50 for 1 night}" />
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="MultiNightButton" Width="315" Height="59" Margin="0,24,0,0" CornerRadius="28" Style="{StaticResource style_rb_purple_white_border_button}" Command="{x:Static views:MultiNightPricingPopupViewUserControlCommands.MultiNightCommand}" Visibility="{Binding Path=MultiNightButtonVisibility, FallbackValue=Visible}">
            <TextBlock Name="MultiNightButtonText" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=MultiNightButtonText, FallbackValue=$2.00 for 3 nights}" />
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="BuyButton" Width="315" Height="59" Margin="0,24,0,0" CornerRadius="28" Style="{StaticResource style_rubine_white_border_button}" Command="{x:Static views:MultiNightPricingPopupViewUserControlCommands.BuyCommand}" Visibility="{Binding Path=BuyButtonVisibility, FallbackValue=Visible}">
            <TextBlock Name="BuyButtonText" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=BuyButtonText, FallbackValue=$3.99 to own it}" />
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="CancelButton" Width="315" Height="59" Margin="0,24,0,0" CornerRadius="28" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" Command="{x:Static views:MultiNightPricingPopupViewUserControlCommands.CancelCommand}">
            <TextBlock Name="CancelButtonText" Foreground="#E42045" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=CancelButtonText, FallbackValue=Cancel}" />
          </Redbox:RoundedButton>
        </StackPanel>
        <TextBlock Name="DisclaimerText" Width="500" Height="60" VerticalAlignment="Top" Margin="0,521,0,0" Foreground="#303539" TextWrapping="Wrap" Style="{StaticResource font_montserrat_regular_12}" Text="{Binding Path=DisclaimerText, FallbackValue='Our multi-night deal cant be combined with other offers. Your awesome rental rate is good during the multi-night period. If you keep your rental longer, thats totally fine - extra nights are $1.50.'}" />
      </Grid>
    </Border>
  </Grid>
</controls:TextToSpeechUserControl>