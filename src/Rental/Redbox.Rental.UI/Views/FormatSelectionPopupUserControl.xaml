<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.FormatSelectionPopupUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:views="clr-namespace:Redbox.Rental.UI.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="DescriptionTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_montserrat_regular_22}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding DescriptionText}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondLineTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_montserrat_medium_20}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Line2Text}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static views:FormatSelectionPopupViewUserControlCommands.FormatCommand}" Executed="FormatCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:FormatSelectionPopupViewUserControlCommands.CancelCommand}" Executed="CancelCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:FormatSelectionPopupViewUserControlCommands.DigitalCodeInfoCommand}" Executed="DigitalCodeInfoCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Name="BackgroundGrid" Background="#FF000000" Opacity="0.6" />
    <Border VerticalAlignment="Center" Background="#FFFFFFFF" CornerRadius="28" Width="{Binding Path=DialogWidth, FallbackValue=750}">
      <StackPanel Margin="0,55,0,0">
        <TextBlock Name="HeaderText" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="47,0,0,0" Foreground="#782D8D" Style="{StaticResource font_montserrat_bold_24}" Text="{Binding Path=HeaderText, FallbackValue=John Wick}" />
        <TextBlock Name="DescriptionText" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="47,10,47,0" TextWrapping="Wrap" Foreground="#782D8D" Style="{StaticResource DescriptionTextStyle}" Text="{Binding Path=DescriptionText, FallbackValue=Pick your format}" />
        <ItemsControl Name="FormatButtonsItemsControl" Margin="0,0,0,50" ItemsSource="{Binding ButtonData}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Redbox:RoundedButton Width="250" Height="59" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25,35,25,0" CornerRadius="28" Style="{StaticResource warm_purple_no_border_button_style}" Command="{x:Static views:FormatSelectionPopupViewUserControlCommands.FormatCommand}" Visibility="Visible" Tag="{Binding Format}" IsEnabled="{Binding IsEnabled}">
                <StackPanel Orientation="Vertical">
                  <TextBlock Style="{StaticResource font_montserrat_extrabold_16}" HorizontalAlignment="Center" Text="{Binding Text}" />
                  <TextBlock Style="{StaticResource SecondLineTextStyle}" HorizontalAlignment="Center" Text="{Binding Line2Text}" />
                </StackPanel>
              </Redbox:RoundedButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Redbox:RoundedButton Name="CancelButton" Width="250" Height="59" VerticalAlignment="Top" Margin="0,35,0,25" CornerRadius="28" Style="{StaticResource thin_border_button_style}" Command="{x:Static views:FormatSelectionPopupViewUserControlCommands.CancelCommand}">
          <TextBlock Name="CancelButtonText" Foreground="#E42045" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=CancelButtonText, FallbackValue=Cancel}" />
        </Redbox:RoundedButton>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="{Binding Path=DigitalCodeInfoVisibility, FallbackValue=Visible}">
          <TextBlock Style="{StaticResource font_montserrat_regular_16}" Foreground="#782D8D" VerticalAlignment="Center" Text="{Binding Path=DigitalCodeInfoText, FallbackValue=*What is a Digital Code?}" />
          <Redbox:RoundedButton Name="DigitalCodeInfoButton" Width="40" Height="40" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" Command="{x:Static views:FormatSelectionPopupViewUserControlCommands.DigitalCodeInfoCommand}" CornerRadius="21" Margin="10,0,5,0" IsEnabled="True">
            <TextBlock Style="{StaticResource font_montserrat_bold_24}">i</TextBlock>
          </Redbox:RoundedButton>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</controls:TextToSpeechUserControl>