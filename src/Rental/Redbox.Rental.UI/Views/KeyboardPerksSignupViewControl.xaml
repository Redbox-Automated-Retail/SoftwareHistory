<?xml version="1.0" encoding="utf-8"?>
<local:KeyboardControl x:Class="Redbox.Rental.UI.Views.KeyboardPerksSignupViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls">
  <Border Name="MainControl" Background="#FFFFFFFF" Height="768" Width="1024">
    <Redbox:GridExt Margin="0,20,0,0" RowHeights="80,90,70,410,*,100">
      <Grid Row="0" HorizontalAlignment="Center">
        <TextBlock Name="TitleTextElem" Margin="25,0,25,10" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource font_museo_slab_900_40}" Foreground="{StaticResource WarmPurpleBrush}" Text="{Binding Path=TitleText, FallbackValue=Sign up for Redbox Perks}" />
      </Grid>
      <Grid Row="1" HorizontalAlignment="Center">
        <Redbox:BorderButton Name="EmailElem" BorderSize="490,64" HorizontalAlignment="Left" Style="{StaticResource border_button_style}" Click="EmailSelected">
          <Grid Background="#00FFFFFF">
            <TextBlock Name="EmailTextElem" Height="32" Width="420" TextWrapping="NoWrap" Style="{StaticResource style_keyboard_input_text}" Text="{Binding Path=KeyboardText}" />
            <TextBlock Name="EmailPromotTextElem" Height="32" Width="auto" Style="{StaticResource style_keyboard_input_text}" Foreground="{StaticResource PromptGrayBrush}" Text="{Binding Path=EmailPromptText, FallbackValue=email}" Visibility="{Binding ElementName=EmailTextElem, Path=Text, Converter={StaticResource TextVisibilityConverter}}" />
          </Grid>
        </Redbox:BorderButton>
      </Grid>
      <Grid Row="2" Margin="40,0">
        <TextBlock Name="PrivacyMessageElem" Grid.Row="1" Margin="28,10" HorizontalAlignment="Center" VerticalAlignment="Top" Height="32" Width="auto" Style="{StaticResource font_montserrat_medium_14}" Foreground="{StaticResource DarkGrayBrush}" Text="{Binding Path=MessageText, FallbackValue='Dont worry, well never share your info -- its safe with us'}" Visibility="{Binding ElementName=KeyboardErrorElem, Path=Text, Converter={StaticResource TextVisibilityConverter}}" />
        <TextBlock Name="KeyboardErrorElem" Grid.Row="1" Margin="28,10" HorizontalAlignment="Center" VerticalAlignment="Top" Height="32" Width="auto" Style="{StaticResource keyboard_error_message_style}" Text="{Binding Path=KeyboardError, FallbackValue=Error message...}" />
      </Grid>
      <localControls:KeyboardUserControl x:Name="KeyboardElem" Grid.Row="3" Margin="0,10,0,20" />
      <Grid Row="5" Background="{StaticResource LightGrayBackgroundBrush}">
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
          <Redbox:RoundedButton Name="CancelButtonElem" Grid.Column="1" Margin="5,10,20,20" MinWidth="223" Height="56" CornerRadius="28" Style="{StaticResource style_white_rubine_border_button}" IsEnabled="True" Command="{Binding CancelButtonCommand}">
            <TextBlock Name="CancelButtonTextElem" Margin="30,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_28}" Text="{Binding CancelButtonText, FallbackValue=No Thanks}" />
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="ContinueButtonElem" Grid.Column="2" Margin="20,10,5,20" MinWidth="223" Height="56" CornerRadius="28" Style="{StaticResource style_rb_purple_white_border_button}" IsEnabled="True" Click="ContinueTouched">
            <TextBlock Name="ContinueButtonTextElem" Margin="50,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_28}" Text="{Binding ContinueButtonText, FallbackValue=Continue}" />
          </Redbox:RoundedButton>
        </StackPanel>
      </Grid>
    </Redbox:GridExt>
  </Border>
</local:KeyboardControl>