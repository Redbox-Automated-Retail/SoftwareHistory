<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.SignInViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:views="clr-namespace:Redbox.Rental.UI.Views">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static views:SignInViewUserControlCommands.EmailAndPasswordCommand}" Executed="EmailAndPasswordCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:SignInViewUserControlCommands.PhoneAndPinCommand}" Executed="PhoneAndPinCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:SignInViewUserControlCommands.CancelCommand}" Executed="CancelCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#CA2351" Offset="0.0" />
        <GradientStop Color="#E12046" Offset="0.5" />
        <GradientStop Color="#CA2351" Offset="1.0" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock Name="header_label" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,80,0,0" Width="Auto" Height="Auto" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_48}" TextWrapping="NoWrap" TextAlignment="Center" Text="{Binding Path=HeaderLabelText, FallbackValue=Sign In to Redbox Perks}" />
    <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
      <Redbox:RoundedButton Name="PhoneAndPinButton" VerticalAlignment="Top" Margin="0,0,0,0" Width="391" MinHeight="78" Height="auto" UsedDefaultCornerRadius="True" Style="{StaticResource style_white_rubine_gradient_border_button}" Command="{x:Static views:SignInViewUserControlCommands.PhoneAndPinCommand}">
        <TextBlock Style="{StaticResource font_museo_slab_900_28}" Margin="40,20" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Path=PhoneAndPinButtonText, FallbackValue=Phone &amp; 4-Digit PIN}" />
      </Redbox:RoundedButton>
      <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Width="auto" Height="auto" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_28}" Margin="0,20,0,0" Text="{Binding SignInOrLabelText, FallbackValue=or}" />
      <Redbox:RoundedButton Name="EmailAndPasswordButton" VerticalAlignment="Top" Margin="0,20,0,0" Width="391" Height="78" UsedDefaultCornerRadius="True" Style="{StaticResource style_white_rubine_gradient_border_button}" Command="{x:Static views:SignInViewUserControlCommands.EmailAndPasswordCommand}">
        <TextBlock Style="{StaticResource font_museo_slab_900_28}" Margin="40,20" Text="{Binding Path=EmailAndPasswordButtonText, FallbackValue=Email &amp; Password}" />
      </Redbox:RoundedButton>
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
      <BulletDecorator Margin="15,30,40,0">
        <BulletDecorator.Bullet>
          <Ellipse Height="8" Width="8" Fill="#FFFFFFFF" />
        </BulletDecorator.Bullet>
        <TextBlock Name="SignInPointOneTextBlock" Style="{StaticResource font_montserrat_semibold_24}" Margin="20,0,0,0" Foreground="#FFFFFFFF" TextWrapping="Wrap">
          <Span Style="{StaticResource span_font_montserrat_semibold_24}" Foreground="#FFFFFFFF">
            <Run Text="{Binding Path=SignInPointOnePartOneText, FallbackValue=Use points for}" />
          </Span> <Span Style="{StaticResource span_font_montserrat_bold_24}" Foreground="#FFFFFFFF"><Run Text="{Binding Path=SignInPointOnePartTwoText, FallbackValue=FREE 1-night}" /></Span> <Span Style="{StaticResource span_font_montserrat_semibold_24}" Foreground="#FFFFFFFF"><Run Text="{Binding Path=SignInPointOnePartThreeText, FallbackValue=disc rentals}" /></Span></TextBlock>
      </BulletDecorator>
      <BulletDecorator Margin="15,20,40,0">
        <BulletDecorator.Bullet>
          <Ellipse Height="8" Width="8" Fill="#FFFFFFFF" />
        </BulletDecorator.Bullet>
        <TextBlock Style="{StaticResource font_montserrat_semibold_24}" Margin="20,0,0,0" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding SignInPointTwoText, FallbackValue=Access promos to use now}" />
      </BulletDecorator>
      <BulletDecorator Margin="15,20,40,0">
        <BulletDecorator.Bullet>
          <Ellipse Height="8" Width="8" Fill="#FFFFFFFF" />
        </BulletDecorator.Bullet>
        <TextBlock Style="{StaticResource font_montserrat_semibold_24}" Margin="20,0,0,0" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding SignInPointThreeText, FallbackValue=Check your Redbox Perks level &amp; offers}" />
      </BulletDecorator>
    </StackPanel>
    <Redbox:RoundedButton Name="CancelButton" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2 " VerticalAlignment="Bottom" Margin="0,10,0,30" Width="234" Height="78" UsedDefaultCornerRadius="True" Style="{StaticResource warmpurple_white_border_button_style}" Command="{x:Static views:SignInViewUserControlCommands.CancelCommand}">
      <TextBlock Style="{StaticResource font_museo_slab_900_28}" Text="{Binding Path=CancelButtonText, FallbackValue=Cancel}" />
    </Redbox:RoundedButton>
  </Grid>
</controls:TextToSpeechUserControl>