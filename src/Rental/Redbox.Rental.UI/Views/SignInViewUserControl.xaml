<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.SignInViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:views="clr-namespace:Redbox.Rental.UI.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <views:NullToVisibilityConverter x:Key="NullToVisibility" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFFFFFFF">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="103" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Grid.Row="0" Margin="16,16,0,16" CornerRadius="20" Background="{StaticResource RubineToDarkPurpleGradientBrush}">
      <DockPanel Margin="48,44,48,5">
        <Image DockPanel.Dock="Top" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/perks-white-logo.png" Width="224" Height="79" HorizontalAlignment="Left" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" VerticalAlignment="Bottom" MinHeight="450">
          <TextBlock Name="header_label" Margin="0,0,0,0" Width="Auto" Height="Auto" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_36}" TextWrapping="Wrap" TextAlignment="Left" Text="{Binding Path=HeaderLabelText, FallbackValue=Get free stuff just for signing up}" />
          <BulletDecorator Margin="10,40,0,0" Height="Auto">
            <BulletDecorator.Bullet>
              <Ellipse Height="6" Width="6" Fill="#FFFFFFFF" />
            </BulletDecorator.Bullet>
            <TextBlock Name="bullet_1" Margin="20,0,2,0" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_semibold_20}" TextWrapping="Wrap" Text="{Binding Path=Bullet1Text, FallbackValue=FREE 1-night DVD rental* }" />
          </BulletDecorator>
          <BulletDecorator Margin="10,20,0,0" Height="Auto">
            <BulletDecorator.Bullet>
              <Ellipse Height="6" Width="6" Fill="#FFFFFFFF" />
            </BulletDecorator.Bullet>
            <TextBlock Name="bullet_2" Margin="20,0,0,0" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_semibold_20}" Text="{Binding Path=Bullet2Text, FallbackValue=Special deals just for you}" />
          </BulletDecorator>
          <BulletDecorator Margin="10,20,0,0" Height="Auto">
            <BulletDecorator.Bullet>
              <Ellipse Height="6" Width="6" Fill="#FFFFFFFF" />
            </BulletDecorator.Bullet>
            <TextBlock Name="bullet_3" Margin="20,0,0,0" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_semibold_20}" Text="{Binding Path=Bullet3Text, FallbackValue=B-day gift}" />
          </BulletDecorator>
          <TextBlock Name="bottom_message" Margin="0,45,0,0" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_semibold_14}" HorizontalAlignment="Center" Text="{Binding Path=BottomMessageText, FallbackValue='Its free, just enter your email'}" />
          <Redbox:RoundedButton Name="SignUpButton" VerticalAlignment="Top" Margin="0,10,0,0" MinHeight="56" Height="Auto" UsedDefaultCornerRadius="True" Style="{StaticResource style_white_rubine_gradient_border_button}" Command="{Binding SignUpButtonCommand}">
            <TextBlock Margin="40,0" TextWrapping="Wrap" TextAlignment="Center" Style="{Binding ButtonTextStyle, FallbackValue={StaticResource font_museo_slab_900_28}}" Text="{Binding Path=SignUpButtonText, FallbackValue=Sign Up}" />
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="InfoButton" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,10,0,0" Height="Auto" UsedDefaultCornerRadius="True" Style="{StaticResource transparent_button_style}" IsEnabled="True" Command="{Binding InfoButtonCommand}">
            <TextBlock Style="{StaticResource font_montserrat_bold_underline_18}" Margin="0,20" Foreground="#FFFFFFFF" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Path=InfoButtonText, FallbackValue=How it works}" />
          </Redbox:RoundedButton>
        </StackPanel>
      </DockPanel>
    </Border>
    <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="60,0,0,20">
      <TextBlock HorizontalAlignment="Left" Width="auto" Height="auto" Foreground="{StaticResource WarmPurpleBrush}" Style="{StaticResource font_montserrat_semibold_20}" Margin="0,0,0,0" Text="{Binding AlreadyMemberText, FallbackValue=Already a member?}" />
      <TextBlock HorizontalAlignment="Left" Width="auto" Height="auto" Foreground="{StaticResource WarmPurpleBrush}" Style="{StaticResource font_museo_slab_900_36}" Margin="0,10,0,0" Text="{Binding SignInLabelText, FallbackValue=Sign In}" />
      <Redbox:RoundedButton Name="PhoneAndPinButton" HorizontalAlignment="Left" Margin="0,30,0,0" Width="385" MinHeight="56" Height="auto" UsedDefaultCornerRadius="True" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" Command="{Binding PhoneAndPinButtonCommand}">
        <TextBlock Margin="20,0" TextWrapping="Wrap" TextAlignment="Center" Style="{Binding ButtonTextStyle, FallbackValue={StaticResource font_museo_slab_900_28}}" Text="{Binding Path=PhoneAndPinButtonText, FallbackValue=Phone &amp; 4-Digit PIN}" />
      </Redbox:RoundedButton>
      <Redbox:RoundedButton Name="EmailAndPasswordButton" HorizontalAlignment="Left" Margin="0,20,0,0" Width="385" MinHeight="56" UsedDefaultCornerRadius="True" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" Command="{Binding EmailAndPasswordButtonCommand}">
        <TextBlock Margin="20,0" Style="{Binding ButtonTextStyle, FallbackValue={StaticResource font_museo_slab_900_28}}" Text="{Binding Path=EmailAndPasswordButtonText, FallbackValue=Email &amp; Password}" />
      </Redbox:RoundedButton>
    </StackPanel>
    <Grid Row="1" ColumnSpan="2" Background="{StaticResource LightGrayBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Redbox:RoundedButton Name="CancelButton" VerticalAlignment="Center" HorizontalAlignment="Left" Width="132" Height="48" UsedDefaultCornerRadius="True" Margin="30,0,0,0" Style="{StaticResource style_white_rubine_gradient_border_button}" Command="{Binding CancelButtonCommand}">
        <TextBlock Style="{StaticResource font_museo_slab_900_24}" Text="{Binding Path=CancelButtonText, FallbackValue=Back}" />
      </Redbox:RoundedButton>
      <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
        <TextBlock Margin="20,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource font_montserrat_bold_12}" Foreground="{StaticResource DarkGrayBrush}" Text="{Binding PrivacyText, FallbackValue='To review our Terms, Privacy Policy, including our CA Privacy Notice, or to exercise your Do Not Sell Rights, see Terms.'}" Visibility="{Binding PrivacyText, Converter={StaticResource NullToVisibility}}" />
        <TextBlock Margin="20,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource font_montserrat_medium_12}" Foreground="{StaticResource DarkGrayBrush}" Text="{Binding LegalText, FallbackValue='*Free 1-night DVD rental Welcome Offer will show up as 1,500 points in your account within 48 hours of creating account. Payment card required. Charges apply for additional days. Cant be combined with other offers. Subject to terms at redbox.com/perks/terms.'}" />
      </StackPanel>
      <Redbox:RoundedButton Name="TermsButton" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0" MinWidth="110" Height="48" Style="{StaticResource TransparentButton}" Command="{Binding TermsButtonCommand}">
        <TextBlock Margin="0,0,25,0" Style="{StaticResource font_montserrat_extrabold_underline_16}" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource RubineRedBrush}" Text="{Binding Path=TermsButtonText, FallbackValue=Terms &amp; Privacy}" />
      </Redbox:RoundedButton>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>