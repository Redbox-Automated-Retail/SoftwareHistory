<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.PresentOffersViewUserControl" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <Grid Background="#FFFFFFFF">
    <Grid.RowDefinitions>
      <RowDefinition Height="600" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ItemsControl Grid.Row="0" ItemsSource="{Binding Offers}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <controls:OfferInfoUserControl Margin="0,0,4,0" DataContext="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,-4,0" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
    <TextBlock Grid.Row="1" Style="{StaticResource font_montserrat_medium_24}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,20" Text="{Binding MessageText, FallbackValue=Offer good during this visit only}" Visibility="{Binding MessageVisibility}" />
    <TextBlock Grid.Row="1" Style="{StaticResource font_montserrat_medium_18}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,40,0,10" Text="{Binding ExpirationText, FallbackValue=Expires 4/30/19}" Visibility="{Binding ExpirationVisibility, FallbackValue=Collapsed}" />
    <Grid Row="2" Margin="24,0,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_medium_12}" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{Binding LegalText, FallbackValue=Lorem Ipsum etc. etc.}" />
      <redbox:RoundedButton Name="CancelButton" Grid.Column="1" MinWidth="243" Height="59" VerticalAlignment="Center" Margin="25,0" CornerRadius="28" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" Command="{Binding CancelButtonCommand}" Visibility="{Binding CancelButtonVisibility}">
        <TextBlock Name="CancelButtonText" Foreground="#E42045" Style="{StaticResource font_museo_slab_900_32}" Text="{Binding Path=CancelButtonText, FallbackValue=No Thanks}" />
      </redbox:RoundedButton>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>