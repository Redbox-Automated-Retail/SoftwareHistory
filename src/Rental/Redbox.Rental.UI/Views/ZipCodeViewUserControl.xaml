<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.ZipCodeViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ui="clr-namespace:Redbox.Rental.UI" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:views="clr-namespace:Redbox.Rental.UI.Views">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static ui:Commands.ResetIdleTimerCommand}" Executed="ResetIdleTimerCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:ZipCodeViewUserControlCommands.NextCommand}" Executed="NextCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="next_button_style" TargetType="{x:Type Redbox:RoundedButton}" BasedOn="{StaticResource inactive_button_style}">
        <Setter Property="Redbox:RoundedButton.BorderColor" Value="#E42045" />
        <Setter Property="Redbox:RoundedButton.BorderGradientColor" Value="#E42045" />
        <Setter Property="Redbox:RoundedButton.BackgroundColor" Value="White" />
        <Setter Property="Redbox:RoundedButton.BackgroundGradientColor" Value="White" />
        <Setter Property="Foreground" Value="#E42045" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFFFFFFF">
    <StackPanel Margin="{Binding Path=StackPanelMargin}">
      <Image Name="ad_image" Width="668" Height="83" Margin="0,12,0,0" Source="{Binding Path=AdImageSource}" Visibility="{Binding Path=AdImageVisibility}" />
      <TextBlock Name="header_label" Margin="19,0,0,0" Width="512" Height="42" Foreground="#2C2E32" HorizontalAlignment="Left" Style="{StaticResource keyboard_prompt_message_style}" Text="{Binding Path=HeaderLabelText}" />
      <Grid Name="draw_line" Margin="20,0,0,10" HorizontalAlignment="Left" Width="985" Height="2" Background="#2C2E32" />
      <Border CornerRadius="30" Width="280" Height="65" BorderBrush="#A5A5A5" BorderThickness="1" Background="#FFFFFFFF">
        <UIElement.Effect>
          <DropShadowEffect Direction="180" ShadowDepth="4" Color="#E1E1E1" />
        </UIElement.Effect>
        <TextBlock Name="DisplayText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource style_keyboard_input_text}" Text="{Binding Path=DisplayText}" />
      </Border>
      <controls:KeypadUserControl Height="395" Width="310" DataContext="{Binding Path=KeypadModel}" />
    </StackPanel>
    <Grid Name="bottom_background" Margin="0,624,0,0" Width="1024" Height="146" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#380B44" />
    <TextBlock Name="note1_label" Margin="20,640,0,0" Foreground="#FFFFFFFF" Style="{StaticResource font_akzidenz_regular_small}" Text="{Binding Path=Note1LabelText}" />
    <TextBlock Name="note2_label" Margin="-284,680,0,0" Width="700" TextWrapping="Wrap" Foreground="#FFFFFFFF" Style="{StaticResource font_akzidenz_regular_small}" Text="{Binding Path=Note2LabelText}" />
    <Redbox:RoundedButton Name="NextButton" Margin="760,618,0,0" Width="196" Height="66" CornerRadius="32" Style="{StaticResource next_button_style}" Command="{x:Static views:ZipCodeViewUserControlCommands.NextCommand}" IsEnabled="{Binding Path=IsNextButtonEnabled}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=NextButtonText}" />
        <Image Width="15" Margin="5,2,0,0" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/next-right-arrow-rubine.png" Visibility="{Binding Path=NextButtonArrowVisibility}" />
      </StackPanel>
    </Redbox:RoundedButton>
  </Grid>
</controls:TextToSpeechUserControl>