<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.PerksOfferDetailsViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:views="clr-namespace:Redbox.Rental.UI.Views" xmlns:ui="clr-namespace:Redbox.Rental.UI" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" DataContextChanged="PerksOfferDetailsViewUserControl_DataContextChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static views:PerksOfferDetailsViewUserControlCommands.CancelCommand}" Executed="CancelCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Name="BackgroundGrid" Background="#FF000000" Opacity="0.6" />
    <Border Width="560" Height="550" Background="#FFFFFFFF" CornerRadius="25">
      <Grid>
        <Border Width="105" Height="105" VerticalAlignment="Top" Margin="0,30,0,0" CornerRadius="90" Background="#782D8D">
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock Name="OfferValueText" Width="105" Height="35" TextAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_bold_30}" Text="{Binding Path=OfferValueText, FallbackValue=OfferValueText}" />
            <TextBlock Name="OfferUnitsText" Width="105" Height="25" TextAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_700_18}" Text="{Binding Path=OfferUnitsText, FallbackValue=OfferUnitsText}" />
          </StackPanel>
        </Border>
        <TextBlock Name="ProgressText" Width="420" Height="25" VerticalAlignment="Top" TextAlignment="Center" Margin="0,151,0,0" Foreground="#782D8D" Style="{StaticResource font_museo_slab_700_18}" Text="{Binding Path=ProgressText, FallbackValue=ProgressText}" />
        <StackPanel Name="ProgressStackPanel" Orientation="Horizontal" Width="0" Height="40" VerticalAlignment="Top" Margin="0,185,0,0" />
        <TextBlock Name="NameText" Width="420" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="71,234,0,0" Foreground="#782D8D" Style="{StaticResource font_montserrat_semibold_20}" Text="{Binding Path=NameText, FallbackValue=NameText}" />
        <TextBlock Name="DescriptionText" Width="420" Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="71,267,0,0" TextWrapping="Wrap" Foreground="#782D8D" Style="{StaticResource font_montserrat_regular_16}" Text="{Binding Path=DescriptionText, FallbackValue=DescriptionText}" />
        <Border Name="LineBorder" Width="435" Height="3" VerticalAlignment="Top" Margin="0,320,0,0" Style="{StaticResource browse_top_menu_background_style}" />
        <TextBlock Name="DateRangeText" Width="420" Height="15" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="71,340,0,0" Foreground="#782D8D" Style="{StaticResource font_montserrat_semibold_12}" Text="{Binding Path=DateRangeText, FallbackValue=DateRangeText}" />
        <TextBlock Name="LegalInformationText" Width="420" Height="80" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="71,363,0,0" TextWrapping="Wrap" Foreground="#782D8D" Style="{StaticResource font_montserrat_regular_12}" Text="{Binding Path=LegalInformationText, FallbackValue=LegalInformationText}" />
        <Redbox:RoundedButton Name="CancelButton" Width="200" Height="60" VerticalAlignment="Top" Margin="0,456,0,0" CornerRadius="28" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" Command="{x:Static views:PerksOfferDetailsViewUserControlCommands.CancelCommand}">
          <TextBlock Name="CancelButtonText" Foreground="#E42045" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=CancelButtonText, FallbackValue=Cancel}" />
        </Redbox:RoundedButton>
      </Grid>
    </Border>
  </Grid>
</controls:TextToSpeechUserControl>