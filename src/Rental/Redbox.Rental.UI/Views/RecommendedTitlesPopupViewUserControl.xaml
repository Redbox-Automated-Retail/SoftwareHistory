<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.RecommendedTitlesPopupViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:views="clr-namespace:Redbox.Rental.UI.Views" xmlns:ui="clr-namespace:Redbox.Rental.UI" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static ui:Commands.ResetIdleTimerCommand}" Executed="ResetIdleTimerCommandBinding_Executed" />
    <CommandBinding Command="{x:Static views:RecommendedTitlesPopupViewUserControlCommands.CancelCommand}" Executed="CancelCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Name="BackgroundGrid" Background="#FF000000" Opacity="0.6" />
    <Border Width="863" Height="588" Background="#FFFFFFFF" CornerRadius="20">
      <Grid>
        <TextBlock Name="HeaderText" Width="655" Height="52" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="50,37,0,0" Foreground="#782D8D" Style="{StaticResource font_montserrat_bold_36}" Text="{Binding Path=HeaderText, FallbackValue=Recommended For You}" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="50,87,0,0" Visibility="{Binding Path=OfferTextVisibility, FallbackValue=Hidden}">
          <Image Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/circle-star.png" Width="38" Height="38" Margin="0,0,10,0" />
          <TextBlock Name="OfferText" Width="668" Margin="0,5,0,0" Foreground="#782D8D" TextWrapping="Wrap" Style="{StaticResource font_montserrat_regular_22}" Text="{Binding Path=OfferText, FallbackValue=Add to your cart and get additional Redbox Perks points.}" />
        </StackPanel>
        <controls:BrowseUserControl x:Name="BrowseProductControl" Width="863" Height="306" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,156,0,0" ShowPaddles="True" DataContext="{Binding Path=BrowseProductControlModel}" />
        <Redbox:RoundedButton Name="CancelButton" Width="200" Height="59" VerticalAlignment="Bottom" Margin="0,0,0,43" CornerRadius="28" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" Command="{x:Static views:RecommendedTitlesPopupViewUserControlCommands.CancelCommand}">
          <TextBlock Name="CancelButtonText" Foreground="#E42045" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=CancelButtonText, FallbackValue=No Thanks}" />
        </Redbox:RoundedButton>
      </Grid>
    </Border>
  </Grid>
</controls:TextToSpeechUserControl>