<?xml version="1.0" encoding="utf-8"?>
<localControls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.ReservationNotFoundUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.OkCommand}" Executed="OkCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <DockPanel>
      <Grid DockPanel.Dock="Top" Background="{StaticResource RubineRedBrush}" Height="626" VerticalAlignment="Top">
        <TextBlock Name="TitleText" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_regular_60}" TextWrapping="Wrap" Margin="60,49,0,0" Width="904" Text="{Binding Path=TitleText, FallbackValue=Your reservation is waiting.  Let us find it for you!}" />
        <TextBlock Name="MessageText" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_regular_24}" TextWrapping="Wrap" Margin="60,246,0,0" Width="904" Text="{Binding Path=MessageText, FallbackValue=This box doesnt have a reservation for you. That might be because:}" />
        <Image Name="PhoneImage" Width="279" Height="304" Margin="670,298,0,0" Source="{Binding Path=ImageName, FallbackValue='pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/phone_graphic.png'}" />
      </Grid>
      <Grid Background="{StaticResource EggplantBrush}">
        <Redbox:RoundedButton Name="OkButton" Style="{StaticResource white_rubine_border_button_style}" Width="191" Height="66" Margin="770,0,0,0" UsedDefaultCornerRadius="True" Command="{x:Static localbase:Commands.OkCommand}" Visibility="{Binding Path=AddGameButtonVisibility}">
          <TextBlock Name="OkButtonText" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=OkButtonText, FallbackValue=OK}" />
        </Redbox:RoundedButton>
      </Grid>
    </DockPanel>
  </Grid>
</localControls:TextToSpeechUserControl>