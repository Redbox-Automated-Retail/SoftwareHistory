<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.ShoppingCartUpdateADAViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" DataContextChanged="TextToSpeechUserControl_DataContextChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.GoBackCommand}" Executed="GoBackCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.AddMovieCommand}" Executed="AddMovieCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.AddGameCommand}" Executed="AddGameCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.BrowseItemCancelCommand}" Executed="BrowseItemCancelCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Name="DarkBackground" Background="#FF000000" Opacity="0.6" />
    <Grid Margin="82,133,82,133">
      <Border Background="#FFFFFFFF" CornerRadius="28">
        <TextBlock Name="TitleText" Margin="95,46" Foreground="#782d8d" Text="{Binding Path=Title, FallbackValue=Update your bag}" Style="{Binding Path=TitleStyle, FallbackValue={StaticResource font_montserrat_medium_30}}" />
      </Border>
      <TextBlock Name="MessageText" Margin="95,122" Foreground="#782d8d" Text="{Binding Path=Message, FallbackValue=This is your chance to remove and add stuff}" Style="{Binding Path=TitleStyle, FallbackValue={StaticResource font_montserrat_regular_24}}" />
      <Redbox:RoundedButton Name="OkButton" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,394,0,0" CornerRadius="32" Height="59" Width="163" Command="{x:Static localbase:Commands.GoBackCommand}">
        <TextBlock Name="OkButtonText" Style="{StaticResource font_museo_slab_900_20}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=OkButtonText, FallbackValue=Okay}" />
      </Redbox:RoundedButton>
      <StackPanel Name="ShoppingCartStackPanel" Margin="10,180,10,156" Orientation="Horizontal" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Grid Name="AddMovieAddGameGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="50*" />
              <RowDefinition Height="50*" />
            </Grid.RowDefinitions>
            <Redbox:RoundedButton Name="AddMovieButton" Style="{StaticResource classic_rubine_radio_button_with_dropshadow_style}" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="32" Height="59" Width="210" Command="{x:Static localbase:Commands.AddMovieCommand}" Visibility="{Binding Path=AddMovieButtonVisibility, FallbackValue=Visible}">
              <TextBlock Name="AddMovieButtonText" Style="{StaticResource font_museo_slab_900_20}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=AddMovieButtonText, FallbackValue=Add Movie}" />
            </Redbox:RoundedButton>
            <Redbox:RoundedButton Name="AddGameButton" Grid.Row="1" Style="{StaticResource classic_rubine_radio_button_with_dropshadow_style}" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="32" Height="59" Width="210" Command="{x:Static localbase:Commands.AddGameCommand}" Visibility="{Binding Path=AddGameButtonVisibility, FallbackValue=Visible}">
              <TextBlock Name="AddGameButtonText" Style="{StaticResource font_museo_slab_900_20}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Path=AddGameButtonText, FallbackValue=Add Game}" />
            </Redbox:RoundedButton>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>