<?xml version="1.0" encoding="utf-8"?>
<local:KeyboardControl x:Class="Redbox.Rental.UI.Views.KeyboardEmailReceiptViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls">
  <Border Name="MainControl" Background="#FFFFFFFF" Height="768" Width="1024">
    <Redbox:GridExt Margin="0,20,0,10" RowHeights="60,70,40,410,*,110">
      <Grid Row="0" HorizontalAlignment="Center">
        <TextBlock Name="MessageTextElem" Margin="25,0" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource keyboard_prompt_message_style}" Text="{Binding Path=MessageText, FallbackValue=Message}" />
      </Grid>
      <Grid Row="1" HorizontalAlignment="Center">
        <Redbox:BorderButton Name="EmailElem" BorderSize="490,64" HorizontalAlignment="Left" Style="{StaticResource border_button_style}" Click="EmailSelected">
          <Grid Background="#00FFFFFF">
            <TextBlock Name="EmailTextElem" Height="32" Width="420" TextWrapping="NoWrap" Style="{StaticResource style_keyboard_input_text}" Text="{Binding Path=KeyboardText}" />
            <TextBlock Name="EmailPromotTextElem" Height="32" Width="auto" Style="{StaticResource style_keyboard_input_text}" Foreground="{StaticResource PromptGrayBrush}" Text="{Binding Path=EmailPromptText, FallbackValue=email}" Visibility="{Binding ElementName=EmailTextElem, Path=Text, Converter={StaticResource TextVisibilityConverter}}" />
          </Grid>
        </Redbox:BorderButton>
      </Grid>
      <Grid Row="2">
        <TextBlock Name="KeyboardErrorElem" Grid.Row="1" Margin="110,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="32" Width="auto" Style="{StaticResource keyboard_error_message_style}" Text="{Binding Path=KeyboardError, FallbackValue=Error message...}" />
      </Grid>
      <localControls:KeyboardUserControl x:Name="KeyboardElem" Grid.Row="3" Margin="0,10,0,20" />
      <TextBlock Name="MarketingTextElem" Grid.Row="4" Margin="104,0" Style="{StaticResource keyboard_marketing_message_style}" Text="{Binding MarketingText, FallbackValue=Marketing}" />
      <Grid Row="5">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Redbox:RoundedButton Name="CancelButtonElem" Grid.Column="1" Width="261" Margin="8,0,8,0" Style="{StaticResource button_light_large_secondary_style}" IsEnabled="True" Command="{Binding CancelButtonCommand}">
            <TextBlock Name="CancelButtonTextElem" Style="{StaticResource button_text_large_style}" Text="{Binding CancelButtonText, FallbackValue=SKIP}" />
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="ContinueButtonElem" Grid.Column="2" Width="261" Margin="8,0,8,0" Style="{StaticResource button_light_large_primary_style}" IsEnabled="True" Click="ContinueTouched">
            <TextBlock Name="ContinueButtonTextElem" Style="{StaticResource button_text_large_style}" Text="{Binding ContinueButtonText, FallbackValue=YES}" />
          </Redbox:RoundedButton>
        </StackPanel>
      </Grid>
    </Redbox:GridExt>
  </Border>
</local:KeyboardControl>