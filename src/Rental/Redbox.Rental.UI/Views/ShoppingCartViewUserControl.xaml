<?xml version="1.0" encoding="utf-8"?>
<localControls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.ShoppingCartViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" DataContextChanged="ShoppingCartViewUserControl_DataContextChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.GoBackCommand}" Executed="GoBackCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.TermsAndPrivacyCommand}" Executed="TermsAndPrivacyCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.PromoCodeCommand}" Executed="PromoCodeCommandBinding_Executed" CanExecute="PromoCodeCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.PayCommand}" Executed="PayCommandBinding_Executed" CanExecute="PayCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.AddMovieCommand}" Executed="AddMovieCommandCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.AddGameCommand}" Executed="AddGameCommandCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.UpdateBagCommand}" Executed="UpdateBagCommandCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.BrowseItemCancelCommand}" Executed="BrowseItemCancelCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.SignInCommand}" Executed="SignInCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.UsePointsCommand}" Executed="UsePointsCommandBinding_Executed" CanExecute="UsePointsCommandBinding_CanExecute" />
  </UIElement.CommandBindings>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:NullToVisibilityConverter x:Key="NullToVisibility" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Name="MainDividerGrid" Background="#FFFFFFFF">
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Name="Header">
        <Panel.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E42045" Offset="0.0" />
            <GradientStop Color="#902A7d" Offset="0.5" />
            <GradientStop Color="#491E54" Offset="1.0" />
          </LinearGradientBrush>
        </Panel.Background>
        <DockPanel>
          <TextBlock Name="LabelTop" Style="{StaticResource font_montserrat_semibold_36}" Foreground="#FFFFFFFF" Margin="32,12,0,0" Text="{Binding Path=LabelTop, FallbackValue=My Bag}" />
          <Grid HorizontalAlignment="Right" Visibility="{Binding PointsEstimateVisibility, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="263" />
              <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource font_montserrat_regular_14}" LineHeight="20" Foreground="#FFFFFFFF" TextWrapping="NoWrap" Text="{Binding PointsEstimateText, FallbackValue=Youre earning 750+ points on this visit}" />
            <Image Grid.Column="1" Width="24" Height="32" Margin="0,0,24,0" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/icon-rewards.png" />
          </Grid>
        </DockPanel>
      </Grid>
      <Grid Name="SubDividerGrid" Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="63*" />
          <ColumnDefinition Width="37*" />
        </Grid.ColumnDefinitions>
        <Line Name="DividingLine" Y1="0" Y2="654" Fill="#979797" Margin="0,23,0,23" Stroke="#979797" StrokeThickness="2" HorizontalAlignment="Right" Opacity="0.22" />
        <DockPanel Name="LeftSideDockPanel" LastChildFill="True">
          <DockPanel Name="ButtonBar" Height="80" Dock="Bottom" Margin="36,0,23,12">
            <Redbox:RoundedButton Name="BackButton" Style="{StaticResource thin_border_button_style}" Width="127" Height="48" UsedDefaultCornerRadius="True" VerticalAlignment="Center" HorizontalAlignment="Left" Command="{x:Static localbase:Commands.GoBackCommand}">
              <TextBlock Name="BackButtonText" VerticalAlignment="Center" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=BackButtonText, FallbackValue=BACK}" />
            </Redbox:RoundedButton>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Redbox:RoundedButton Name="AddMovieButton" Style="{StaticResource thin_border_button_style}" Width="205" Height="48" Margin="15,0,0,0" UsedDefaultCornerRadius="True" Command="{x:Static localbase:Commands.AddMovieCommand}" Visibility="{Binding Path=AddMovieButtonVisibility}">
                <TextBlock Name="AddMovieButtonText" VerticalAlignment="Center" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=AddMovieButtonText, FallbackValue=ADD MOVIE}" />
              </Redbox:RoundedButton>
              <Redbox:RoundedButton Name="AddGameButton" Style="{StaticResource thin_border_button_style}" Width="205" Height="48" Margin="15,0,0,0" UsedDefaultCornerRadius="True" Command="{x:Static localbase:Commands.AddGameCommand}" Visibility="{Binding Path=AddGameButtonVisibility}">
                <TextBlock Name="AddGameButtonText" VerticalAlignment="Center" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=AddGameButtonText, FallbackValue=ADD GAME}" />
              </Redbox:RoundedButton>
              <Redbox:RoundedButton Name="UpdateBagButton" Style="{StaticResource thin_border_button_style}" Width="225" Height="48" Margin="15,0,0,0" UsedDefaultCornerRadius="True" Command="{x:Static localbase:Commands.UpdateBagCommand}" Visibility="{Binding Path=UpdateBagButtonVisibility}">
                <TextBlock Name="UpdateBagButtonText" VerticalAlignment="Center" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=UpdateBagButtonText, FallbackValue=UPDATE BAG}" />
              </Redbox:RoundedButton>
            </StackPanel>
          </DockPanel>
          <StackPanel Name="LeftSideTopPanel" Orientation="Vertical" Margin="36,14,23,0">
            <StackPanel Name="ShoppingCartStackPanel" Orientation="Vertical" />
            <StackPanel Name="ProductStackPanel" Orientation="Vertical" />
            <TextBlock Name="PassiveSaleNote" Style="{StaticResource font_montserrat_regular_11}" Foreground="#481b54" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding Path=PassiveSaleNote, FallbackValue=*Daily rental charges dont include tax.}" />
            <TextBlock Name="PrivacyNotice" Style="{StaticResource font_montserrat_regular_11}" Foreground="#481b54" TextWrapping="Wrap" Margin="0,0,0,1" Text="{Binding Path=PrivacyText, FallbackValue=*See Terms for privacy policy.}" Visibility="{Binding PrivacyText, Converter={StaticResource NullToVisibility}}" />
            <TextBlock Name="ServiceFeeText" Style="{StaticResource font_montserrat_regular_11}" Foreground="#481b54" TextWrapping="Wrap" Margin="0,1,0,1" Text="{Binding Path=ServiceFeeText, FallbackValue=All checkouts may be subject to a service fee of 10¢.}" Visibility="{Binding Path=ServiceFeeTextVisibility}" />
            <TextBlock Name="MDVFootnote" Style="{StaticResource font_montserrat_regular_11}" Foreground="#481b54" TextWrapping="Wrap" Margin="0,1,0,1" Text="{Binding Path=MDVFootnote, FallbackValue=**Your card will be charged the full nightly fee plus applicable taxes until both discs are returned.}" Visibility="{Binding Path=MDVFootnoteVisibility}" />
            <Line Name="PassiveSaleNoteBottomLine" X2="1000" Fill="#979797" Margin="0,3,0,3" Stroke="#979797" StrokeThickness="2" Opacity="0.22" />
          </StackPanel>
        </DockPanel>
        <DockPanel Name="RightSideDockPanel" Grid.Column="1" LastChildFill="True">
          <StackPanel Name="RightSideTopPanel" Orientation="Vertical" DockPanel.Dock="Top">
            <TextBlock Name="PriceHeaderText" Margin="24,24,24,7" Style="{StaticResource font_montserrat_semibold_24}" Foreground="#481b54" Text="{Binding Path=PriceHeaderText, FallbackValue=Payment Summary}" />
            <localControls:PricingUserControl Grid.Column="1" VerticalAlignment="Top" Margin="24,0,24,0" DataContext="{Binding Path=PricingModel}" />
            <TextBlock Name="LoyaltySystemErrorText" Margin="24,0,24,0" Style="{StaticResource font_montserrat_regular_16}" TextWrapping="Wrap" Foreground="#e42045" Text="{Binding Path=LoyaltySystemErrorText, FallbackValue=Uh oh - our points system is down but well get it fixed ASAP.}" />
            <Redbox:RoundedButton Name="SignInButton" Style="{StaticResource thin_border_button_style}" Height="48" Width="324" UsedDefaultCornerRadius="True" Margin="0,6,0,6" Command="{x:Static localbase:Commands.SignInCommand}" Visibility="{Binding Path=SignInButtonVisibility}">
              <TextBlock Name="SignInButtonText" TextAlignment="Center" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=SignInButtonText, FallbackValue=USE &amp; EARN POINTS}" />
            </Redbox:RoundedButton>
            <TextBlock Name="DontMissYourPerksText" Height="16" HorizontalAlignment="Center" Margin="0,-105,0,0" Padding="5,0,5,0" Style="{StaticResource font_montserrat_bold_12}" Background="#FFFFFFFF" Foreground="{StaticResource RubineRedBrush}" Text="{Binding Path=DontMissYourPerksText, FallbackValue=Sign in}" Visibility="{Binding Path=SignInButtonVisibility}" />
            <Redbox:RoundedButton Name="UsePointsButton" Style="{StaticResource thin_border_button_style}" Height="48" Width="324" UsedDefaultCornerRadius="True" Margin="0,24,0,6" Command="{x:Static localbase:Commands.UsePointsCommand}" Visibility="{Binding Path=UsePointsButtonVisibility}">
              <TextBlock Name="UsePointsButtonText" TextAlignment="Center" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=UsePointsButtonText, FallbackValue=USE POINTS}" />
            </Redbox:RoundedButton>
            <Redbox:RoundedButton Name="PromoCodeButton" Style="{StaticResource thin_border_button_style}" Height="48" Width="324" UsedDefaultCornerRadius="True" Margin="0,24,0,6" Command="{x:Static localbase:Commands.PromoCodeCommand}">
              <TextBlock Name="PromoCodeButtonText" TextAlignment="Center" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=PromoCodeButtonText, FallbackValue=APPLY PROMO}" />
            </Redbox:RoundedButton>
          </StackPanel>
          <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" DockPanel.Dock="Bottom">
            <TextBlock Name="AcceptAndPayText" Width="313" Margin="0,5,0,5" Style="{StaticResource font_montserrat_semibold_11}" Foreground="#481b54" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16" Text="{Binding Path=AcceptAndPayText, FallbackValue='By pressing &quot;Accept &amp; Pay&quot; you agree to the Redbox Terms of Use and Transaction Terms &amp; Conditions.'}" />
            <Redbox:RoundedButton Name="PayButton" Style="{StaticResource warm_purple_no_border_button_style}" Height="56" Width="324" UsedDefaultCornerRadius="True" Margin="0,6,0,26" Command="{x:Static localbase:Commands.PayCommand}">
              <TextBlock Name="PayButtonText" TextAlignment="Center" Style="{StaticResource font_montserrat_extrabold_20}" Text="{Binding Path=PayButtonText, FallbackValue=ACCEPT &amp; PAY}" />
            </Redbox:RoundedButton>
            <Redbox:RoundedButton Name="TermsAndPrivacyButton" Style="{StaticResource transparent_button_style}" Height="40" Width="315" VerticalAlignment="Center" HorizontalAlignment="Center" Command="{x:Static localbase:Commands.TermsAndPrivacyCommand}" Margin="0,0,0,27">
              <TextBlock Name="TermsAndPrivacyButtonText" Style="{StaticResource font_montserrat_bold_16}" TextDecorations="Underline" Foreground="#E42045" Text="{Binding Path=TermsAndPrivacyButtonText, FallbackValue=Terms &amp; Privacy}" />
            </Redbox:RoundedButton>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Grid>
    <Grid Name="DividerGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="149" />
      </Grid.RowDefinitions>
      <StackPanel Name="ShoppingCartFrameStackPanel" Orientation="Vertical" Margin="0,170,0,0">
        <Grid Name="ADASpacer" Height="60" Visibility="{Binding Path=ADASpacerVisibility}" />
      </StackPanel>
    </Grid>
  </Grid>
</localControls:TextToSpeechUserControl>