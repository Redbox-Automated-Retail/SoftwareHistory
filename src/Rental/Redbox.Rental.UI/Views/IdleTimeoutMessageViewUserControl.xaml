<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.IdleTimeoutMessageViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:Commands.Yes}" Executed="YesCommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:Commands.No}" Executed="NoCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Background="#FF000000" Opacity="0.6" />
    <Grid Margin="128, 96,128, 96">
      <Border Background="#FFFFFFFF" CornerRadius="28" BorderBrush="#E42045" BorderThickness="5">
        <TextBlock Name="MessageText" Text="Culture Specific Message" Margin="62,46" Foreground="#E42045" Style="{StaticResource font_target_large_overlays}" />
      </Border>
      <controls:RoundedButton x:Name="NoButton" Margin="62,482,0,0" Style="{StaticResource warm_purple_no_border_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="32" BorderBrush="#FFD3D3D3" BorderThickness="2" Width="191" Height="66" Command="{x:Static local:Commands.No}">
        <TextBlock Name="ButtonNo_Text" Style="{StaticResource font_target_small_button_overlays}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Nope" />
      </controls:RoundedButton>
      <controls:RoundedButton x:Name="YesButton" Margin="535,482,0,0" Style="{StaticResource rubine_no_border_button_style}" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="32" BorderBrush="#860C13" BorderThickness="3" Width="171" Height="66" Command="{x:Static local:Commands.Yes}">
        <TextBlock Name="ButtonYes_Text" Style="{StaticResource font_target_small_button_overlays}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Yup" />
      </controls:RoundedButton>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>