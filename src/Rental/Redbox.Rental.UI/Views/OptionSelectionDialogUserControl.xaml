<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.OptionSelectionDialogUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:views="clr-namespace:Redbox.Rental.UI.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:dvm="clr-namespace:Redbox.Rental.UI.Models.DesignTime">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="DescriptionTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_montserrat_regular_24}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding DescriptionText}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Name="BackgroundGrid" Background="#1c0f1e" Opacity="0.9" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="1" Background="#FFFFFFFF" CornerRadius="28" Opacity="1" Width="{Binding Path=DialogWidth, FallbackValue=720}">
        <StackPanel Margin="0,55,0,0">
          <TextBlock Name="HeaderText" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="50,0,50,0" Foreground="#782D8D" Style="{StaticResource font_montserrat_medium_30}" Text="{Binding Path=HeaderText, FallbackValue=Pick an option}" />
          <TextBlock Name="DescriptionText" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="50,20,50,0" Foreground="#782D8D" Style="{StaticResource DescriptionTextStyle}" TextWrapping="Wrap" Text="{Binding Path=DescriptionText, FallbackValue=More option text}" />
          <ItemsControl Name="ButtonsItemsControl" ItemsSource="{Binding ButtonData}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Redbox:RoundedButton Width="250" Height="59" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25,35,25,0" CornerRadius="28" Style="{StaticResource style_rb_purple_white_border_button}" Visibility="Visible" Command="{Binding Command}" CommandParameter="{Binding Tag}" Tag="{Binding Tag}" IsEnabled="{Binding IsEnabled}">
                  <StackPanel Orientation="Vertical">
                    <TextBlock Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_20}" HorizontalAlignment="Center" Text="{Binding Text}" />
                  </StackPanel>
                </Redbox:RoundedButton>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Redbox:RoundedButton Name="CancelButton" Width="250" Height="59" VerticalAlignment="Top" Margin="0,35,0,50" CornerRadius="28" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" Command="{Binding CancelCommand}">
            <TextBlock Name="CancelButtonText" Foreground="#E42045" Style="{StaticResource font_museo_slab_900_20}" Text="{Binding Path=CancelButtonText, FallbackValue=Cancel}" />
          </Redbox:RoundedButton>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>