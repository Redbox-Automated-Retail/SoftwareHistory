<?xml version="1.0" encoding="utf-8"?>
<localViews:ViewUserControl x:Class="Redbox.Rental.UI.Views.MemberPerksViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:localViews="clr-namespace:Redbox.Rental.UI.Views" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <localViews:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <DataTemplate x:Key="SnapshotTemplate">
        <Redbox:GridExt RowHeights="110,30,14,24" ColumnWidths="*" Loaded="TierControl_Loaded">
          <Image Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="94" Opacity="0.35" Source="{Binding ImagePath}" />
          <TextBlock Grid.Row="1" Margin="0,0,0,20" Opacity="0.35" Style="{StaticResource rubine_red_image_name_center_style}" Text="{Binding ImageName}" />
          <StackPanel Grid.Row="2" Height="10" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="3" HorizontalAlignment="Center" Height="24" FontSize="16" Opacity="0.35" Style="{StaticResource rubine_red_image_name_center_style}" Text="{Binding LabelText}" />
        </Redbox:GridExt>
      </DataTemplate>
      <DataTemplate x:Key="SectionalTemplate">
        <Redbox:GridExt Loaded="BarControl_Loaded">
          <Redbox:SectionalBar GroupCount="4" MaxValue="365" Visibility="Collapsed" Style="{StaticResource perks_sectional_bar_style}" Threshold="{Binding Threshold}" AutomationValue="{Binding Rentals}" Minimum="{Binding LowLimit}" Maximum="{Binding HighLimit}" ThresholdReached="SectionalBar_ThresholdReached" />
        </Redbox:GridExt>
      </DataTemplate>
      <DataTemplate x:Key="PromotionTemplate">
        <Redbox:GridExt Width="198" Height="245" Margin="12" RowHeights="*,70" Background="{StaticResource RubineRedBrush}">
          <Border Grid.Row="0" Margin="24">
            <TextBlock HorizontalAlignment="Center" Foreground="#FFFFFFFF" TextWrapping="Wrap" Style="{StaticResource font_museo_slab_900_24}" Text="{Binding PromoText}" />
          </Border>
          <Border Grid.Row="1" Margin="12,0,12,12" VerticalAlignment="Bottom" Height="60" Background="{StaticResource RubineRedBrush}">
            <TextBlock Margin="5" HorizontalAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource light_black_text_center_style}" Text="{Binding MarketingText}" />
          </Border>
        </Redbox:GridExt>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Redbox:GridExt Name="MainControl" Background="#FFFFFFFF" Width="1024" Height="768" RowHeights="75,*">
    <Grid Row="0" Style="{StaticResource style_header_rubine_background_gradient}">
      <TextBlock Name="LabelTop" Margin="50,14" Text="My Perks" Height="auto" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_36}" />
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource LightGrayBrush}" Padding="50,50,50,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="547" />
          <RowDefinition Height="96" />
        </Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Grid.Column="0" Columns="1">
          <Grid Visibility="{Binding SnapshotButtonVisibility}">
            <Redbox:GroupButton Name="SnapshotElem" GroupName="Perks" Style="{StaticResource group_button_style}" IsSelected="{Binding SnapshotSelected, Mode=TwoWay, FallbackValue=False}" Click="SnapshotButton_Pressed">
              <TextBlock Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_30}" Text="{Binding SnapshotButtonText, FallbackValue=Snapshot}" />
            </Redbox:GroupButton>
            <Polygon Style="{StaticResource white_right_center_left_triangle}" />
          </Grid>
          <Grid Visibility="{Binding PerksButtonVisibility}">
            <Redbox:GroupButton Name="PerksElem" GroupName="Perks" Style="{StaticResource group_button_style}" IsSelected="{Binding PerksSelected, Mode=TwoWay, FallbackValue=True}" Click="PerksButton_Pressed">
              <TextBlock Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_30}" Text="{Binding PerksButtonText, FallbackValue=Perks}" />
            </Redbox:GroupButton>
            <Polygon Style="{StaticResource white_right_center_left_triangle}" />
          </Grid>
          <Grid Visibility="{Binding PromoButtonVisibility}">
            <Redbox:GroupButton Name="PromosElem" GroupName="Perks" Style="{StaticResource group_button_style}" IsSelected="{Binding PromosSelected, Mode=TwoWay, FallbackValue=False}" Click="PromosButton_Pressed">
              <TextBlock Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_30}" Text="{Binding PromosButtonText, FallbackValue=Promos}" />
            </Redbox:GroupButton>
            <Polygon Style="{StaticResource white_right_center_left_triangle}" />
          </Grid>
        </UniformGrid>
        <Border Name="SnapshotContainerElem" Grid.Row="0" Grid.Column="1" Margin="0" Background="#FFFFFFFF" BorderThickness="0" Visibility="{Binding ElementName=SnapshotElem, Path=IsSelected, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
          <Redbox:GridExt Margin="30" RowHeights="50,80,*,200,48,30,30,20">
            <TextBlock Grid.Row="0" Style="{StaticResource rubine_red_bold_center_center_style}" Text="{Binding SnapshotTitle, FallbackValue=See how your Perks are powering up}" />
            <TextBlock Grid.Row="1" Style="{StaticResource rubine_red_bold_center_center_style}" FontSize="48" Text="{Binding SnapshotPoints, FallbackValue='32,598 points'}" />
            <Grid Name="SnapshotGridElem" Row="3" Margin="89,0">
              <Redbox:GridExt RowHeights="178" ColumnWidths="*,*,*">
                <ContentControl Grid.Column="0" ContentTemplate="{StaticResource SnapshotTemplate}" Content="{Binding SnapshotRentals[0]}" />
                <ContentControl Grid.Column="1" ContentTemplate="{StaticResource SnapshotTemplate}" Content="{Binding SnapshotRentals[1]}" />
                <ContentControl Grid.Column="2" ContentTemplate="{StaticResource SnapshotTemplate}" Content="{Binding SnapshotRentals[2]}" />
              </Redbox:GridExt>
              <Redbox:GridExt RowHeights="140,14" ColumnWidths="*,*,*,*,2*">
                <ContentControl Grid.Row="1" Grid.Column="0" ContentTemplate="{StaticResource SectionalTemplate}" Content="{Binding SnapshotRentals[3]}" />
                <ContentControl Grid.Row="1" Grid.Column="1" ContentTemplate="{StaticResource SectionalTemplate}" Grid.ColumnSpan="2" Content="{Binding SnapshotRentals[0]}" />
                <ContentControl Grid.Row="1" Grid.Column="3" ContentTemplate="{StaticResource SectionalTemplate}" Content="{Binding SnapshotRentals[1]}" />
                <ContentControl Grid.Row="1" Grid.Column="4" ContentTemplate="{StaticResource SectionalTemplate}" Content="{Binding SnapshotRentals[2]}" />
              </Redbox:GridExt>
            </Grid>
            <TextBlock Grid.Row="4" Style="{StaticResource rubine_red_regular_center_center_style}" FontSize="20" Text="{Binding SnapshotNextLevel, FallbackValue=[12] more rentals to reach the next level}" />
            <TextBlock Grid.Row="5" Style="{StaticResource rubine_red_regular_center_center_style}" FontSize="20" Text="{Binding SnapshotExpire, FallbackValue='7,854 points will expire on 10/06/18'}" />
          </Redbox:GridExt>
        </Border>
        <Border Name="PerksContainerElem" Grid.Row="0" Grid.Column="1" Margin="0" Background="#FFFFFFFF" BorderThickness="0" Visibility="{Binding ElementName=PerksElem, Path=IsSelected, Converter={StaticResource BoolToVisibility}}">
          <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Redbox:GridExt Margin="30" RowHeights="50,auto,50,auto">
              <TextBlock Grid.Row="0" Style="{StaticResource rubine_red_bold_center_center_style}" Text="{Binding PerksTitle}" />
              <Grid Row="1" Height="140" Visibility="{Binding PerksImageVisibility, FallbackValue=Visible}">
                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Height="106" Source="{Binding PerksImagePath}" />
              </Grid>
              <TextBlock Grid.Row="2" Style="{StaticResource rubine_red_bold_center_center_style}" FontSize="20" Text="{Binding PerksRentals}" />
              <Redbox:SimpleList Name="TextListElem" Grid.Row="3" ItemsHeight="50" Margin="0,30,0,0" Style="{StaticResource rubine_red_regular_list_center_style}" ItemsSource="{Binding PerksBullets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <BulletDecorator>
                      <BulletDecorator.Bullet>
                        <Ellipse Fill="{StaticResource RubineRedBrush}" StrokeThickness="0" Width="8" Height="8" Margin="0,2,0,0" />
                      </BulletDecorator.Bullet>
                      <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" Text="{Binding Mode=OneWay}" />
                    </BulletDecorator>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </Redbox:SimpleList>
            </Redbox:GridExt>
          </Grid>
        </Border>
        <Border Name="PromosContainerElem" Grid.Row="0" Grid.Column="1" Margin="0" Background="#FFFFFFFF" BorderThickness="0" Visibility="{Binding ElementName=PromosElem, Path=IsSelected, Converter={StaticResource BoolToVisibility}}">
          <Redbox:GridExt Margin="30" RowHeights="50,*">
            <TextBlock Grid.Row="0" Style="{StaticResource rubine_red_bold_center_center_style}" Text="{Binding PromoTitle}" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ContentControl ContentTemplate="{StaticResource PromotionTemplate}" Content="{Binding Promotions[0]}" />
              <ContentControl ContentTemplate="{StaticResource PromotionTemplate}" Content="{Binding Promotions[1]}" />
              <ContentControl ContentTemplate="{StaticResource PromotionTemplate}" Content="{Binding Promotions[2]}" />
            </StackPanel>
          </Redbox:GridExt>
        </Border>
        <Redbox:RoundedButton Name="CancelButtonElem" Grid.Row="1" Grid.Column="0" Margin="0,20,60,20" Height="56" CornerRadius="28" Style="{StaticResource style_rb_purple_white_border_button}" IsEnabled="True" Command="{Binding CancelButtonCommand}">
          <TextBlock Name="CancelButtonTextElem" Margin="30,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_25}" Text="{Binding CancelButtonText, FallbackValue=Back}" />
        </Redbox:RoundedButton>
      </Grid>
    </Border>
  </Redbox:GridExt>
</localViews:ViewUserControl>