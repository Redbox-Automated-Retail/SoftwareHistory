<?xml version="1.0" encoding="utf-8"?>
<localViews:ViewUserControl x:Class="Redbox.Rental.UI.Views.MemberPerksViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:localViews="clr-namespace:Redbox.Rental.UI.Views" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:system="clr-namespace:System;assembly=mscorlib" Focusable="False">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <localViews:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <localViews:ReverseBoolToVisibilityConverter x:Key="ReverseBoolToVisibility" />
      <localViews:IfElseConverter x:Key="IfElseConverter" />
      <system:Int32 x:Key="TopRow">0</system:Int32>
      <system:Int32 x:Key="BottomRow">2</system:Int32>
      <HorizontalAlignment x:Key="LeftAlign">Left</HorizontalAlignment>
      <HorizontalAlignment x:Key="CenterAlign">Center</HorizontalAlignment>
      <Thickness x:Key="BackButtonNormalMargin">50,0,0,30</Thickness>
      <Thickness x:Key="BackButtonAdaMargin">50,0,0,7</Thickness>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Redbox:GridExt Name="MainControl" Background="#FFFFFFFF" Width="1024" Height="768" RowHeights="auto,*,auto">
    <Grid Style="{StaticResource style_header_rubine_background_gradient}" Height="75">
      <Grid.Row>
        <MultiBinding Converter="{StaticResource IfElseConverter}">
          <Binding Path="IsAdaMode" />
          <Binding Source="{StaticResource BottomRow}" />
          <Binding Source="{StaticResource TopRow}" />
        </MultiBinding>
      </Grid.Row>
      <TextBlock Name="Title" Margin="50,14,50,0" Text="My Redbox" Height="auto" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_36}">
        <FrameworkElement.HorizontalAlignment>
          <MultiBinding Converter="{StaticResource IfElseConverter}">
            <Binding Path="IsAdaMode" />
            <Binding Source="{StaticResource CenterAlign}" />
            <Binding Source="{StaticResource LeftAlign}" />
          </MultiBinding>
        </FrameworkElement.HorizontalAlignment>
      </TextBlock>
    </Grid>
    <Grid Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <UniformGrid Name="TabButtons" Grid.Column="0" Columns="2">
        <Grid.Row>
          <MultiBinding Converter="{StaticResource IfElseConverter}">
            <Binding Path="IsAdaMode" />
            <Binding Source="{StaticResource BottomRow}" />
            <Binding Source="{StaticResource TopRow}" />
          </MultiBinding>
        </Grid.Row>
        <Grid Visibility="{Binding PerksButtonVisibility}">
          <Redbox:GroupButton Name="PerksElem" GroupName="Perks" Margin="0,2,2,2" Style="{StaticResource group_button_style}" Height="75" VerticalAlignment="Top" IsSelected="{Binding PerksSelected, Mode=TwoWay, FallbackValue=True}" Click="PerksButton_Pressed">
            <TextBlock Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_30}" Text="{Binding PerksButtonText, FallbackValue=My Perks}" />
          </Redbox:GroupButton>
          <Polygon Visibility="{Binding PerksSelected, Converter={StaticResource BoolToVisibility}}">
            <FrameworkElement.Style>
              <MultiBinding Converter="{StaticResource IfElseConverter}">
                <Binding Path="IsAdaMode" />
                <Binding Source="{StaticResource white_top_center_triangle}" />
                <Binding Source="{StaticResource white_bottom_center_triangle}" />
              </MultiBinding>
            </FrameworkElement.Style>
          </Polygon>
        </Grid>
        <Grid Visibility="{Binding PromoButtonVisibility}">
          <Redbox:GroupButton Name="PromosElem" GroupName="Perks" Margin="2,2,0,2" Style="{StaticResource group_button_style}" Height="75" VerticalAlignment="Top" IsSelected="{Binding PromosSelected, Mode=TwoWay, FallbackValue=False}" Click="PromosButton_Pressed">
            <TextBlock Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_30}" Text="{Binding PromosButtonText, FallbackValue=My Offers}" />
          </Redbox:GroupButton>
          <Polygon Visibility="{Binding PromosSelected, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
            <FrameworkElement.Style>
              <MultiBinding Converter="{StaticResource IfElseConverter}">
                <Binding Path="IsAdaMode" />
                <Binding Source="{StaticResource white_top_center_triangle}" />
                <Binding Source="{StaticResource white_bottom_center_triangle}" />
              </MultiBinding>
            </FrameworkElement.Style>
          </Polygon>
        </Grid>
      </UniformGrid>
      <Border Name="PerksContainerElem" Grid.Row="1" Margin="0,50,0,50" Height="425" Width="800" CornerRadius="20" Background="{StaticResource RubineToPurpleGradientBrush}" BorderThickness="0" Visibility="{Binding ElementName=PerksElem, Path=IsSelected, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="400" />
          </Grid.ColumnDefinitions>
          <Redbox:GridExt Column="0" Height="360" RowHeights="auto,*,80">
            <TextBlock Grid.Row="0" Margin="0,60,0,20" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_montserrat_48}" Foreground="#FFFFFFFF" Text="{Binding PerksLevel, FallbackValue=Member}" Visibility="{Binding PerksTitleVisibility, FallbackValue=Visible}" />
            <Grid Row="0" Height="140" Visibility="{Binding PerksImageVisibility, FallbackValue=Visible}">
              <Image HorizontalAlignment="Center" VerticalAlignment="Top" Height="106" Source="{Binding PerksImagePath, TargetNullValue={x:Null}}" />
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" Style="{StaticResource font_montserrat_regular_22}" Foreground="#FFFFFFFF" Visibility="{Binding PerksImageVisibility, FallbackValue=Collapsed}" Text="{Binding PerksLevel, FallbackValue=SUPERSTAR}" />
            </Grid>
            <TextBlock Grid.Row="1" Margin="40,30,40,20" TextAlignment="Center" Style="{StaticResource font_montserrat_regular_22}" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding Path=PerksLevelMessage, FallbackValue=Keep renting and purchasing to level up!}" />
            <Redbox:RoundedButton Name="MoreInfoButtonElem" Grid.Row="2" Grid.Column="0" Margin="20,0,20,10" VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="59" Width="200" CornerRadius="28" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" IsEnabled="True" Command="{Binding InfoButtonCommand}">
              <TextBlock Name="MoreInfoButtonTextElem" Margin="30,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_25}" Text="{Binding InfoButtonText, FallbackValue=More Info}" />
            </Redbox:RoundedButton>
          </Redbox:GridExt>
          <Border Grid.Column="1" BorderThickness="0" Background="#FFFFFFFF" Width="3" Height="340" VerticalAlignment="Center" />
          <Redbox:GridExt Column="2" RowHeights="auto,auto,auto,auto">
            <TextBlock Grid.Row="0" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_montserrat_48}" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding Path=SnapshotPoints, FallbackValue='12,350'}" />
            <TextBlock Grid.Row="1" Margin="0,10,0,10" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_montserrat_extralight_22}" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding Path=SnapshotPointsLabel, FallbackValue=POINTS}" />
            <TextBlock Grid.Row="2" Margin="20,20,20,20" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource font_montserrat_regular_22}" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding Path=EarnedRewardsMessage, FallbackValue=Youve earned a FREE 1-night DVD rental!}" />
            <TextBlock Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource font_montserrat_extralight_16}" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding Path=SnapshotExpire, FallbackValue='Use your points  (X,XXX expire on XX/XX/XX)'}" />
          </Redbox:GridExt>
        </Grid>
      </Border>
      <Border Name="PromosContainerElem" Grid.Row="1" Grid.Column="1" Margin="0" Background="#FFFFFFFF" BorderThickness="0" Visibility="{Binding ElementName=PromosElem, Path=IsSelected, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
        <Grid>
          <TextBlock Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource font_montserrat_semibold_26}" Foreground="{StaticResource WarmPurpleBrush}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding EmptyPromoListMessage, FallbackValue=Looking Pretty Empty In Here}" Visibility="{Binding IsEmptyPromoListMessageVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
          <Redbox:GridExt Margin="0" RowHeights="50,*" HorizontalAlignment="Center" Visibility="{Binding IsEmptyPromoListMessageVisible, Converter={StaticResource ReverseBoolToVisibility}, FallbackValue=Visible}">
            <TextBlock Grid.Row="0" Margin="0,15,0,5" Style="{StaticResource font_montserrat_semibold_26}" Foreground="{StaticResource WarmPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding PromoTitle, FallbackValue=Wowzers etc}" Visibility="{Binding ShowPromoListMessage, Converter={StaticResource ReverseBoolToVisibility}, FallbackValue=Collapsed}" />
            <TextBlock Grid.Row="0" Margin="0,15,0,5" Style="{StaticResource font_montserrat_semibold_26}" Foreground="{StaticResource RubineRedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding PromoListMessage, FallbackValue=Success-****BDAY is in your bag!}" Visibility="{Binding ShowPromoListMessage, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
            <Redbox:GridExt Row="1" RowHeights="Auto,*">
              <TextBlock Grid.Row="0" />
              <localControls:StoredPromoCodeListControl Grid.Row="1" Margin="0,0,0,-50" Height="485" VerticalAlignment="Top" PromoCodeModels="{Binding Path=StoredPromoCodes}" Visibility="{Binding Path=IsPromoCodeListVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}" IsAdaMode="{Binding IsAdaMode}" CurrentPageNumber="{Binding CurrentPageNumber, Mode=TwoWay}" CurrentPagePromos="{Binding CurrentPagePromos, Mode=OneWayToSource}" NextPageClickedCommand="{Binding NextPagePressedCommand}" PreviousPageClickedCommand="{Binding PreviousPagePressedCommand}" PageNumberClickedCommand="{Binding PageNumberPressedCommand}" CurrentPageCount="{Binding NumberOfPages, Mode=OneWayToSource}" ItemsPerPage="{Binding PromosPerPage, Mode=OneWay}" />
            </Redbox:GridExt>
          </Redbox:GridExt>
        </Grid>
      </Border>
    </Grid>
    <Redbox:RoundedButton Name="CancelButtonElem" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Height="59" Width="163" CornerRadius="28" IsEnabled="True" Command="{Binding CancelButtonCommand}">
      <FrameworkElement.Style>
        <MultiBinding Converter="{StaticResource IfElseConverter}">
          <Binding Path="IsAdaMode" FallbackValue="false" />
          <Binding Source="{StaticResource style_rb_purple_white_border_no_dropshadow_button}" />
          <Binding Source="{StaticResource style_rb_purple_white_border_button}" />
        </MultiBinding>
      </FrameworkElement.Style>
      <FrameworkElement.Margin>
        <MultiBinding Converter="{StaticResource IfElseConverter}">
          <Binding Path="IsAdaMode" />
          <Binding Source="{StaticResource BackButtonAdaMargin}" />
          <Binding Source="{StaticResource BackButtonNormalMargin}" />
        </MultiBinding>
      </FrameworkElement.Margin>
      <TextBlock Name="CancelButtonTextElem" Margin="30,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_25}" Text="{Binding CancelButtonText, FallbackValue=Back}" />
    </Redbox:RoundedButton>
  </Redbox:GridExt>
</localViews:ViewUserControl>