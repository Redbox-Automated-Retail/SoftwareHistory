<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.PerksSignUpInfoPopupViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <Grid>
    <Grid Name="BackgroundGrid" Background="{StaticResource PopupBackgroundBrush}" Opacity="0.89" />
    <Grid MinWidth="506" Width="Auto" Height="610" VerticalAlignment="Center" HorizontalAlignment="Center">
      <Border Background="#FFFFFFFF" CornerRadius="28" Width="Auto">
        <Grid Width="Auto">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="50,40,50,0">
            <TextBlock Name="TitleText" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0" Foreground="{StaticResource WarmPurpleBrush}" Style="{StaticResource font_museo_slab_700_36}" Text="{Binding Path=TitleText, FallbackValue=How it works}" />
            <TextBlock HorizontalAlignment="Left" Margin="0,40,0,10" Foreground="{StaticResource WarmPurpleBrush}" Style="{StaticResource font_museo_slab_900_22}" Text="{Binding EarnHeading, FallbackValue=Earn points}" />
            <DockPanel>
              <Redbox:GridExt RowHeights="*,*,*,*,*" DockPanel.Dock="Left">
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,6,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_medium_18}" Text="{Binding EarnOption1Desc, FallbackValue=Rent DVD:}" />
                <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_medium_18}" Text="{Binding EarnOption2Desc, FallbackValue=Rent Blu-ray:}" />
                <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_medium_18}" Text="{Binding EarnOption3Desc, FallbackValue=Rent 4K UHD:}" />
                <TextBlock Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_medium_18}" Text="{Binding EarnOption4Desc, FallbackValue=On Demand:}" />
              </Redbox:GridExt>
              <Redbox:GridExt RowHeights="*,*,*,*,*" DockPanel.Dock="Right">
                <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_semibold_18}" Text="{Binding EarnOption1Value, FallbackValue=100 pts/night}" />
                <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_semibold_18}" Text="{Binding EarnOption2Value, FallbackValue=125 pts/night}" />
                <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_semibold_18}" Text="{Binding EarnOption3Value, FallbackValue=150 pts/night}" />
                <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_semibold_18}" Text="{Binding EarnOption4Value, FallbackValue=125 pts/transaction}" />
              </Redbox:GridExt>
            </DockPanel>
            <Border Height="1" Background="#FF000000" Margin="0,24,0,0" />
            <TextBlock HorizontalAlignment="Left" Margin="0,24,0,10" Foreground="{StaticResource WarmPurpleBrush}" Style="{StaticResource font_museo_slab_900_22}" Text="{Binding UseHeading, FallbackValue=Use points}" />
            <DockPanel>
              <Redbox:GridExt RowHeights="*,*,*,*" DockPanel.Dock="Left">
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,6,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_medium_18}" Text="{Binding UseOption1Desc, FallbackValue=FREE 1-night DVD rental:}" />
                <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_medium_18}" Text="{Binding UseOption2Desc, FallbackValue=FREE 1-night Blu-ray rental:}" />
                <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_medium_18}" Text="{Binding UseOption3Desc, FallbackValue=FREE 4K UHD rental:}" />
              </Redbox:GridExt>
              <Redbox:GridExt RowHeights="*,*,*,*" DockPanel.Dock="Right">
                <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Margin="70,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_semibold_18}" Text="{Binding UseOption1Value, FallbackValue='1,500 pts'}" />
                <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="70,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_semibold_18}" Text="{Binding UseOption2Value, FallbackValue='1,750 pts'}" />
                <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Margin="70,10,0,0" Foreground="{StaticResource DarkGrayBrush}" Style="{StaticResource font_montserrat_semibold_18}" Text="{Binding UseOption3Value, FallbackValue='2,000 pts'}" />
              </Redbox:GridExt>
            </DockPanel>
          </StackPanel>
          <Border Grid.Row="1" Background="{StaticResource LightGrayBackgroundBrush}" CornerRadius="0,0,28,28">
            <Redbox:RoundedButton Name="CancelButtonElem" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Center" Height="56" Width="238" UsedDefaultCornerRadius="True" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" IsEnabled="True" Command="{Binding OKButtonCommand}">
              <TextBlock Name="CancelButtonTextElem" Margin="30,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_25}" Text="{Binding OKButtonText, FallbackValue=Okay}" />
            </Redbox:RoundedButton>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>