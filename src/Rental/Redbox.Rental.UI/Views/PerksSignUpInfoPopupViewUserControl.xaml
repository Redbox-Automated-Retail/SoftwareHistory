<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.PerksSignUpInfoPopupViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:controls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <Grid>
    <Grid Name="BackgroundGrid" Background="{StaticResource PopupBackgroundBrush}" Opacity="0.89" />
    <Grid Width="895" Height="682" VerticalAlignment="Center" HorizontalAlignment="Center">
      <Border Background="#FFFFFFFF" CornerRadius="28">
        <Grid Width="743">
          <Grid.RowDefinitions>
            <RowDefinition Height="577" />
            <RowDefinition Height="105" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,46,0,13">
            <TextBlock Name="TitleText" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_bold_28}" LineHeight="40" Text="{Binding Path=TitleText, FallbackValue=How Points Work}" />
            <TextBlock HorizontalAlignment="Left" Margin="0,16,0,4" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_bold_24}" LineHeight="28" Text="{Binding EarnHeading, FallbackValue=Earn Points}" />
            <DockPanel>
              <Redbox:GridExt RowHeights="*,*,*,*" DockPanel.Dock="Left">
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_medium_20}">
                  <TextBlock.Inlines>
                    <Run Text="{Binding EarnOption1Desc, FallbackValue=Rent DVD}" /> <Run Text="=" /> <Run Text="{Binding EarnOption1Value, FallbackValue=earn 125 points / night}" /></TextBlock.Inlines>
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_medium_20}">
                  <TextBlock.Inlines>
                    <Run Text="{Binding EarnOption2Desc, FallbackValue=Rent Blu-ray}" /> <Run Text="=" /> <Run Text="{Binding EarnOption2Value, FallbackValue=earn 125 points / night}" /></TextBlock.Inlines>
                </TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_medium_20}">
                  <TextBlock.Inlines>
                    <Run Text="{Binding EarnOption3Desc, FallbackValue=Buy Used Discs}" /> <Run Text="=" /> <Run Text="{Binding EarnOption3Value, FallbackValue=earn points / $1 spent}" /></TextBlock.Inlines>
                </TextBlock>
                <TextBlock Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_medium_20}">
                  <TextBlock.Inlines>
                    <Run Text="{Binding EarnOption4Desc, FallbackValue=On Demand}" /> <Run Text="=" /> <Run Text="{Binding EarnOption4Value, FallbackValue=earn 125+ points / transaction}" /></TextBlock.Inlines>
                </TextBlock>
              </Redbox:GridExt>
            </DockPanel>
            <TextBlock HorizontalAlignment="Left" Margin="0,29,0,4" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_bold_24}" LineHeight="28" Text="{Binding UseHeading, FallbackValue=Use Points}" />
            <DockPanel>
              <Redbox:GridExt RowHeights="*,*" DockPanel.Dock="Left">
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_medium_20}">
                  <TextBlock.Inlines>
                    <Run Text="{Binding UseOption1Desc, FallbackValue='1,500 points'}" /> <Run Text="=" /> <Run Text="{Binding UseOption1Value, FallbackValue=FREE 1-night DVD rental}" /></TextBlock.Inlines>
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_medium_20}">
                  <TextBlock.Inlines>
                    <Run Text="{Binding UseOption2Desc, FallbackValue='1,750 points'}" /> <Run Text="=" /> <Run Text="{Binding UseOption2Value, FallbackValue=FREE 1-night Blu-ray rental}" /></TextBlock.Inlines>
                </TextBlock>
              </Redbox:GridExt>
            </DockPanel>
            <TextBlock HorizontalAlignment="Left" Margin="0,22,0,84" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_bold_20}" LineHeight="20" Text="{Binding VisitHeading, FallbackValue=Visit redbox.com/perks for more ways to earn}" />
            <TextBlock HorizontalAlignment="Left" Margin="0,0,0,13" Foreground="{StaticResource CarlosPurple1Brush}" Style="{StaticResource font_montserrat_bold_24}" LineHeight="40" Text="{Binding BalanceHeading, FallbackValue=My Points Balance: 0 points}" />
          </StackPanel>
          <Border Grid.Row="1" VerticalAlignment="Top" Height="1" Background="{StaticResource CarlosPurple1Brush}" />
          <Redbox:RoundedButton Name="CancelButtonElem" Grid.Row="1" VerticalAlignment="Center" Style="{StaticResource button_light_large_secondary_style}" IsEnabled="True" HorizontalAlignment="{Binding OKButtonHorizontalAlignment, FallbackValue=Center}" Command="{Binding OKButtonCommand}">
            <TextBlock Name="CancelButtonTextElem" Style="{StaticResource button_text_large_style}" Text="{Binding OKButtonText, FallbackValue=OKAY}" />
          </Redbox:RoundedButton>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>