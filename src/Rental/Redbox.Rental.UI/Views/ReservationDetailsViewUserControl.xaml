<?xml version="1.0" encoding="utf-8"?>
<localControls:TextToSpeechUserControl x:Class="Redbox.Rental.UI.Views.ReservationDetailsViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localAnimations="clr-namespace:Redbox.Rental.UI.Controls.Animations">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.GeneralClickCommand}" Executed="OkayButtonCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Background="{StaticResource RubineRedBrush}">
    <localAnimations:RedChevronUserControl VerticalAlignment="Center" />
    <Border Background="#FFFFFFFF" CornerRadius="20" Margin="112,100" BorderBrush="#979797" BorderThickness="3">
      <Grid>
        <TextBlock Name="HeaderText" Style="{StaticResource font_montserrat_medium_30}" Foreground="{StaticResource WarmPurpleBrush}" Margin="70,55,0,0" Text="{Binding Path=HeaderText, FallbackValue=Reservation Details}" />
        <TextBlock Name="BodyText" Style="{StaticResource font_montserrat_medium_24}" Foreground="{StaticResource WarmPurpleBrush}" Margin="70,121,0,0" Text="{Binding Path=BodyText, FallbackValue=You have X discs reserved}" />
        <StackPanel Margin="60,214,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Visibility="{Binding Path=MDVVisibility}">
          <Viewbox Height="37">
            <UserControl Style="{StaticResource two_discs_icon}" />
          </Viewbox>
          <TextBlock Name="DiscVendText" Style="{StaticResource font_montserrat_bold_20}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0,0,0" Text="{Binding Path=DiscVendText, FallbackValue=2 DISC VEND}" />
        </StackPanel>
        <StackPanel Margin="70,272,70,0" Visibility="{Binding Path=MDVVisibility}">
          <TextBlock TextWrapping="Wrap">
            <Span Style="{StaticResource span_font_montserrat_bold_18}" Foreground="{StaticResource WarmPurpleBrush}">
              <Run Name="NoteHeaderText" Text="{Binding Path=NoteHeaderText, FallbackValue=Dont forget}" />
            </Span> <Span Style="{StaticResource span_font_montserrat_regular_18}" Foreground="{StaticResource WarmPurpleBrush}"><Run Name="NoteBodyText" Text="{Binding Path=NoteBodyText, FallbackValue=One of your picks has 2 discs! Be sure to grab them all before leaving.}" /></Span></TextBlock>
          <Grid Height="20" />
          <TextBlock Name="ReturnWarningText" Style="{StaticResource font_montserrat_regular_18}" Foreground="{StaticResource WarmPurpleBrush}" TextWrapping="Wrap" Text="{Binding Path=ReturnWarningText, FallbackValue=Your card will be charged the full nightly fee plus applicable taxes until all discs are returned. Please return them together.}" />
        </StackPanel>
        <Redbox:RoundedButton Name="OkayButton" Style="{StaticResource style_rb_purple_white_border_button}" UsedDefaultCornerRadius="True" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="60" Width="170" Margin="0,0,0,55" Command="{x:Static localbase:Commands.GeneralClickCommand}" Visibility="{Binding Path=OkayButtonVisibility, FallbackValue=Visible}">
          <TextBlock Name="OkayButtonText" Style="{StaticResource font_museo_slab_900_20}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,0,3,0" Text="{Binding Path=OkayButtonText, FallbackValue=Okay}" />
        </Redbox:RoundedButton>
      </Grid>
    </Border>
  </Grid>
</localControls:TextToSpeechUserControl>