<?xml version="1.0" encoding="utf-8"?>
<localControls:ViewUserControl x:Class="Redbox.Rental.UI.Views.PromptSignInUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Views" Focusable="False">
  <Grid Name="MainControl" Background="{StaticResource RubineRedGradientBrush}" Width="1024" Height="768">
    <Border BorderThickness="0" Margin="0,99">
      <UniformGrid Columns="2" Rows="1">
        <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#FFFFFFFF">
          <Redbox:GridExt HorizontalAlignment="Center" Width="auto" RowHeights="180,60,auto,40,auto,*">
            <TextBlock Grid.Row="0" Margin="30" Foreground="#FFFFFFFF" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_48}" Text="{Binding SignInLeftTitle, FallbackValue=Sign in to get some points}" />
            <Redbox:RoundedButton Name="PhoneButtonElem" Grid.Row="2" Grid.Column="1" UsedDefaultCornerRadius="True" Margin="40,0" MinHeight="78" Style="{StaticResource style_white_rubine_gradient_border_button}" Height="auto" Command="{Binding PhonePinButtonCommand}">
              <TextBlock Name="PhoneButtonTextElem" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_28}" TextAlignment="Center" TextWrapping="Wrap" Margin="40,20" Text="{Binding PhonePinButtonText, FallbackValue=Phone &amp; 4-Digit PIN}" />
            </Redbox:RoundedButton>
            <Redbox:RoundedButton Name="EmailButtonElem" Grid.Row="4" Grid.Column="1" UsedDefaultCornerRadius="True" Margin="40,0" MinHeight="78" Style="{StaticResource style_white_rubine_gradient_border_button}" Height="auto" Command="{Binding EmailCodeButtonCommand}">
              <TextBlock Name="EmailButtonTextElem" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_28}" TextAlignment="Center" TextWrapping="Wrap" Margin="40,20" Text="{Binding EmailCodeButtonText, FallbackValue=Email &amp; Password}" />
            </Redbox:RoundedButton>
          </Redbox:GridExt>
        </Border>
        <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#FFFFFFFF">
          <Redbox:GridExt HorizontalAlignment="Center" RowHeights="180,130,auto,*">
            <TextBlock Grid.Row="0" Margin="30" Foreground="#FFFFFFFF" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_48}" Text="{Binding SignInRightTitle, FallbackValue=Skip ahead to start browsing}" />
            <TextBlock Grid.Row="1" Margin="30,0" Width="360" Foreground="#FFFFFFFF" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="top" Style="{StaticResource font_montserrat_regular_30}" Text="{Binding SignInMessage, FallbackValue=(You can always create an account online)}" />
            <Redbox:RoundedButton Name="ContinueButtonElem" Grid.Row="2" Grid.Column="1" UsedDefaultCornerRadius="True" Margin="40,0" MinHeight="78" Style="{StaticResource style_white_rubine_gradient_border_button}" Height="auto" Command="{Binding ContinueButtonCommand}">
              <TextBlock Name="ContinueButtonTextElem" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource font_museo_slab_900_28}" TextAlignment="Center" TextWrapping="Wrap" Margin="40,20" Text="{Binding ContinueButtonText, FallbackValue=Continue As Guest}" />
            </Redbox:RoundedButton>
          </Redbox:GridExt>
        </Border>
      </UniformGrid>
    </Border>
  </Grid>
</localControls:ViewUserControl>