  <Style x:Key="glass_rounded_button_style" TargetType="{x:Type localControls:RoundedButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type localControls:RoundedButton}">
          <Grid>
            <Border Name="InnerBorder" CornerRadius="{Binding Path=CornerRadius, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.Background>
                <LinearGradientBrush EndPoint="{Binding Path=BorderGradientEndPoint, RelativeSource={RelativeSource TemplatedParent}}" StartPoint="{Binding Path=BorderGradientStartPoint, RelativeSource={RelativeSource TemplatedParent}}">
                  <GradientStop Offset="0" Color="{Binding Path=BorderGradientColor, RelativeSource={RelativeSource TemplatedParent}}" />
                  <GradientStop Offset="1" Color="{Binding Path=BorderColor, RelativeSource={RelativeSource TemplatedParent}}" />
                </LinearGradientBrush>
              </Border.Background>
              <UIElement.Effect>
                <DropShadowEffect Color="#606060" Direction="-50" ShadowDepth="5" Opacity="{Binding Path=DropShadowOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
              </UIElement.Effect>
              <Border Name="InnerSubBorder" CornerRadius="{Binding Path=CornerRadiusInner, RelativeSource={RelativeSource TemplatedParent}}" Margin="{Binding Path=BorderThickness, RelativeSource={RelativeSource TemplatedParent}}">
                <Border.Background>
                  <LinearGradientBrush EndPoint="{Binding Path=BackgroundGradientEndPoint, RelativeSource={RelativeSource TemplatedParent}}" StartPoint="{Binding Path=BackgroundGradientStartPoint, RelativeSource={RelativeSource TemplatedParent}}">
                    <GradientStop Offset="0" Color="{Binding Path=BackgroundGradientColor, RelativeSource={RelativeSource TemplatedParent}}" />
                    <GradientStop Offset="1" Color="{Binding Path=BackgroundColor, RelativeSource={RelativeSource TemplatedParent}}" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Border>
            <Border Name="GlassHighlight" Opacity=".5" Margin="0,5,0,20" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="{Binding Path=GlassHighlightCornerRadius, RelativeSource={RelativeSource TemplatedParent}}" Height="{Binding Path=GlassHighlightHeight, RelativeSource={RelativeSource TemplatedParent}}" Width="{Binding Path=GlassHighlightWidth, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding Path=GlassHighlightVisibility, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                  <GradientStop Color="White" Offset="0" />
                  <GradientStop Offset="1" Color="{Binding Path=BackgroundGradientColor, RelativeSource={RelativeSource TemplatedParent}}" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="base_disabled_glass_rounded_button_style" TargetType="{x:Type localControls:RoundedButton}" BasedOn="{StaticResource glass_rounded_button_style}">
