  <Style x:Key="gray_button_style" TargetType="{x:Type Border}">
    <Setter Property="Margin" Value="150,580,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="BorderBrush" Value="#FFFFFFFF" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Border.CornerRadius" Value="17" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Border.Padding" Value="10,0,10,0" />
    <Setter Property="Margin" Value="10,10,10,10" />
    <Setter Property="MinWidth" Value="110" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
          <GradientStop Color="#6F6F6F" Offset="0" />
          <GradientStop Color="#464646" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0.5,0.5" StartPoint="0.5,0">
              <GradientStop Color="#7F7F7F" Offset="0" />
              <GradientStop Color="#FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
          <Setter.Value>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#262626" Offset="0.1" />
              <GradientStop Color="#FFFFFF" Offset="0.6" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="gray_button_text_style" BasedOn="{StaticResource font_akzidenz_regular_smaller}" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="#FF000000" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>