    <TextBlock Name="TitleTextBlock" TextWrapping="Wrap" Style="{StaticResource font_montserrat_bold_40}" LineHeight="56" Foreground="#FFFFFFFF" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="476" Margin="88,0,0,0" Text="{Binding TitleText, FallbackValue=Please remove&#xA;your card}" />
  </Grid>
</UserControl>