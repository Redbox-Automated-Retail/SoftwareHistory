<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.TitleDetailDisplayProductWithMoreLikeThisUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:wpf="http://schemas.microsoft.com/netfx/2009/xaml/presentation">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BitmapImage x:Key="DefaultImage" UriSource="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/movie-missing-image.png" />
      <Style x:Key="SecondLineTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_montserrat_medium_20}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Line2Text}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Redbox:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.InputBindings>
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Static localbase:Commands.StatisticsPopupCommand}" />
  </UIElement.InputBindings>
  <Grid Background="#00FFFFFF">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{Binding Path=BoxArtGridWidth, FallbackValue=512}" />
          <ColumnDefinition Width="{Binding Path=DetailsGridWidth, FallbackValue=512}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition MinHeight="0" MaxHeight="98" Height="{Binding AdHeight}" />
          <RowDefinition MinHeight="530" MaxHeight="628" Height="{Binding MainHeight}" />
          <RowDefinition Height="140" />
        </Grid.RowDefinitions>
        <Grid Name="AdBanner" Row="0" ColumnSpan="2">
          <Border Width="1024" Height="98" Background="#060208" Visibility="{Binding AdImageVisibility, FallbackValue=Collapsed}" />
          <Image Name="AdImage" Height="90" Width="728" Source="{Binding AdImage}" Visibility="{Binding AdImageVisibility, FallbackValue=Collapsed}" />
        </Grid>
        <Grid Column="0" Row="1" Background="#FFFFFFFF">
          <Grid Margin="66,35,0,0">
            <Grid Margin="{Binding FlagMargin, FallbackValue=0}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="{Binding Path=RedboxPlusInfoADAGridHeight, FallbackValue=0}" />
                </Grid.RowDefinitions>
                <localControls:DisplayProductUserControl Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" ClipToBounds="False" />
                <Redbox:RoundedButton Name="RedboxPlusInfoADAButton" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Style="{StaticResource transparent_button_style}" Command="{x:Static localbase:Commands.RedboxPlusInfoCommand}" Visibility="{Binding Path=RedboxPlusInfoADAVisibility, FallbackValue=Collapsed}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Name="RedboxPlusInfoADAText" Style="{StaticResource font_montserrat_bold_18}" Foreground="#481B54" VerticalAlignment="Center" Text="{Binding Path=RedboxPlusInfoText, FallbackValue=This is a Redbox+ movie!}" />
                    <Image Name="RedboxPlusInfoADAImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/information.png" Width="28" Height="28" Margin="9,0,0,0" />
                  </StackPanel>
                </Redbox:RoundedButton>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
        <Grid Column="1" Row="1" Background="#FFFFFFFF">
          <DockPanel LastChildFill="True" Margin="0,35,101,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
              <Border Height="16" Padding="0,0,12,0" Margin="0,0,12,0" BorderBrush="#060208" BorderThickness="{Binding RatingBorderThickness, FallbackValue='0,0,1,0'}" Visibility="{Binding RatingVisibility, FallbackValue=Visible}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_semibold_12}" Foreground="#060208" Text="{Binding Rating}" />
              </Border>
              <Border Height="16" Padding="0,0,12,0" Margin="0,0,12,0" BorderBrush="#060208" BorderThickness="{Binding RunningTimeBorderThickness, FallbackValue='0,0,1,0'}" Visibility="{Binding RunningTimeVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_semibold_12}" Foreground="#060208" Text="{Binding RunningTime}" />
              </Border>
              <Border Height="16" Padding="0,0,12,0" Margin="0,0,12,0" BorderBrush="#060208" BorderThickness="{Binding ReleaseYearBorderThickness, FallbackValue='0,0,1,0'}" Visibility="{Binding ReleaseYearVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_semibold_12}" Foreground="#060208" Text="{Binding ReleaseYear}" />
              </Border>
              <Border Height="16" Padding="0,0,12,0" Margin="0,0,12,0" Visibility="{Binding CCSupported, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_semibold_12}" Foreground="#060208" Text="CC" />
              </Border>
              <Border Height="16" Padding="0,0,12,0" Margin="-12,0,0,0" BorderThickness="1,0,0,0" BorderBrush="#060208" Visibility="{Binding Path=RedboxPlusInfoVisibility, FallbackValue=Collapsed}" />
              <Redbox:RoundedButton Name="RedboxPlusInfoButton" Margin="0,0,0,-3" Style="{StaticResource transparent_button_style}" Command="{x:Static localbase:Commands.RedboxPlusInfoCommand}" Visibility="{Binding Path=RedboxPlusInfoVisibility, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Name="RedboxPlusInfoText" Style="{StaticResource font_montserrat_bold_16}" LineHeight="24" Foreground="#481B54" VerticalAlignment="Center" Text="{Binding Path=RedboxPlusInfoText, FallbackValue=This is a Redbox+ movie!}" />
                  <Image Name="RedboxPlusInfoImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/information.png" Width="28" Height="28" Margin="9,-3,0,0" />
                </StackPanel>
              </Redbox:RoundedButton>
            </StackPanel>
            <TextBlock Style="{StaticResource font_montserrat_semibold_32}" DockPanel.Dock="Top" Margin="0,6,0,6" Foreground="#060208" LineHeight="40" MaxHeight="80" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding Header, FallbackValue=HEADER}" />
            <TextBlock Style="{StaticResource font_montserrat_medium_16}" DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="#060208" LineHeight="24" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="{Binding Path=DescriptionMaxHeight, FallbackValue=144}" Text="{Binding Description, FallbackValue=DESCRIPTION}" />
            <StackPanel Name="ProductDetails" DockPanel.Dock="Top" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Name="starring" Margin="0,0,0,4" Style="{StaticResource font_montserrat_regular_14}" LineHeight="20" MaxHeight="20" Foreground="#060208" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Visibility="{Binding StarringVisibility, FallbackValue=Visible}">
                    <TextBlock.Inlines>
                      <Run FontWeight="Bold" Text="{Binding StarringLabel, FallbackValue=Starring:}" /> <Run FontWeight="Medium" Text="{Binding Starring}" /></TextBlock.Inlines>
                  </TextBlock>
                  <Redbox:RoundedButton Name="see_full_details_button" Style="{StaticResource transparent_button_style}" HorizontalAlignment="Left" Command="{x:Static localbase:Commands.SeeFullDetailsCommand}" Focusable="False">
                    <TextBlock Margin="0,0,16,4" Style="{StaticResource font_montserrat_extrabold_14}" Foreground="#E42045" LineHeight="20" TextDecorations="Underline" Text="{Binding Path=SeeFullDetailsText, FallbackValue=SEE FULL DETAILS}" />
                  </Redbox:RoundedButton>
                  <TextBlock Style="{StaticResource font_montserrat_semibold_20}" Foreground="#060208" LineHeight="28" Text="{Binding GenresLabel, FallbackValue=Genres}" />
                  <TextBlock Style="{StaticResource font_montserrat_medium_14}" Foreground="#060208" LineHeight="20" MaxHeight="20" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding Genres, FallbackValue=ACTION}" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
            <StackPanel Name="ProductDetails2" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                  <TextBlock Style="{StaticResource font_montserrat_semibold_20}" Foreground="#060208" LineHeight="28" TextWrapping="NoWrap" Text="{Binding Path=MoreLikeThisText, FallbackValue=More Like This}" Visibility="{Binding MoreLikeThisVisibility, FallbackValue=Collapsed}" />
                  <StackPanel Orientation="Horizontal" Margin="0,8,-66,16" Visibility="{Binding MoreLikeThisVisibility, FallbackValue=Collapsed}">
                    <localControls:DisplayProductMoreLikeThisUserControl x:Name="DisplayProductMoreLikeThis1" Height="130" Width="87" Margin="0,0,20,0" DataContext="{Binding Path=DisplayProductMoreLikeThis1}" />
                    <localControls:DisplayProductMoreLikeThisUserControl x:Name="DisplayProductMoreLikeThis2" Height="130" Width="87" Margin="0,0,20,0" DataContext="{Binding Path=DisplayProductMoreLikeThis2}" />
                    <localControls:DisplayProductMoreLikeThisUserControl x:Name="DisplayProductMoreLikeThis3" Height="130" Width="87" Margin="0,0,20,0" DataContext="{Binding Path=DisplayProductMoreLikeThis3}" />
                    <localControls:DisplayProductMoreLikeThisUserControl x:Name="DisplayProductMoreLikeThis4" Height="130" Width="87" Margin="0,0,20,0" DataContext="{Binding Path=DisplayProductMoreLikeThis4}" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource font_montserrat_medium_12}" Foreground="#060208" LineHeight="16" TextWrapping="Wrap" Text="{Binding OneNightReturnTimeWithText, FallbackValue=9PM}" />
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </DockPanel>
        </Grid>
        <Grid Name="Buttons" ColumnSpan="2" Row="3" Margin="0,0,0,-34" Height="104" Background="#EBEBEB">
          <DockPanel>
            <StackPanel Name="leftButtons" Orientation="Horizontal" DockPanel.Dock="Left" Margin="24,0,0,0">
              <Redbox:RoundedButton Name="go_back_button" Style="{StaticResource thin_border_button_style}" Height="56" Width="118" CornerRadius="28" Command="{x:Static localbase:Commands.GoBackCommand}" Focusable="False">
                <TextBlock Style="{StaticResource font_montserrat_extrabold_20}" Text="{Binding Path=DataContext.BackText, FallbackValue=BACK, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TitleDetailsUserControl}}}" />
              </Redbox:RoundedButton>
            </StackPanel>
            <StackPanel Name="rightButtons" Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="RightToLeft" Margin="0,0,24,0" Visibility="{Binding AddButtonBarVisibility, FallbackValue=Collapsed}">
              <Redbox:RoundedButton Name="buy_button" Style="{StaticResource rubine_no_border_button_style}" Margin="0,0,16,0" Height="56" Width="180" CornerRadius="28" Command="{x:Static localbase:Commands.BuyCommand}" Focusable="False" Visibility="{Binding ShowBuy, FallbackValue=Visible}">
                <StackPanel Orientation="Vertical" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Center" Style="{Binding BuyButtonBuyTextStyle, FallbackValue={StaticResource font_montserrat_extrabold_16}}" Text="{Binding BuyText, FallbackValue=BUY IT}" />
                  <TextBlock TextAlignment="Center" Style="{Binding BuyButtonBuyPriceTextStyle, FallbackValue={StaticResource font_montserrat_medium_20}}" Text="{Binding BuyPriceText, FallbackValue=$$$}" />
                </StackPanel>
              </Redbox:RoundedButton>
              <ItemsControl Name="FormatButtonsItemsControl" ItemsSource="{Binding ButtonData}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Redbox:RoundedButton Width="Auto" MinWidth="180" Height="56" HorizontalAlignment="Right" Margin="16,0,0,0" CornerRadius="28" Style="{StaticResource warm_purple_no_border_button_style}" Command="{x:Static localbase:Commands.PrimaryCommand}" CommandParameter="rent" Visibility="Visible" FlowDirection="LeftToRight" Tag="{Binding Format}" IsEnabled="{Binding IsEnabled}">
                      <StackPanel Orientation="Vertical" Margin="10,5,10,5">
                        <TextBlock Style="{StaticResource font_montserrat_extrabold_16}" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding Line1Text}" />
                        <TextBlock Style="{StaticResource SecondLineTextStyle}" HorizontalAlignment="Center" Text="{Binding Line2Text}" />
                      </StackPanel>
                    </Redbox:RoundedButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Name="comingSoonButtons" Orientation="Vertical" DockPanel.Dock="Right" FlowDirection="RightToLeft" Margin="0,5,24,0" Visibility="{Binding ComingSoonVisibility, FallbackValue=Collapsed}">
              <TextBlock Name="comingSoonDateText" Style="{StaticResource font_montserrat_medium_16}" HorizontalAlignment="Center" Foreground="#AC2C32" Text="{Binding ComingSoonLabelText, FallbackValue=Coming}" />
              <Redbox:RoundedButton Name="coming_soon_email_me" Style="{StaticResource classic_rubine_button_style}" Height="56" Width="180" CornerRadius="28" Command="{x:Static localbase:Commands.MoreInfoCommand}" Focusable="False">
                <TextBlock Style="{StaticResource font_montserrat_medium_20}" TextAlignment="Center" Text="{Binding ComingSoonButtonText, FallbackValue=Email me}" />
              </Redbox:RoundedButton>
            </StackPanel>
            <Grid Name="outOfStock" DockPanel.Dock="Right" Width="708" Margin="0,0,24,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding OutOfStockVisibility, FallbackValue=Visible}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Name="OutOfStockLine1" Grid.Row="0" TextAlignment="Right" LineHeight="28" Style="{StaticResource font_montserrat_semibold_20}" Foreground="#E42045" TextWrapping="Wrap" Text="{Binding OutOfStockLine1Text, FallbackValue=Out of Stock}" />
              <TextBlock Name="OutOfStockLines2_3" Grid.Row="1" TextAlignment="Right" LineHeight="24" Style="{StaticResource font_montserrat_regular_16}" Foreground="#060208" TextWrapping="Wrap">
                <TextBlock.Inlines>
                  <Run FontWeight="Bold" Text="{Binding OutOfStockLine2Text, FallbackValue=Text LOCATE to 727272}" /> <Run Text="{Binding OutOfStockLine3Text, FallbackValue=to find other Boxes nearby that might have this movie}" /></TextBlock.Inlines>
              </TextBlock>
              <TextBlock Name="OutOfStockLine4" Grid.Row="2" TextAlignment="Right" LineHeight="16" Style="{StaticResource font_montserrat_medium_12}" Foreground="#060208" TextWrapping="Wrap" Text="{Binding OutOfStockLine4Text, FallbackValue=You will get up to 2 messages. Msg. &amp; data rates may apply.}" />
            </Grid>
          </DockPanel>
        </Grid>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>