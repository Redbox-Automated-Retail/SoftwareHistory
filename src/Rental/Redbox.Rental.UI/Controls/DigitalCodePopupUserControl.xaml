<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.DigitalCodePopupUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.08*" />
      <ColumnDefinition Width="0.92*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Ellipse Grid.Column="0" Grid.Row="0" Width="43" Height="43" StrokeThickness="4" Stroke="#B5121B" HorizontalAlignment="Left" />
    <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource font_target_small_overlays}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0" Text="1" />
    <Ellipse Grid.Column="0" Grid.Row="1" Width="43" Height="43" StrokeThickness="4" Stroke="#B5121B" HorizontalAlignment="Left" />
    <TextBlock Grid.Column="0" Grid.Row="1" Style="{StaticResource font_target_small_overlays}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,3" Text="2" />
    <Ellipse Grid.Column="0" Grid.Row="2" Width="43" Height="43" StrokeThickness="4" Stroke="#B5121B" HorizontalAlignment="Left" />
    <TextBlock Grid.Column="0" Grid.Row="2" Style="{StaticResource font_target_small_overlays}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0" Text="3" />
    <TextBlock Grid.Column="1" Grid.Row="0" Foreground="#676565" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource font_target_smaller_overlays}" Text="{Binding Path=MessageLine1}" />
    <TextBlock Grid.Column="1" Grid.Row="1" Foreground="#676565" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource font_target_smaller_overlays}" Text="{Binding Path=MessageLine2}" />
    <TextBlock Grid.Column="1" Grid.Row="2" Foreground="#676565" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource font_target_smaller_overlays}" Text="{Binding Path=MessageLine3}" />
  </Grid>
</UserControl>