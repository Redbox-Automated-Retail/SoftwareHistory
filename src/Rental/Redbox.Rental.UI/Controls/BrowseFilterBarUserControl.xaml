<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.BrowseFilterBarUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" DataContextChanged="UserControl_DataContextChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.StartOverCommand}" Executed="StartOverCommandBinding_Executed" CanExecute="StartOverCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.BrowseFilterCommand}" Executed="BrowseFilterCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.GoBackCommand}" Executed="GoBackCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.MoreCollectionsCommand}" Executed="MoreCollectionsCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Background="#D8D8D8" Height="59">
    <DockPanel LastChildFill="True">
      <local:RoundedButton x:Name="startover_button" Command="{x:Static localbase:Commands.StartOverCommand}" HorizontalAlignment="Left" Margin="8,0" Focusable="False" Style="{Binding Path=StartOverButtonStyle, FallbackValue={StaticResource english_start_over_button_style}}" Visibility="{Binding Path=StartOverButtonVisibility, FallbackValue=Visible}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Image Name="StartOverArrow" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/startOverArrow.png" Width="15" Margin="5" />
          <TextBlock Style="{StaticResource font_target_smaller}" VerticalAlignment="Center" TextWrapping="Wrap" Width="80" TextAlignment="Center" Text="{Binding Path=StartOverButtonText, FallbackValue=Start Over}" />
        </StackPanel>
      </local:RoundedButton>
      <local:RoundedButton x:Name="BackButton" Style="{StaticResource start_over_button_style}" Height="36" Command="{x:Static localbase:Commands.GoBackCommand}" HorizontalAlignment="Left" Margin="8,0" Visibility="{Binding Path=BackButtonVisibility, FallbackValue=Collapsed}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,5,0">
          <Image Width="15" Margin="5,0,0,0" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/startoverarrow.png" />
          <TextBlock Style="{StaticResource font_target_smaller}" VerticalAlignment="Center" Width="50" TextAlignment="Center" Text="{Binding Path=BackButtonText, FallbackValue=BACK}" />
        </StackPanel>
      </local:RoundedButton>
      <local:RoundedButton x:Name="MoreCollectionsButton" Style="{StaticResource rubine_white_border_button_style}" Command="{x:Static localbase:Commands.MoreCollectionsCommand}" Height="36" Width="200" Margin="8,0,8,0" DockPanel.Dock="Right" Visibility="{Binding Path=MoreCollectionsButtonVisibility, FallbackValue=Collapsed}">
        <TextBlock Name="MoreCollectionsButtonText" Style="{StaticResource font_target_smaller}" Text="{Binding Path=MoreCollectionsButtonText, FallbackValue=More Collections}" />
      </local:RoundedButton>
      <TextBlock Name="FilterBarText" Margin="0,10,0,10" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Style="{StaticResource font_montserrat_regular_14}" Text="{Binding Path=FilterBarText, FallbackValue=Filter Bar Text Goes here...}" Visibility="{Binding Path=FilterBarTextVisibility, FallbackValue=Collapsed}" />
      <StackPanel Name="FilterButtonContainer" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center" />
    </DockPanel>
  </Grid>
</UserControl>