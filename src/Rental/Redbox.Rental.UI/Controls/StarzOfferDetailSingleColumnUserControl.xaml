<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.StarzOfferDetailSingleColumnUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls">
  <Grid>
    <StackPanel Orientation="Vertical" Margin="0,56,0,0">
      <Image Name="RedboxAndStarzLogos" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/redbox_and_starz_logos.png" Width="276" Height="31" VerticalAlignment="Top" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
        <TextBlock Name="TitleText" Style="{StaticResource font_montserrat_bold_40}" Foreground="#FFFFFFFF" Text="{Binding TitleText, FallbackValue=1 Month FREE Trial of STARZ}" />
        <TextBlock Name="TitleClause2Text" Style="{StaticResource font_montserrat_bold_12}" Foreground="#FFFFFFFF" Margin="0,7,0,0" Text="{Binding TitleClause2Text, FallbackValue=®}" />
        <TextBlock Name="TitleClause3Text" Style="{StaticResource font_montserrat_bold_40}" Foreground="#FFFFFFFF" Text="{Binding TitleClause3Text}" />
      </StackPanel>
      <StackPanel Name="SubtitleStackPanel" Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Name="SubtitleText" Style="{StaticResource font_montserrat_semibold_36}" Foreground="#fdba4d" Margin="0,12,0,0" Text="{Binding SubtitleText, FallbackValue=+3 FREE Redbox 1-Night Disc Rentals}" />
        <TextBlock Name="SubtitleAsteriskText" Style="{StaticResource font_montserrat_medium_16}" Foreground="#fdba4d" Margin="0,16,0,0" Text="{Binding SubtitleAsteriskText, FallbackValue=*}" />
        <TextBlock Name="SubtitleClause2Text" Style="{StaticResource font_montserrat_medium_16}" Foreground="#fdba4d" VerticalAlignment="Center" Margin="10,12,0,0" Text="{Binding SubtitleClause2Text, FallbackValue=| 3/Month}" />
      </StackPanel>
      <TextBlock Name="Subtitle2Text" Style="{StaticResource font_montserrat_medium_24}" Foreground="#FFFFFFFF" Margin="0,8,20,0" HorizontalAlignment="Center" Text="{Binding Subtitle2Text, FallbackValue=Includes 7-day FREE STARZ Trial}" Visibility="{Binding Subtitle2Visibility, FallbackValue=Collapsed}" />
      <TextBlock Name="FirstTimeSubscriberWarningText" Style="{StaticResource font_montserrat_semibold_14}" Foreground="#FFFFFFFF" Margin="0,8,20,0" HorizontalAlignment="Center" Text="{Binding FirstTimeSubscriberWarning, FallbackValue=Available only to our first-time STARZ subscribers}" />
      <StackPanel Name="BulletPointsStackPanel" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,0">
        <StackPanel Name="Bullet1StackPanel" Orientation="Horizontal">
          <TextBlock Name="BulletPoint1Text" Style="{StaticResource font_montserrat_medium_16}" Text="•" Foreground="#FFFFFFFF" Margin="0,28,20,0" />
          <TextBlock Name="Bullet1Text" Style="{StaticResource font_montserrat_medium_16}" Foreground="#FFFFFFFF" Margin="0,28,0,0">
            <TextBlock.Inlines>
              <Run Text="{Binding Bullet1Text1, FallbackValue=Watch Obsessable}" />
              <Run BaselineAlignment="Superscript" FontSize="10" Text="{Binding RegisteredTrademarkSymbol, FallbackValue=®}" />
              <Run Text="{Binding Bullet1Text2, FallbackValue= originals and thousands &#xA; of movies on the STARZ app or starz.com}" />
            </TextBlock.Inlines>
          </TextBlock>
        </StackPanel>
        <StackPanel Name="Bullet2StackPanel" Orientation="Horizontal">
          <TextBlock Name="BulletPoint2Text" Style="{StaticResource font_montserrat_medium_16}" Text="•" Foreground="#FFFFFFFF" Margin="0,18,20,0" />
          <TextBlock Name="Bullet2Text" Style="{StaticResource font_montserrat_medium_16}" Foreground="#FFFFFFFF" Margin="0,18,0,0" Text="{Binding Bullet2Text, FallbackValue=No commitment – cancel anytime}" />
        </StackPanel>
        <StackPanel Name="Bullet3StackPanel" Orientation="Horizontal">
          <TextBlock Name="BulletPoint3Text" Style="{StaticResource font_montserrat_medium_16}" Text="•" Foreground="#FFFFFFFF" Margin="0,18,20,0" />
          <TextBlock Name="Bullet3Text" Style="{StaticResource font_montserrat_medium_16}" Foreground="#FFFFFFFF" Margin="0,18,0,0" Text="{Binding Bullet3Text, FallbackValue=After 1st month $8.99/month + 2 FREE Redbox&#xA;1-night disc rentals/month for the next 12 months*}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>