<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.BrowseUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localui="clr-namespace:Redbox.Rental.UI" DataContextChanged="UserControl_DataContextChanged" SizeChanged="UserControl_SizeChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localui:Commands.PageLeftCommand}" Executed="PageLeftCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localui:Commands.PageRightCommand}" Executed="PageRightCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localui:Commands.BrowseItemAddCommand}" Executed="BrowseItemAddCommandBinding_Executed" CanExecute="BrowseItemAddCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localui:Commands.BrowseItemCancelCommand}" Executed="BrowseItemCancelCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localui:Commands.BrowseItemSelectedCommand}" Executed="BrowseItemSelectedCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Name="BorderShadows" Opacity="0.5" HorizontalAlignment="Left" Width="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type local:BrowseUserControl}}}" Visibility="{Binding Path=BorderShadowVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:BrowseUserControl}}}">
      <Panel.Background>
        <LinearGradientBrush StartPoint="0, 0.5" EndPoint="1,0.5">
          <GradientStop Color="Black" Offset="0" />
          <GradientStop Color="Transparent" Offset="0.2" />
          <GradientStop Color="Transparent" Offset="0.8" />
          <GradientStop Color="Black" Offset="1" />
        </LinearGradientBrush>
      </Panel.Background>
    </Grid>
    <TextBlock Name="PageNumberText" Style="{StaticResource font_montserrat_bold_16}" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#3C3939" TextAlignment="Center" Visibility="{Binding Path=PageNumberVisibility}">Page #</TextBlock>
    <Grid Width="3072" HorizontalAlignment="Center">
      <StackPanel Name="BrowsePagesStackPanel" Orientation="Horizontal" HorizontalAlignment="Center">
        <Grid Name="PriorPageGrid" Width="{Binding Path=PageGridWidth, RelativeSource={RelativeSource AncestorType={x:Type local:BrowseUserControl}}}" />
        <Grid Name="CurrentPageGrid" Width="{Binding Path=PageGridWidth, RelativeSource={RelativeSource AncestorType={x:Type local:BrowseUserControl}}}" />
        <Grid Name="NextPageGrid" Width="{Binding Path=PageGridWidth, RelativeSource={RelativeSource AncestorType={x:Type local:BrowseUserControl}}}" />
      </StackPanel>
    </Grid>
    <Redbox:RoundedButton Name="LeftPaddleButton" Style="{StaticResource left_paddle_button_style}" Command="{x:Static localui:Commands.PageLeftCommand}" Width="54" Height="306" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5" IsClickBeforeAnimation="True" Visibility="{Binding Path=PaddleVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:BrowseUserControl}}}" />
    <Redbox:RoundedButton Name="RightPaddleButton" Style="{StaticResource right_paddle_button_style}" Command="{x:Static localui:Commands.PageRightCommand}" Width="54" Height="306" HorizontalAlignment="Right" Margin="0,0,0,0" RenderTransformOrigin="1,0.5" IsClickBeforeAnimation="True" Visibility="{Binding Path=PaddleVisibility, RelativeSource={RelativeSource AncestorType={x:Type local:BrowseUserControl}}}" />
    <Grid Name="NoResultsGrid" Visibility="Collapsed">
      <StackPanel Name="NoResultsPanel" Orientation="Vertical" VerticalAlignment="Center">
        <Rectangle Height="20">
          <Shape.Fill>
            <LinearGradientBrush Opacity="0.5" StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="Transparent" Offset="0" />
              <GradientStop Color="Black" Offset="1.0" />
            </LinearGradientBrush>
          </Shape.Fill>
        </Rectangle>
        <TextBlock Name="NoResultsText" TextAlignment="Center" VerticalAlignment="Center" Style="{StaticResource no_browse_results}" Text="{Binding Path=NoResultsText, FallbackValue=Sorry nothing matches that search.}" />
        <Rectangle Height="20">
          <Shape.Fill>
            <LinearGradientBrush Opacity="0.8" StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="Black" Offset="0" />
              <GradientStop Color="Transparent" Offset="1.0" />
            </LinearGradientBrush>
          </Shape.Fill>
        </Rectangle>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>