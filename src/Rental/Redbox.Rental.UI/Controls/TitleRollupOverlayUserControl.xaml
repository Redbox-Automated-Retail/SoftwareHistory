<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.TitleRollupOverlayUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localbase="clr-namespace:Redbox.Rental.UI" Visibility="{Binding Path=Visibility}" DataContextChanged="UserControl_DataContextChanged" IsVisibleChanged="UserControl_IsVisibleChanged">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.CancelTitleRollupOverlayCommand}" Executed="CancelTitleRollupOverlayCommand_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.AddDVDCommand}" Executed="AddDVDCommand_Executed" CanExecute="AddDVDCommand_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.AddBluRayCommand}" Executed="AddBlurayCommand_Executed" CanExecute="AddBlurayCommand_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.AddDigitalCodeCommand}" Executed="AddDigitalCodeCommand_Executed" CanExecute="DigitalCodeCommand_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.DigitalCodeInfoCommand}" Executed="DigitalCodeInfoCommand_Executed" CanExecute="DigitalCodeCommand_CanExecute" />
  </UIElement.CommandBindings>
  <Grid>
    <Border Name="Border" CornerRadius="1" BorderThickness="2" BorderBrush="#E42045">
      <Grid ShowGridLines="False">
        <Panel.Background>
          <SolidColorBrush Color="Black" Opacity="0.8" />
        </Panel.Background>
        <Grid.RowDefinitions>
          <RowDefinition Height="10*" />
          <RowDefinition Height="20*" />
          <RowDefinition Height="10*" />
          <RowDefinition Height="20*" />
          <RowDefinition Height="10*" />
          <RowDefinition Height="{Binding Path=GridDigitalCodeButtonGridRowHeight, FallbackValue=20*}" />
          <RowDefinition Height="{Binding Path=GridDigitalCodeButtonMarginGridRowHeight, FallbackValue=10*}" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="10*" />
          <ColumnDefinition Width="80*" />
          <ColumnDefinition Width="10*" />
        </Grid.ColumnDefinitions>
        <Redbox:RoundedButton Name="DVDButton" Grid.Row="1" Grid.Column="1" UsedDefaultCornerRadius="True" Style="{StaticResource rubine_white_border_button_style}" Command="{x:Static localbase:Commands.AddDVDCommand}" Visibility="{Binding Path=DVDButtonVisibility, FallbackValue=Visible}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="10*" />
              <ColumnDefinition Width="80*" />
              <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="{Binding Path=DVDButtonMarginGridRowHeight, FallbackValue=30*}" />
              <RowDefinition Height="{Binding Path=DVDButtonTextGridRowHeight, FallbackValue=40*}" />
              <RowDefinition Height="{Binding Path=DVDButtonMarginGridRowHeight, FallbackValue=30*}" />
            </Grid.RowDefinitions>
            <Viewbox Grid.Column="1" Grid.Row="1">
              <TextBlock TextAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_18}" FontSize="{Binding Path=FontSize, FallbackValue=16}" Text="{Binding Path=DVDButtonText, FallbackValue=Add DVD}" />
            </Viewbox>
          </Grid>
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="BlurayButton" Grid.Row="3" Grid.Column="1" UsedDefaultCornerRadius="True" Style="{StaticResource warmpurple_white_border_button_style}" Command="{x:Static localbase:Commands.AddBluRayCommand}" Visibility="{Binding Path=BlurayButtonVisibility, FallbackValue=Visible}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="10*" />
              <ColumnDefinition Width="80*" />
              <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="{Binding Path=BlurayButtonMarginGridRowHeight, FallbackValue=30*}" />
              <RowDefinition Height="{Binding Path=BlurayButtonTextGridRowHeight, FallbackValue=40*}" />
              <RowDefinition Height="{Binding Path=BlurayButtonMarginGridRowHeight, FallbackValue=30*}" />
            </Grid.RowDefinitions>
            <Viewbox Grid.Column="1" Grid.Row="1">
              <TextBlock TextAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_18}" FontSize="{Binding Path=FontSize, FallbackValue=16}" Text="{Binding Path=BlurayButtonText, FallbackValue=Add Blu-ray}" />
            </Viewbox>
          </Grid>
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="DigitalCodeButton" Grid.Row="5" Grid.Column="1" UsedDefaultCornerRadius="True" Style="{StaticResource classic_yellow_button_style}" Command="{x:Static localbase:Commands.AddDigitalCodeCommand}" Visibility="{Binding Path=DigitalCodeButtonVisibility, FallbackValue=Visible}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="10*" />
              <ColumnDefinition Width="80*" />
              <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="{Binding Path=DigitalCodeButtonMarginGridRowHeight, FallbackValue=30*}" />
              <RowDefinition Height="{Binding Path=DigitalCodeButtonTextGridRowHeight, FallbackValue=40*}" />
              <RowDefinition Height="{Binding Path=DigitalCodeButtonMarginGridRowHeight, FallbackValue=30*}" />
            </Grid.RowDefinitions>
            <Viewbox Grid.Column="1" Grid.Row="1">
              <TextBlock TextAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource font_museo_slab_900_18}" FontSize="{Binding Path=FontSize, FallbackValue=16}" Text="{Binding Path=DigitalCodeButtonText, FallbackValue=Add Digital Code}" />
            </Viewbox>
          </Grid>
        </Redbox:RoundedButton>
      </Grid>
    </Border>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="{Binding Path=DigitalCodeInfoVisibility, FallbackValue=Hidden}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20*" />
        <ColumnDefinition Width="80*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="20" />
      </Grid.RowDefinitions>
      <Redbox:RoundedButton Name="DigitalCodeInfoButton" Grid.Column="0" Grid.Row="0" Width="20" Height="20" Style="{StaticResource white_info_button_style}" Command="{x:Static localbase:Commands.DigitalCodeInfoCommand}" CornerRadius="21" Margin="0,0,5,0">
        <TextBlock Style="{StaticResource font_cooper_12}">i</TextBlock>
      </Redbox:RoundedButton>
      <TextBlock Grid.Column="1" Grid.Row="0" Style="{StaticResource font_bryant_10}" Foreground="#FFFFFFFF" VerticalAlignment="Center" Text="{Binding Path=DigitalCodeInfoText, FallbackValue=Whats a Digital Code?}" />
    </Grid>
    <Redbox:RoundedButton Name="CancelButton" Width="42" Height="42" Style="{StaticResource light_gray_white_border_button_style}" Command="{x:Static localbase:Commands.CancelTitleRollupOverlayCommand}" BorderColor="White" BorderGradientColor="White" BorderThickness="2" CornerRadius="21" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-10">
      <Redbox:GridExt RowHeights="5*,90*,5*" ColumnWidths="5*,90*,5*">
        <Viewbox Grid.Row="1" Grid.Column="1">
          <UserControl Style="{StaticResource delete_x_style}" />
        </Viewbox>
      </Redbox:GridExt>
    </Redbox:RoundedButton>
  </Grid>
</UserControl>