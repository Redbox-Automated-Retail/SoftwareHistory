<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.DisplayCollectionUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localbase="clr-namespace:Redbox.Rental.UI" SizeChanged="UserControl_SizeChanged" DataContextChanged="UserControl_DataContextChanged">
  <UIElement.InputBindings>
    <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.BrowseItemSelectedCommand}" />
  </UIElement.InputBindings>
  <Grid Name="MainGrid">
    <local:AspectRatioLayoutDecorator AspectRatio="0.84444" LockAspectRatio="True">
      <Grid>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="80*" />
            <RowDefinition Height="20*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" />
            <ColumnDefinition Width="80*" />
          </Grid.ColumnDefinitions>
          <local:AspectRatioLayoutDecorator AspectRatio="0.7219512195121951" LockAspectRatio="True" Grid.Column="1" HorizontalAlignment="Left">
            <Border BorderBrush="#3C3839" BorderThickness="2">
              <Grid>
                <Image Name="BottomProductImage" Stretch="Fill" Source="{Binding Path=BottomImage}" />
                <Grid Background="#FF000000" Opacity="0.6" />
              </Grid>
            </Border>
          </local:AspectRatioLayoutDecorator>
        </Grid>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="80*" />
            <RowDefinition Height="15*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="13*" />
            <ColumnDefinition Width="87*" />
          </Grid.ColumnDefinitions>
          <local:AspectRatioLayoutDecorator AspectRatio="0.7219512195121951" LockAspectRatio="True" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left">
            <Border BorderBrush="#3C3839" BorderThickness="2">
              <Grid>
                <Image Name="MiddleProductImage" Stretch="Fill" Source="{Binding Path=MiddleImage}" />
                <Grid Background="#FF000000" Opacity="0.3" />
              </Grid>
            </Border>
          </local:AspectRatioLayoutDecorator>
        </Grid>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="10*" />
            <RowDefinition Height="80*" />
            <RowDefinition Height="10*" />
          </Grid.RowDefinitions>
          <local:AspectRatioLayoutDecorator AspectRatio="0.7219512195121951" LockAspectRatio="True" Grid.Row="1" HorizontalAlignment="Left">
            <Border BorderBrush="#3C3839" BorderThickness="2">
              <Image Name="TopProductImage" Stretch="Fill" Source="{Binding Path=TopImage}" />
            </Border>
          </local:AspectRatioLayoutDecorator>
        </Grid>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="80*" />
            <RowDefinition Height="20*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" />
            <ColumnDefinition Width="80*" />
          </Grid.ColumnDefinitions>
          <local:RoundedButton x:Name="SelectButton" Style="{StaticResource classic_rubine_button_style}" Command="{x:Static localbase:Commands.BrowseItemSelectedCommand}" Grid.Row="1" Grid.Column="1" CornerRadius="22">
            <UIElement.Effect>
              <DropShadowEffect Color="#606060" Direction="-50" ShadowDepth="5" Opacity="0.5" />
            </UIElement.Effect>
            <TextBlock Name="SelectButtonText" Style="{StaticResource font_target_smaller}" Margin="5,2,5,2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" Text="{Binding Path=Text, FallbackValue=Collection Name goes here}" />
          </local:RoundedButton>
        </Grid>
      </Grid>
    </local:AspectRatioLayoutDecorator>
  </Grid>
</UserControl>