<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.CrossfadeImageRotatorUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:controls="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" x:Name="RotatorControl">
  <Grid>
    <ItemsControl ItemsSource="{Binding ImageModels, ElementName=RotatorControl}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Grid />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <controls:RoundedButton Style="{StaticResource transparent_button_style}" Opacity="{Binding Opacity, FallbackValue=1}" Panel.ZIndex="{Binding ZIndex}" Click="Button_Click">
            <Image Stretch="Fill" Source="{Binding ImageUrl}" />
          </controls:RoundedButton>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>