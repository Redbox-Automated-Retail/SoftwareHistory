<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.StyledTextUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls">
  <TextBlock Style="{Binding Style}">
    <Run Text="{Binding Text}" />
    <Run BaselineAlignment="Top" Text="{Binding Asterisk}" Style="{Binding AsteriskStyle}" />
  </TextBlock>
</UserControl>