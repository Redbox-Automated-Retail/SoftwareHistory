<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.CheckMarkButtonUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" Visibility="{Binding Path=Visibility, FallbackValue=Collapsed}">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:CheckMarkButtonUserControl.Command}" Executed="CommandBinding_Executed" />
  </UIElement.CommandBindings>
  <StackPanel Orientation="Horizontal">
    <Redbox:RoundedButton Command="{x:Static local:CheckMarkButtonUserControl.Command}" Style="{Binding Path=Style, FallbackValue={StaticResource button_selectable_unselected_style}}" Margin="{Binding Path=Margin, FallbackValue='8,0,8,0'}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource button_text_selectable_style}" Padding="{Binding Path=TextPadding, FallbackValue='24,0,24,0'}" Text="{Binding Path=Text, FallbackValue=TEXT}" />
        <Image Style="{StaticResource button_image_selectable_arrow_style}" Visibility="{Binding Path=ArrowImageVisibility, FallbackValue=Collapsed}" />
      </StackPanel>
    </Redbox:RoundedButton>
    <Image Style="{StaticResource button_image_selectable_style}" Margin="{Binding Path=ImageMargin, FallbackValue='-35,-35,0,0'}" Visibility="{Binding Path=ImageVisibility, FallbackValue=Hidden}" />
  </StackPanel>
</UserControl>