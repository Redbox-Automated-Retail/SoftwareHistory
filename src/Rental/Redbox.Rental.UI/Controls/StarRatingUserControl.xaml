            <Style.Triggers>
              <DataTrigger Value="True">
                <DataTrigger.Binding>
                  <MultiBinding Converter="{StaticResource GreaterOrEqualConverter}">
                    <Binding Path="NumberOfStars" ElementName="StarControl" />
                    <Binding Source="{StaticResource One}" />
                  </MultiBinding>
                </DataTrigger.Binding>
