<?xml version="1.0" encoding="utf-8"?>
<local:BaseUserControl x:Class="Redbox.Rental.UI.Controls.ReviewListUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localViews="clr-namespace:Redbox.Rental.UI.Views" xmlns:designModel="clr-namespace:Redbox.Rental.UI.Models.DesignTime" x:Name="ReviewList">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="60" />
    </Grid.RowDefinitions>
    <ItemsControl Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Center" ItemsSource="{Binding CurrentPageReviews, ElementName=ReviewList}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="0,10,0,0">
            <local:StarRatingUserControl HorizontalAlignment="Left" NumberOfStars="{Binding NumberOfStars}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Style="{StaticResource font_museo_slab_700_12}" Foreground="#FF000000" HorizontalAlignment="Left" Text="{Binding ReviewerName}" />
              <TextBlock Margin="10,0,0,0" Style="{StaticResource font_museo_slab_500_12}" Foreground="{StaticResource LightBlackBrush}" HorizontalAlignment="Left" Text="{Binding ReviewDate}" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource font_montserrat_semibold_11}" Foreground="#FF000000" TextWrapping="Wrap" TextAlignment="Left" HorizontalAlignment="Left" Width="410" Height="110" Text="{Binding ReviewText}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <local:PagingButtonsControl x:Name="PageControl" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" ButtonSize="38" NumberOfPages="{Binding NumberOfPages, ElementName=ReviewList}" CurrentPageNumber="{Binding CurrentPageNumber, ElementName=ReviewList, Mode=TwoWay}" Visibility="{Binding PageControlVisibility, ElementName=ReviewList, FallbackValue=Visible}" />
  </Grid>
</local:BaseUserControl>