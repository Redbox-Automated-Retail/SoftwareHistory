<?xml version="1.0" encoding="utf-8"?>
<local:RentalUserControl x:Class="Redbox.Rental.UI.Controls.BrowseTopMenuUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" DataContextChanged="UserControl_DataContextChanged">
  <Grid Height="74">
    <Border Name="MenuBackground" Height="68" VerticalAlignment="Top" Margin="0,1,0,0" Style="{Binding Path=MenuBackgroundStyle, FallbackValue={StaticResource browse_top_menu_background_style}}" Visibility="{Binding Path=MenuBackgroundVisibility}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Image Name="RedboxPlusLogoImage" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/logo-redbox-plus-white.png" Height="32" Margin="0,12,10,0" VerticalAlignment="Top" Visibility="{Binding RedboxPlusLogoVisiblity, FallbackValue=Collapsed}" />
        <TextBlock Name="BackgroundText" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Path=MenuBackgroundText}" Style="{Binding Path=MenuTextStyle, FallbackValue={StaticResource browse_top_menu_text_collection_style}}" />
      </StackPanel>
    </Border>
    <Grid Name="NonFixedButtonContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions />
    </Grid>
    <Grid Name="FixedButtonContainer" HorizontalAlignment="Left" VerticalAlignment="Top" />
  </Grid>
</local:RentalUserControl>