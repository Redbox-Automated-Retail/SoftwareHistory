<?xml version="1.0" encoding="utf-8"?>
<local:RentalUserControl x:Class="Redbox.Rental.UI.Controls.JoinedUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" Focusable="False">
  <Grid Background="#FFFFFFFF">
    <Image Name="PinkDotsBackgroundImage" Height="768" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/backgroundTexture.png" HorizontalAlignment="Left" VerticalAlignment="Top" />
    <Redbox:GridExt RowHeights="*,*">
      <Grid Row="0" Background="{StaticResource RubineRedRadialGradientBrush}" />
      <Grid Row="1">
        <Redbox:RoundedButton Name="ContinueButtonElem" Width="auto" Margin="10,20,5,110" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource style_rb_purple_white_border_button}" IsEnabled="True" Command="{Binding ContinueButtonCommand}">
          <TextBlock Name="ContinueButtonTextElem" Margin="45,0" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="140" TextAlignment="Center" Style="{StaticResource font_museo_slab_900_28}" Text="{Binding ContinueButtonText}" />
        </Redbox:RoundedButton>
      </Grid>
    </Redbox:GridExt>
    <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="300" Margin="0,0,0,220">
      <Ellipse Height="300" Width="300" VerticalAlignment="Bottom" Fill="#FFFFFFFF" Stroke="{StaticResource RubineRedBrush}" StrokeThickness="3" />
    </Grid>
  </Grid>
</local:RentalUserControl>