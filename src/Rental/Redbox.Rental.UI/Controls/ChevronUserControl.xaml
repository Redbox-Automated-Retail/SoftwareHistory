<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.ChevronUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" DataContext="{Binding RelativeSource={RelativeSource Self}}">
  <Grid>
    <Polygon Name="RightArrow" Stroke="#FFFFFFFF" StrokeThickness="1" Stretch="Uniform" Fill="{Binding Path=ChevronColor, FallbackValue=White}">
      <Polygon.Points>
        <Point X="10" Y="10" />
        <Point X="33" Y="33" />
        <Point X="10" Y="56" />
        <Point X="15" Y="61" />
        <Point X="43" Y="33" />
        <Point X="15" Y="5" />
      </Polygon.Points>
    </Polygon>
    <Polygon Name="LeftArrow" Stroke="#FFFFFFFF" StrokeThickness="1" Stretch="Uniform" Fill="{Binding Path=ChevronColor, FallbackValue=White}">
      <Polygon.Points>
        <Point X="43" Y="10" />
        <Point X="20" Y="33" />
        <Point X="43" Y="56" />
        <Point X="38" Y="61" />
        <Point X="10" Y="33" />
        <Point X="38" Y="5" />
      </Polygon.Points>
    </Polygon>
  </Grid>
</UserControl>