<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.OfferInfoUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <Grid Name="OuterGrid" Width="{Binding ControlWidth}">
    <Image Name="OneUpBackgroundImage" Height="570" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/dots.png" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" Visibility="{Binding OneUpVisibility, FallbackValue=Visible}" />
    <Image Name="TwoUpBackgroundImage" Height="570" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/dots2up.png" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" Visibility="{Binding TwoUpVisibility, FallbackValue=Collapsed}" />
    <Redbox:RoundedButton Style="{StaticResource transparent_button_style}" Command="{Binding ContinueButtonCommand}" CommandParameter="{Binding CustomerOffer}">
      <Grid Height="600" Width="{Binding ControlWidth}">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <ItemsControl ItemsSource="{Binding StyledTextLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <local:StyledTextUserControl Margin="10,5,10,5" DataContext="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Redbox:RoundedButton Name="ContinueButton2Up" Grid.Row="1" Width="196" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,10,0,10" CornerRadius="28" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" Command="{Binding ContinueButtonCommand}" CommandParameter="{Binding CustomerOffer}" Visibility="{Binding TwoUpVisibility}">
          <TextBlock Name="ContinueButtonText2Up" Style="{StaticResource font_museo_slab_900_24}" Text="{Binding Path=ContinueButtonText, FallbackValue=See Movies}" />
        </Redbox:RoundedButton>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
          <Redbox:RoundedButton Name="CancelButton" MinWidth="243" Height="59" VerticalAlignment="Center" Margin="25,0,25,0" CornerRadius="28" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" Command="{Binding CancelButtonCommand}" Visibility="{Binding CancelButtonVisibility}">
            <TextBlock Name="CancelButtonText" Foreground="#E42045" Style="{StaticResource font_museo_slab_900_32}" Text="{Binding Path=CancelButtonText, FallbackValue=No Thanks}" />
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="ContinueButton" MinWidth="243" Height="59" VerticalAlignment="Center" Margin="25,0,25,0" CornerRadius="28" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" Command="{Binding ContinueButtonCommand}" CommandParameter="{Binding CustomerOffer}" Visibility="{Binding OneUpVisibility}">
            <TextBlock Name="ContinueButtonText" Style="{StaticResource font_museo_slab_900_32}" Text="{Binding Path=ContinueButtonText, FallbackValue=See Movies}" />
          </Redbox:RoundedButton>
        </StackPanel>
      </Grid>
    </Redbox:RoundedButton>
  </Grid>
</UserControl>