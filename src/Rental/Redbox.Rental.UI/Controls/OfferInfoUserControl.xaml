<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.OfferInfoUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <Grid Name="OuterGrid" Width="{Binding ControlWidth}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="4" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="4" />
    </Grid.ColumnDefinitions>
    <Grid Row="1" ColumnSpan="2" Background="#FFFFFFFF" />
    <Grid Column="1" RowSpan="2" Background="#FFFFFFFF" />
    <Redbox:RoundedButton Style="{StaticResource transparent_button_style}" Command="{Binding ContinueButtonCommand}" CommandParameter="{Binding CustomerOffer}">
      <Grid Height="{Binding ControlHeight, FallbackValue=600}" Width="{Binding ControlWidth, FallbackValue=1024}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <UserControl Name="BannerPentagon" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource BannerPentagon}" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding BannerVisibility, FallbackValue=Visible}" />
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource font_montserrat_bold_32}" Foreground="#F05B27" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" Text="{Binding Path=BannerText, FallbackValue=Just for you}" Visibility="{Binding BannerVisibility, FallbackValue=Visible}" />
        <Grid Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <local:AspectRatioLayoutDecorator Grid.Column="0" AspectRatio="0.7219512195121951" LockAspectRatio="True" Visibility="{Binding ImageVisibility}">
            <Image Name="DisplayProductImage" Stretch="Fill" Source="{Binding Path=Image}" />
          </local:AspectRatioLayoutDecorator>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ItemsControl Grid.Column="1" ItemsSource="{Binding StyledTextLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <local:StyledTextUserControl Margin="10,5,10,5" DataContext="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="{Binding TextHorizontalAlignment, FallbackValue=Center}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Redbox:RoundedButton Name="ContinueButton3Up" Width="196" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,25,0,0" CornerRadius="28" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" Command="{Binding ContinueButtonCommand}" CommandParameter="{Binding CustomerOffer}" Visibility="{Binding ThreeUpVisibility}">
              <TextBlock Name="ContinueButtonText3Up" Style="{StaticResource font_museo_slab_900_24}" Text="{Binding Path=ContinueButtonText, FallbackValue=See Movies}" />
            </Redbox:RoundedButton>
          </StackPanel>
        </Grid>
        <Redbox:RoundedButton Name="ContinueButton2Up" Grid.Row="2" Grid.Column="0" Width="196" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,10,0,40" CornerRadius="28" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" Command="{Binding ContinueButtonCommand}" CommandParameter="{Binding CustomerOffer}" Visibility="{Binding TwoUpVisibility}">
          <TextBlock Name="ContinueButtonText2Up" Style="{StaticResource font_museo_slab_900_24}" Text="{Binding Path=ContinueButtonText, FallbackValue=See Movies}" />
        </Redbox:RoundedButton>
        <TextBlock Name="MessageTextBlock" Grid.Row="2" Grid.Column="0" Style="{Binding MessageTextStyle}" Text="{Binding MessageText}" Visibility="{Binding MessageTextVisibility}" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
          <Redbox:RoundedButton Name="CancelButton" MinWidth="234" Height="56" VerticalAlignment="Center" Margin="25,0,25,10" CornerRadius="28" Style="{StaticResource white_rubine_to_warm_purple_border_button_with_dropshadow_style}" Command="{Binding CancelButtonCommand}" Visibility="{Binding CancelButtonVisibility}">
            <TextBlock Name="CancelButtonText" Foreground="#E42045" Style="{StaticResource font_museo_slab_900_28}" Text="{Binding Path=CancelButtonText, FallbackValue=No Thanks}" />
          </Redbox:RoundedButton>
          <Redbox:RoundedButton Name="ContinueButton" MinWidth="234" Height="56" VerticalAlignment="Center" Margin="25,0,25,10" CornerRadius="28" Style="{StaticResource warmpurple_white_border_button_with_dropshadow_style}" Command="{Binding ContinueButtonCommand}" CommandParameter="{Binding CustomerOffer}" Visibility="{Binding OneUpVisibility}">
            <TextBlock Name="ContinueButtonText" Style="{StaticResource font_museo_slab_900_28}" Text="{Binding Path=ContinueButtonText, FallbackValue=See Movies}" />
          </Redbox:RoundedButton>
        </StackPanel>
      </Grid>
    </Redbox:RoundedButton>
  </Grid>
</UserControl>