<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.BrowseCheckOutBarUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.CheckOutCommand}" Executed="CheckOutCommandBinding_Executed" CanExecute="CheckOutCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.ToggleTitleFamily1Command}" Executed="ToggleTitleFamily1CommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.SignInCommand}" Executed="SignInCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.SignOutCommand}" Executed="SignOutCommandBinding_Executed" />
    <CommandBinding Command="{x:Static localbase:Commands.MyPerksCommand}" Executed="MyPerksCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Background="{StaticResource LightGrayBackgroundBrush}" VerticalAlignment="Bottom" Height="145">
    <DockPanel Width="780" HorizontalAlignment="Right">
      <Redbox:RoundedButton Name="checkout_button" DockPanel.Dock="Right" Width="216" Height="56" UsedDefaultCornerRadius="True" HorizontalAlignment="Right" Margin="10,0,15,0" Command="{x:Static localbase:Commands.CheckOutCommand}" Style="{Binding Path=CheckOutButtonStyle, FallbackValue={StaticResource warm_purple_no_border_button_style}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Name="checkout_button_text" Style="{StaticResource font_montserrat_extrabold_20}" Text="{Binding Path=CheckOutButtonText, FallbackValue=CHECKOUT}" />
          <TextBlock Name="checkout_button_count" Style="{StaticResource font_montserrat_medium_20}" Margin="7,0,0,0" Text="{Binding Path=CheckOutButtonCountText, FallbackValue=(0)}" />
        </StackPanel>
      </Redbox:RoundedButton>
      <Grid Width="152" DockPanel.Dock="Right" Visibility="{Binding Path=SwitchProductFamilyButton1Visibility, FallbackValue=Collapsed}">
        <Redbox:RoundedButton Name="SwitchProductFamilyButton1" Style="{StaticResource white_rubine_to_warm_purple_border_button_style}" Width="140" Height="56" UsedDefaultCornerRadius="True" Command="{x:Static localbase:Commands.ToggleTitleFamily1Command}">
          <TextBlock Style="{StaticResource font_montserrat_extrabold_20}" Text="{Binding Path=SwitchProductFamilyButton1Text, FallbackValue=Games}" />
        </Redbox:RoundedButton>
      </Grid>
      <Grid>
        <Grid Visibility="{Binding Path=MiniCartVisibility}">
          <Grid Name="EmptyCartSpaces" Visibility="{Binding Path=EmptyCartSpacesVisibility, FallbackValue=Visible}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="EmptyMiniCartSpace" TargetType="{x:Type UserControl}">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type UserControl}">
                        <Grid Background="#FFFFFFFF" Margin="7,19,14,15">
                          <Border BorderThickness="1" BorderBrush="#FFD3D3D3" />
                        </Grid>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <UserControl Grid.Column="0" Style="{StaticResource EmptyMiniCartSpace}" />
            <UserControl Grid.Column="1" Style="{StaticResource EmptyMiniCartSpace}" />
            <UserControl Grid.Column="2" Style="{StaticResource EmptyMiniCartSpace}" />
            <UserControl Grid.Column="3" Style="{StaticResource EmptyMiniCartSpace}" />
            <UserControl Grid.Column="4" Style="{StaticResource EmptyMiniCartSpace}" />
          </Grid>
          <local:BrowseUserControl x:Name="MiniCartControl" Height="128" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0" ShowPaddles="False" BorderShadowVisibility="Collapsed" DataContext="{Binding Path=MiniCartControlModel}" />
        </Grid>
        <Redbox:RoundedButton Name="EmptyCartAddItemMessage" Height="60" Width="322" UsedDefaultCornerRadius="True" Style="{StaticResource TransparentButton}" Visibility="{Binding Path=EmptyCartAddItemMessageVisibility, FallbackValue=Visible}">
          <Grid Background="{StaticResource LightGrayBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Name="AddToCartLabelText1" Style="{StaticResource font_montserrat_medium_16}" Foreground="#4A4A4A" Margin="3,3,3,3" VerticalAlignment="Center" Text="{Binding Path=AddToCartLabel1Text, FallbackValue=PRESS}" />
              <Redbox:RoundedButton Style="{StaticResource classic_rubine_button_style}" Height="20" Width="20" Margin="3" VerticalAlignment="Center">
                <UserControl Style="{StaticResource plus_sign_style}" Height="16" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Redbox:RoundedButton>
              <TextBlock Name="AddToCartLabelText2" Style="{StaticResource font_montserrat_medium_16}" Foreground="#4A4A4A" Margin="3,3,3,3" VerticalAlignment="Center" Text="{Binding Path=AddToCartLabel2Text, FallbackValue=TO ADD ITEMS}" />
            </StackPanel>
          </Grid>
        </Redbox:RoundedButton>
        <TextBlock Name="AddToADACartLabel" Style="{StaticResource font_montserrat_regular_13}" Foreground="{StaticResource RbPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3" Text="{Binding Path=AddToADACartLabelText, FallbackValue=To rent a disc touch its picture or its number above.}" Visibility="{Binding Path=AddToADACartLabelVisibility, FallbackValue=Collapsed}" />
      </Grid>
    </DockPanel>
    <Grid Name="LoyaltyGrid" HorizontalAlignment="Left" Width="250">
      <StackPanel Orientation="Vertical">
        <TextBlock Name="DontMissYourPerksText" Style="{StaticResource font_montserrat_semibold_16}" Foreground="#FF000000" VerticalAlignment="Center" TextAlignment="Center" Margin="0,30,0,8" Text="{Binding Path=DontMissYourPerksText, FallbackValue=Earn FREE Rentals!}" Visibility="{Binding Path=SignInButtonVisibility, FallbackValue=Visible}" />
        <Redbox:RoundedButton Name="SignInButton" Style="{StaticResource thin_border_button_style}" Width="0" MinWidth="208" Height="48" UsedDefaultCornerRadius="True" Margin="0,0,0,0" Command="{x:Static localbase:Commands.SignInCommand}" Visibility="{Binding Path=SignInButtonVisibility, FallbackValue=Visible}">
          <StackPanel Orientation="Horizontal" Margin="0,0" Width="Auto">
            <TextBlock Name="SignInButtonText" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=SignInButtonText, FallbackValue=SIGN IN}" />
            <TextBlock Name="SignInButtonSeparator" Style="{StaticResource font_montserrat_medium_16}" Text="{Binding Path=SignInUpButtonSeparator, FallbackValue= | }" />
            <TextBlock Name="SignUpButtonText" Style="{StaticResource font_montserrat_extrabold_16}" Text="{Binding Path=SignUpButtonText, FallbackValue=SIGN UP}" />
          </StackPanel>
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="MyPerksButton" Style="{StaticResource white_rubine_to_warm_purple_border_button_style}" Width="200" Height="48" UsedDefaultCornerRadius="True" Margin="0,24,0,0" Command="{x:Static localbase:Commands.MyPerksCommand}" Visibility="{Binding Path=MyPerksButtonVisibility, FallbackValue=Collapsed}">
          <TextBlock Name="MyPerksButtonText" Style="{StaticResource font_montserrat_extrabold_18}" Text="{Binding Path=MyPerksButtonText, FallbackValue=My Perks}" />
        </Redbox:RoundedButton>
        <Redbox:RoundedButton Name="SignOutButton" Style="{StaticResource TransparentButton}" Width="200" Height="50" UsedDefaultCornerRadius="True" Margin="0,8,0,7" Command="{x:Static localbase:Commands.SignOutCommand}" Visibility="{Binding Path=SignOutButtonVisibility, FallbackValue=Collapsed}">
          <TextBlock Name="SignOutButtonText" Style="{StaticResource font_montserrat_bold_16}" TextDecorations="Underline" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource RubineRedBrush}" Text="{Binding Path=SignOutButtonText, FallbackValue=SIGN OUT}" />
        </Redbox:RoundedButton>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>