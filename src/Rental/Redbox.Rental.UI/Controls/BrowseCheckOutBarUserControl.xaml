<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.BrowseCheckOutBarUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls">
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static localbase:Commands.CheckOutCommand}" Executed="CheckOutCommandBinding_Executed" CanExecute="CheckOutCommandBinding_CanExecute" />
    <CommandBinding Command="{x:Static localbase:Commands.ToggleTitleFamilyCommand}" Executed="ToggleTitleFamilyCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid Background="#380B44" VerticalAlignment="Bottom" Height="145">
    <Image Name="redbox_logo" Margin="50,0,0,10" Width="135" Height="43" VerticalAlignment="Center" HorizontalAlignment="Left" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/logoWhite.png" />
    <DockPanel Width="816" HorizontalAlignment="Right">
      <local:RoundedButton x:Name="checkout_button" DockPanel.Dock="Right" Width="220" Height="68" CornerRadius="34" HorizontalAlignment="Right" Margin="30,0,15,0" Command="{x:Static localbase:Commands.CheckOutCommand}" Style="{Binding Path=CheckOutButtonStyle, FallbackValue={StaticResource orange_white_border_button_style}}">
        <TextBlock Name="checkout_button_text" Style="{StaticResource font_target_small_bold}" Text="{Binding Path=CheckOutButtonText, FallbackValue=CHECK OUT}" />
      </local:RoundedButton>
      <Grid Width="152" DockPanel.Dock="Right" Visibility="{Binding Path=SwitchProductFamilyButtonVisibility, FallbackValue=Collapsed}">
        <local:RoundedButton x:Name="SwitchProductFamilyButton" Style="{StaticResource rubine_white_border_button_style}" Width="110" Height="110" CornerRadius="55" Command="{x:Static localbase:Commands.ToggleTitleFamilyCommand}">
          <TextBlock Style="{StaticResource font_montserrat_bold_16}" Text="{Binding Path=SwitchProductFamilyButtonText, FallbackValue=To Games}" />
        </local:RoundedButton>
        <Line X1="0" X2="0" Y1="0" Y2="300" HorizontalAlignment="Right" StrokeThickness="2" Stroke="#4E4E4E" />
        <Line X1="0" X2="0" Y1="0" Y2="300" HorizontalAlignment="Left" StrokeThickness="2" Stroke="#4E4E4E" />
      </Grid>
      <Line X1="0" X2="0" Y1="0" Y2="300" HorizontalAlignment="Right" StrokeThickness="2" Stroke="#4E4E4E" Visibility="{Binding Path=SwitchProductFamilyButtonVisibility}" />
      <Grid>
        <local:BrowseUserControl x:Name="MiniCartControl" Height="128" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0" ShowPaddles="False" BorderShadowVisibility="Collapsed" DataContext="{Binding Path=MiniCartControlModel}" />
        <Grid Height="128" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
          <Border Name="AddToCartLabel" BorderThickness="2" BorderBrush="#505050" Height="45" HorizontalAlignment="Center" Visibility="{Binding Path=AddToCartLabelVisibility}">
            <StackPanel Orientation="Horizontal" Background="#CC323232">
              <TextBlock Name="AddToCartLabelText1" Style="{StaticResource font_montserrat_regular_29}" Foreground="#FFFFFFFF" Margin="20,3,3,3" VerticalAlignment="Center" Text="{Binding Path=AddToCartLabel1Text, FallbackValue=Press}">
                <UIElement.Effect>
                  <DropShadowEffect Direction="-50" ShadowDepth="2" BlurRadius="2" />
                </UIElement.Effect>
              </TextBlock>
              <local:RoundedButton Style="{StaticResource classic_rubine_button_style}" Height="30" Width="30" Margin="3">
                <UserControl Style="{StaticResource plus_sign_style}" />
              </local:RoundedButton>
              <TextBlock Name="AddToCartLabelText2" Style="{StaticResource font_montserrat_regular_29}" Foreground="#FFFFFFFF" Margin="3,3,20,3" VerticalAlignment="Center" Text="{Binding Path=AddToCartLabel2Text, FallbackValue=to add items for rental}">
                <UIElement.Effect>
                  <DropShadowEffect Direction="-50" ShadowDepth="2" BlurRadius="2" />
                </UIElement.Effect>
              </TextBlock>
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Name="AddToADACartLabel" Style="{StaticResource font_target_smaller}" Foreground="#EAEAEA" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="3" Text="{Binding Path=AddToADACartLabelText, FallbackValue=To rent a disc touch its picture or its number above.}" Visibility="{Binding Path=AddToADACartLabelVisibility, FallbackValue=Collapsed}" />
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>