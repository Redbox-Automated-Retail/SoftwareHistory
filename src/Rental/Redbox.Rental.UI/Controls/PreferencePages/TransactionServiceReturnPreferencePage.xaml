<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.PreferencePages.TransactionServiceReturnPreferencePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls.PreferencePages">
  <Grid Background="#FFD3D3D3">
    <StackPanel>
      <Grid Name="HeaderPanel" Background="#FF008B8B" Height="50">
        <TextBlock Text="Transaction Service: Return" Foreground="#FFFFFFFF" FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0" />
      </Grid>
      <StackPanel Margin="20,5">
        <StackPanel Orientation="Horizontal">
          <CheckBox Name="UseTransactionServiceCheckBox" VerticalAlignment="Center" Click="UseTransactionServiceClicked" />
          <TextBlock Text="Use Transaction Service" FontSize="10" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="Return type" FontSize="10" Margin="5" />
          <ComboBox Name="ReturnTypeComboBox" MaxDropDownHeight="200" Width="350">
            <ComboBoxItem>Unknown</ComboBoxItem>
            <ComboBoxItem>ServiceMenu</ComboBoxItem>
            <ComboBoxItem>InventorySync</ComboBoxItem>
            <ComboBoxItem>Qlm</ComboBoxItem>
            <ComboBoxItem>ExceptionReturn</ComboBoxItem>
            <ComboBoxItem>KioskReturn</ComboBoxItem>
            <ComboBoxItem>QuickReturn</ComboBoxItem>
            <ComboBoxItem>BackwardsDiscReturn</ComboBoxItem>
            <ComboBoxItem>UnplayableReturn</ComboBoxItem>
            <ComboBoxItem>CrossBorderReturn</ComboBoxItem>
            <ComboBoxItem>FailedIRSecurity</ComboBoxItem>
            <ComboBoxItem>FailedLabelAudit</ComboBoxItem>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Barcode" FontSize="10" Margin="5" VerticalAlignment="Center" />
          <TextBox Name="BarcodeTextbox" Width="300" Height="18" VerticalAlignment="Center" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Deck" FontSize="10" Margin="5" VerticalAlignment="Center" />
          <TextBox Name="DeckTextbox" Width="50" Height="18" VerticalAlignment="Center" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Slot" FontSize="10" Margin="5" VerticalAlignment="Center" />
          <TextBox Name="SlotTextbox" Width="50" Height="18" VerticalAlignment="Center" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <CheckBox Name="FailedSecurityReadCheckBox" VerticalAlignment="Center" />
          <TextBlock Text="Failed Security Read" FontSize="10" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Fraud File Name" FontSize="10" Margin="5" VerticalAlignment="Center" />
          <TextBox Name="FraudFilenameTextbox" Width="300" Height="18" VerticalAlignment="Center" Margin="5" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Name="SendReturnButton" Width="150" Height="21" VerticalAlignment="Center" Click="SendReturnClicked">Send Return Request</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Return resposne:" FontSize="10" Margin="5" VerticalAlignment="Center" />
          <TextBox Name="ReturnResponseTextbox" Width="470" Height="18" VerticalAlignment="Center" Margin="5" />
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>