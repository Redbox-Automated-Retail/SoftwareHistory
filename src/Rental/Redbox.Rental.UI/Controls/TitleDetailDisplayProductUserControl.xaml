<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.TitleDetailDisplayProductUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:wpf="http://schemas.microsoft.com/netfx/2009/xaml/presentation">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BitmapImage x:Key="DefaultImage" UriSource="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/movie-missing-image.png" />
      <Style x:Key="SecondLineTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource font_montserrat_medium_20}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding Line2Text}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Collapsed" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.InputBindings>
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Static localbase:Commands.StatisticsPopupCommand}" />
  </UIElement.InputBindings>
  <Grid Background="#00FFFFFF">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="512" />
          <ColumnDefinition Width="460" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition MinHeight="0" MaxHeight="98" Height="{Binding AdHeight}" />
          <RowDefinition MinHeight="530" MaxHeight="628" Height="{Binding MainHeight}" />
          <RowDefinition Height="140" />
        </Grid.RowDefinitions>
        <Grid Name="AdBanner" Row="0" ColumnSpan="2" Margin="0,0,-52,0">
          <Border Width="1024" Height="98" Background="#060208" Visibility="{Binding AdImageVisibility, FallbackValue=Collapsed}" />
          <Image Name="AdImage" Height="90" Width="728" Source="{Binding AdImage}" Visibility="{Binding AdImageVisibility, FallbackValue=Collapsed}" />
        </Grid>
        <Grid Column="0" Row="1" Background="#FFFFFFFF">
          <Grid Margin="20,30,0,0">
            <Grid Margin="{Binding FlagMargin, FallbackValue=0}">
              <localControls:DisplayProductUserControl Margin="44,0,0,2" VerticalAlignment="Bottom" HorizontalAlignment="Center" ClipToBounds="False" />
            </Grid>
          </Grid>
        </Grid>
        <Grid Column="1" Row="1" Background="#FFFFFFFF">
          <DockPanel LastChildFill="True" Margin="20,30,0,0">
            <TextBlock Style="{StaticResource font_museo_slab_900_30}" DockPanel.Dock="Top" Margin="0,3,100,10" Foreground="#E42045" TextWrapping="Wrap" Text="{Binding Header, FallbackValue=HEADER}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0" DockPanel.Dock="Top">
              <Border BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding RatingVisibility, FallbackValue=Visible}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_regular_12}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="{Binding Rating}" />
              </Border>
              <Border Margin="10,0,0,0" BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding FormatVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_regular_12}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="{Binding Format}" />
              </Border>
              <Border Margin="10,0,0,0" BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding RunningTimeVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_regular_12}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="{Binding RunningTime}" />
              </Border>
              <Border Margin="10,0,0,0" BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding ReleaseYearVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_regular_12}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="{Binding ReleaseYear}" />
              </Border>
              <Border Margin="10,0,0,0" BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding CCSupported, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_montserrat_regular_12}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="CC" />
              </Border>
            </StackPanel>
            <StackPanel Name="ProductDetails" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="-10,0,0,2" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
              <Rectangle Height="3" Width="Auto" Stroke="#792D8D" StrokeThickness="0" RadiusX="0" RadiusY="0" Fill="#792D8D" Margin="0,2,50,0" />
              <DockPanel LastChildFill="True" Margin="0,0,0,0">
                <StackPanel Name="SubPlatForm" DockPanel.Dock="Right" Width="250" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding SubPlatformVisibility, FallbackValue=Visible}">
                  <Viewbox Stretch="Uniform" VerticalAlignment="Center" MaxHeight="110" Margin="4,0,0,0" HorizontalAlignment="Left">
                    <Image Stretch="Fill" Source="{Binding SubPlatformImage}" />
                  </Viewbox>
                </StackPanel>
                <Rectangle Height="Auto" Width="3" Stroke="#792D8D" StrokeThickness="0" RadiusX="0" RadiusY="0" Fill="#792D8D" DockPanel.Dock="Right" Visibility="{Binding SubPlatformVisibility, FallbackValue=Visible}" />
                <StackPanel DockPanel.Dock="Left" Margin="0,2,0,2">
                  <Grid Name="starring" Margin="10,1,0,1" Visibility="{Binding StarringVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_bold_12}" Foreground="#303438" Text="{Binding StarringLabel, FallbackValue=Starring:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" TextWrapping="Wrap" Text="{Binding Starring}" />
                  </Grid>
                  <Grid Name="genres" Margin="10,1,0,1" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="92*" />
                      <ColumnDefinition Width="37*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_bold_12}" Foreground="#303438" Text="{Binding GenresLabel, FallbackValue=Category:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" TextWrapping="Wrap" Grid.ColumnSpan="2" Text="{Binding Genres, FallbackValue=ACTION}" />
                  </Grid>
                  <Grid Name="rating" Margin="10,1,0,1" Visibility="{Binding RatingVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_bold_12}" Foreground="#303438" Text="{Binding RatingLabel}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" TextWrapping="Wrap" Text="{Binding RatingDescription}" />
                  </Grid>
                  <Grid Name="oneNightPrice" Margin="10,10,0,1" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_bold_12}" Foreground="#303438" Text="{Binding OneNightPriceLabel, FallbackValue=1-Night Rental:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" TextWrapping="Wrap" Text="{Binding OneNightPrice}" />
                  </Grid>
                  <Grid Name="oneNightReturnTime" Margin="10,1,0,1" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_bold_12}" Foreground="#303438" Text="{Binding OneNightReturnTimeLabel, FallbackValue=Return:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" TextWrapping="Wrap" Text="{Binding OneNightReturnTime, FallbackValue=9PM}" />
                  </Grid>
                  <Grid Name="multiNightPrice" Margin="10,10,0,1" Visibility="{Binding MultiNightPriceVisibility, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_bold_12}" Foreground="#303438" Text="{Binding MultiNightPriceLabel, FallbackValue=Multi-Night Rental:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" TextWrapping="Wrap" Text="{Binding MultiNightPrice}" />
                  </Grid>
                  <Grid Name="multiNightReturnTime" Margin="10,1,0,1" Visibility="{Binding MultiNightReturnTimeVisibility, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_bold_12}" Foreground="#303438" Text="{Binding MultiNightReturnTimeLabel, FallbackValue=Return:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" TextWrapping="Wrap" Text="{Binding MultiNightReturnTime, FallbackValue=9PM}" />
                  </Grid>
                  <Grid Name="ServiceFee" Margin="10,10,0,1" Visibility="{Binding ServiceFeeTextVisibility, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_montserrat_bold_12}" Foreground="#303438" Text="{Binding ServiceFeeLabel, FallbackValue=Service Fee:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" TextWrapping="Wrap" Text="{Binding ServiceFeeText, FallbackValue=All checkouts may be subject to a service fee of 10¢.}" />
                  </Grid>
                  <Grid Name="hotDealText" Margin="10,10,0,1" Visibility="{Binding HotDealTextVisibility, FallbackValue=Collapsed}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource font_montserrat_extralight_12}" Foreground="#4A4A4A" TextWrapping="Wrap" Text="{Binding HotDealText, FallbackValue='Extra nights for Hot Deals are $1.50 DVD, $2.00 Blu-ray. Our Hot Deal can change at any time. It only shows up for specific titles, locations, and dates - so youre in luck.'}" />
                  </Grid>
                </StackPanel>
              </DockPanel>
              <Rectangle Height="3" Width="Auto" Stroke="#792D8D" StrokeThickness="0" RadiusX="0" RadiusY="0" Fill="#792D8D" Margin="0,0,50,2" />
            </StackPanel>
            <TextBlock Style="{StaticResource font_montserrat_regular_12}" Foreground="#303438" DockPanel.Dock="Top" Margin="0,20,50,10" TextWrapping="Wrap" Text="{Binding Description, FallbackValue=DESCRIPTION}" />
          </DockPanel>
        </Grid>
        <Grid Name="Buttons" ColumnSpan="2" Row="3" Margin="0,0,-52,-34" Height="104" Background="#EBEBEB">
          <DockPanel>
            <StackPanel Name="leftButtons" Orientation="Horizontal" DockPanel.Dock="Left" Margin="24,0,0,0">
              <Redbox:RoundedButton Name="go_back_button" Style="{StaticResource thin_border_button_style}" Height="56" Width="118" CornerRadius="28" Command="{x:Static localbase:Commands.GoBackCommand}" Focusable="False">
                <TextBlock Style="{StaticResource font_montserrat_extrabold_20}" Text="{Binding Path=DataContext.BackText, FallbackValue=BACK, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TitleDetailsUserControl}}}" />
              </Redbox:RoundedButton>
            </StackPanel>
            <StackPanel Name="rightButtons" Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="RightToLeft" Margin="0,0,24,0" Visibility="{Binding AddButtonBarVisibility, FallbackValue=Collapsed}">
              <Redbox:RoundedButton Name="buy_button" Style="{StaticResource rubine_no_border_button_style}" Margin="0,0,16,0" Height="56" Width="180" CornerRadius="28" Command="{x:Static localbase:Commands.BuyCommand}" Focusable="False" Visibility="{Binding ShowBuy, FallbackValue=Visible}">
                <StackPanel Orientation="Vertical" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock TextAlignment="Center" Style="{Binding BuyButtonBuyTextStyle, FallbackValue={StaticResource font_montserrat_extrabold_16}}" Text="{Binding BuyText, FallbackValue=OWN IT}" />
                  <TextBlock TextAlignment="Center" Style="{Binding BuyButtonBuyPriceTextStyle, FallbackValue={StaticResource font_montserrat_medium_20}}" Text="{Binding BuyPriceText, FallbackValue=$$$}" />
                </StackPanel>
              </Redbox:RoundedButton>
              <ItemsControl Name="FormatButtonsItemsControl" ItemsSource="{Binding ButtonData}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Redbox:RoundedButton Width="Auto" MinWidth="180" Height="56" HorizontalAlignment="Right" Margin="16,0,0,0" CornerRadius="28" Style="{StaticResource warm_purple_no_border_button_style}" Command="{x:Static localbase:Commands.PrimaryCommand}" CommandParameter="rent" Visibility="Visible" FlowDirection="LeftToRight" Tag="{Binding Format}" IsEnabled="{Binding IsEnabled}">
                      <StackPanel Orientation="Vertical" Margin="10,5,10,5">
                        <TextBlock Style="{StaticResource font_montserrat_extrabold_16}" HorizontalAlignment="Center" TextAlignment="Center" Text="{Binding Line1Text}" />
                        <TextBlock Style="{StaticResource SecondLineTextStyle}" HorizontalAlignment="Center" Text="{Binding Line2Text}" />
                      </StackPanel>
                    </Redbox:RoundedButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Name="comingSoonButtons" Orientation="Vertical" DockPanel.Dock="Right" FlowDirection="RightToLeft" Margin="0,5,0,0" Visibility="{Binding ComingSoonVisibility, FallbackValue=Collapsed}">
              <TextBlock Name="comingSoonDateText" Style="{StaticResource font_montserrat_medium_16}" HorizontalAlignment="Center" Foreground="#AC2C32" Text="{Binding ComingSoonLabelText, FallbackValue=Coming}" />
              <Redbox:RoundedButton Name="coming_soon_email_me" Style="{StaticResource classic_rubine_button_style}" Height="56" Width="180" CornerRadius="28" Command="{x:Static localbase:Commands.MoreInfoCommand}" Focusable="False">
                <TextBlock Style="{StaticResource font_montserrat_medium_20}" TextAlignment="Center" Text="{Binding ComingSoonButtonText, FallbackValue=Email me}" />
              </Redbox:RoundedButton>
            </StackPanel>
            <Grid Name="outOfStock" DockPanel.Dock="Right" Width="708" Margin="0,0,24,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding OutOfStockVisibility, FallbackValue=Visible}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Name="OutOfStockLine1" Grid.Row="0" TextAlignment="Right" LineHeight="28" Style="{StaticResource font_montserrat_semibold_20}" Foreground="#E42045" TextWrapping="Wrap" Text="{Binding OutOfStockLine1Text, FallbackValue=Out of Stock}" />
              <TextBlock Name="OutOfStockLines2_3" Grid.Row="1" TextAlignment="Right" LineHeight="24" Style="{StaticResource font_montserrat_regular_16}" Foreground="#060208" TextWrapping="Wrap">
                <TextBlock.Inlines>
                  <Run FontWeight="Bold" Text="{Binding OutOfStockLine2Text, FallbackValue=Text LOCATE to 727272}" /> <Run Text="{Binding OutOfStockLine3Text, FallbackValue=to find other Boxes nearby that might have this movie}" /></TextBlock.Inlines>
              </TextBlock>
              <TextBlock Name="OutOfStockLine4" Grid.Row="2" TextAlignment="Right" LineHeight="16" Style="{StaticResource font_montserrat_medium_12}" Foreground="#060208" TextWrapping="Wrap" Text="{Binding OutOfStockLine4Text, FallbackValue=You will get up to 2 messages. Msg. &amp; data rates may apply.}" />
            </Grid>
          </DockPanel>
        </Grid>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>