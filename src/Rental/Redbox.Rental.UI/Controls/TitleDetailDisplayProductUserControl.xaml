<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.TitleDetailDisplayProductUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Views" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localControls="clr-namespace:Redbox.Rental.UI.Controls" xmlns:wpf="http://schemas.microsoft.com/netfx/2009/xaml/presentation">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BitmapImage x:Key="DefaultImage" UriSource="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/movie-missing-image.png" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.InputBindings>
    <KeyBinding Key="D" Modifiers="Ctrl" Command="{x:Static localbase:Commands.StatisticsPopupCommand}" />
  </UIElement.InputBindings>
  <Grid Background="#00FFFFFF">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="512" />
          <ColumnDefinition Width="512" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition MaxHeight="140" Height="{Binding AdHeight}" />
          <RowDefinition MinHeight="490" MaxHeight="590" Height="{Binding MainHeight}" />
          <RowDefinition Height="138" />
        </Grid.RowDefinitions>
        <Grid Name="AdBanner" Row="0" ColumnSpan="2" Margin="0,0,20,0">
          <Image Name="AdImage" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Center" Height="90" Width="728" Source="{Binding AdImage}" Visibility="{Binding AdImageVisibility, FallbackValue=Collapsed}" />
        </Grid>
        <Grid Column="0" Row="1" Background="#FFFFFFFF">
          <Grid Margin="20,0,0,0">
            <Grid Margin="{Binding FlagMargin, FallbackValue=0}">
              <localControls:DisplayProductUserControl Margin="44,0,30,2" VerticalAlignment="Bottom" HorizontalAlignment="Center" ClipToBounds="False" />
            </Grid>
          </Grid>
        </Grid>
        <Grid Column="1" Row="1" Background="#FFFFFFFF">
          <DockPanel LastChildFill="True" Margin="20,0,0,0">
            <TextBlock Style="{StaticResource font_cooper_23}" DockPanel.Dock="Top" Margin="0,3,100,10" Foreground="#E42045" TextWrapping="Wrap" Text="{Binding Header, FallbackValue=HEADER}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0" DockPanel.Dock="Top">
              <Border BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding RatingVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_vag_light_10}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="{Binding Rating}" />
              </Border>
              <Border Margin="10,0,0,0" BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding FormatVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_vag_light_10}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="{Binding Format}" />
              </Border>
              <Border Margin="10,0,0,0" BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding RunningTimeVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_vag_light_10}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="{Binding RunningTime}" />
              </Border>
              <Border Margin="10,0,0,0" BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding ReleaseYearVisibility, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_vag_light_10}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="{Binding ReleaseYear}" />
              </Border>
              <Border Margin="10,0,0,0" BorderThickness="2" BorderBrush="#B7ADA5" Visibility="{Binding CCSupported, FallbackValue=Collapsed}">
                <TextBlock TextAlignment="Center" Style="{StaticResource font_vag_light_10}" FontWeight="Bold" Foreground="#8A7666" Margin="8,4,8,4" Text="CC" />
              </Border>
            </StackPanel>
            <StackPanel Name="ProductDetails" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="-10,0,0,2" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
              <Rectangle Height="3" Width="Auto" Stroke="#792D8D" StrokeThickness="0" RadiusX="0" RadiusY="0" Fill="#792D8D" Margin="0,2,108,0" />
              <DockPanel LastChildFill="True" Margin="0,0,0,0">
                <StackPanel Name="SubPlatForm" DockPanel.Dock="Right" Width="250" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding SubPlatformVisibility, FallbackValue=Visible}">
                  <Viewbox Stretch="Uniform" VerticalAlignment="Center" MaxHeight="110" Margin="4,0,0,0" HorizontalAlignment="Left">
                    <Image Stretch="Fill" Source="{Binding SubPlatformImage}" />
                  </Viewbox>
                </StackPanel>
                <Rectangle Height="Auto" Width="3" Stroke="#792D8D" StrokeThickness="0" RadiusX="0" RadiusY="0" Fill="#792D8D" DockPanel.Dock="Right" Visibility="{Binding SubPlatformVisibility, FallbackValue=Visible}" />
                <StackPanel DockPanel.Dock="Left" Margin="0,2,0,2">
                  <Grid Name="starring" Margin="10,1,0,1" Visibility="{Binding StarringVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_vag_dark_11}" Text="{Binding StarringLabel, FallbackValue=Starring:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_vag_light_11}" TextWrapping="Wrap" Text="{Binding Starring}" />
                  </Grid>
                  <Grid Name="genres" Margin="10,1,0,1" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_vag_dark_11}" Text="{Binding GenresLabel, FallbackValue=Category:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_vag_light_11}" TextWrapping="Wrap" Text="{Binding Genres, FallbackValue=ACTION}" />
                  </Grid>
                  <Grid Name="rating" Margin="10,1,0,1" Visibility="{Binding RatingVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_vag_dark_11}" Text="{Binding RatingLabel}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_vag_light_11}" TextWrapping="Wrap" Text="{Binding RatingDescription}" />
                  </Grid>
                  <Grid Name="extraNight" Margin="10,1,0,1" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_vag_dark_11}" Text="{Binding PriceLabel, FallbackValue=Price:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_vag_light_11}" TextWrapping="Wrap" Text="{Binding PriceADay}" />
                  </Grid>
                  <Grid Name="returnTime" Margin="10,1,0,1" Visibility="{Binding NotEmptyCaseVisibility, FallbackValue=Visible}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource font_vag_dark_11}" Text="{Binding ReturnTimeLabel, FallbackValue=ReturnTime:}" />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource font_vag_light_11}" TextWrapping="Wrap" Text="{Binding ReturnTime, FallbackValue=9PM}" />
                  </Grid>
                </StackPanel>
              </DockPanel>
              <Rectangle Height="3" Width="Auto" Stroke="#792D8D" StrokeThickness="0" RadiusX="0" RadiusY="0" Fill="#792D8D" Margin="0,0,108,2" />
            </StackPanel>
            <TextBlock Style="{StaticResource font_vag_light_11}" DockPanel.Dock="Top" Margin="0,20,108,10" TextWrapping="Wrap" TextOptions.TextFormattingMode="Display" Text="{Binding Description, FallbackValue=DESCRIPTION}" />
          </DockPanel>
        </Grid>
        <Grid Name="Buttons" ColumnSpan="2" Row="3" Margin="0,0,0,20">
          <DockPanel>
            <StackPanel Name="leftButtons" Orientation="Horizontal" DockPanel.Dock="Left">
              <localControls:RoundedButton x:Name="go_back_button" Style="{StaticResource white_rubinetopurple_border_button_style}" Margin="74,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="70" Width="146" CornerRadius="35" Command="{x:Static localbase:Commands.GoBackCommand}" Focusable="False">
                <Grid>
                  <DockPanel HorizontalAlignment="Left">
                    <Image Name="StartOverArrow" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/back-rubine-arrow.png" Width="28" Margin="6,0,0,0" HorizontalAlignment="Left" />
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="40,0,0,0">
                    <TextBlock Style="{StaticResource font_bryant_bold_24}" Foreground="#E42045" Text="{Binding Path=DataContext.BackText, FallbackValue=BACK, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:TitleDetailsUserControl}}}" />
                  </StackPanel>
                </Grid>
              </localControls:RoundedButton>
              <localControls:RoundedButton x:Name="collection_button" Style="{StaticResource charcoal_gray_no_border_button_style}" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="70" Width="276" CornerRadius="33" Command="{x:Static localbase:Commands.CollectionCommand}" Focusable="False" Visibility="{Binding ShowCollections}" IsEnabled="{Binding CollectionsEnabled}">
                <Grid>
                  <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource font_bryant_bold_18}" TextAlignment="Center" Text="{Binding CollectionTextLine1, FallbackValue=SEERELATEDCOLLECTIONS}" />
                  </StackPanel>
                </Grid>
              </localControls:RoundedButton>
            </StackPanel>
            <StackPanel Name="rightButtons" Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,15,0" FlowDirection="RightToLeft" Visibility="{Binding AddButtonBarVisibility, FallbackValue=Collapsed}">
              <localControls:RoundedButton x:Name="add_button_blu_ray" Margin="10,0,10,0" Style="{StaticResource warm_purple_no_border_button_style}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="70" Width="194" CornerRadius="35" Command="{x:Static localbase:Commands.BluRayCommand}" CommandParameter="rent,blu-ray" Focusable="False" Visibility="{Binding Path=ShowBluRay, FallbackValue=Visible}" IsEnabled="{Binding BluRayEnabled, FallbackValue=true}">
                <Grid>
                  <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FlowDirection="LeftToRight" Style="{StaticResource font_bryant_bold_24}" TextAlignment="Center" Text="{Binding BluRayText, FallbackValue=BLU-RAY}" />
                    <TextBlock FlowDirection="LeftToRight" Style="{StaticResource font_bryant_bold_14}" TextAlignment="Center" Visibility="{Binding BluRayOutOfStockVisibility, FallbackValue=Collapsed}" Text="{Binding BluRayLine2Text, FallbackValue=OUTOFSTOCK}" />
                  </StackPanel>
                </Grid>
              </localControls:RoundedButton>
              <localControls:RoundedButton x:Name="add_button_primary" Margin="10,0,10,0" Style="{StaticResource rubine_no_border_button_style}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="70" Width="160" CornerRadius="35" Command="{x:Static localbase:Commands.PrimaryCommand}" CommandParameter="rent,primary" Focusable="False" Visibility="{Binding ShowPrimary, FallbackValue=Visible}" IsEnabled="{Binding PrimaryEnabled, FallbackValue=true}">
                <Grid>
                  <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FlowDirection="LeftToRight" Style="{StaticResource font_bryant_bold_24}" TextAlignment="Center" Text="{Binding PrimaryText, FallbackValue=DVD}" />
                    <TextBlock FlowDirection="LeftToRight" Style="{StaticResource font_bryant_bold_14}" TextAlignment="Center" Visibility="{Binding PrimaryOutOfStockVisibility, FallbackValue=Collapsed}" Text="{Binding PrimaryLine2Text, FallbackValue=OUTOFSTOCK}" />
                  </StackPanel>
                </Grid>
              </localControls:RoundedButton>
              <localControls:RoundedButton x:Name="buy_button" Margin="10,0,10,0" Style="{StaticResource charcoal_gray_no_border_button_style}" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="47" Command="{x:Static localbase:Commands.BuyCommand}" Focusable="False" Height="{Binding BuyButtonHeight, FallbackValue=88}" Width="{Binding BuyButtonHeight, FallbackValue=88}" Visibility="{Binding ShowBuy, FallbackValue=Visible}">
                <Grid>
                  <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock TextAlignment="Center" Style="{Binding BuyButtonTextStyle, FallbackValue={StaticResource font_target_medium_small}}" Text="{Binding BuyText, FallbackValue=BUY}" />
                    <TextBlock FlowDirection="LeftToRight" Margin="0,1,0,0" TextAlignment="Center" Style="{Binding BuyButtonTextStyle, FallbackValue={StaticResource font_target_small_medium}}" Visibility="{Binding BuyPriceVisibility, FallbackValue=Collapsed}" Text="{Binding BuyPriceText, FallbackValue=$$$}" />
                  </StackPanel>
                </Grid>
              </localControls:RoundedButton>
            </StackPanel>
            <StackPanel Name="comingSoonButtons" Orientation="Vertical" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,15,0" FlowDirection="RightToLeft" Visibility="{Binding ComingSoonVisibility, FallbackValue=Collapsed}">
              <TextBlock Name="comingSoonDateText" Style="{StaticResource font_target_smaller_overlays}" FlowDirection="LeftToRight" HorizontalAlignment="Center" Foreground="#AC2C32" Text="{Binding ComingSoonLabelText, FallbackValue=SOOOOOON!!!!}" />
              <localControls:RoundedButton x:Name="coming_soon_email_me" Margin="10,0,10,0" Style="{StaticResource classic_rubine_button_style}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="70" Width="194" CornerRadius="33" Command="{x:Static localbase:Commands.MoreInfoCommand}" Focusable="False">
                <Grid>
                  <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FlowDirection="LeftToRight" Style="{StaticResource font_target_small_button_overlays}" TextAlignment="Center" Text="{Binding ComingSoonButtonText, FallbackValue=EMAILME}" />
                  </StackPanel>
                </Grid>
              </localControls:RoundedButton>
            </StackPanel>
            <Grid Name="outOfStock" Background="#FFFFFFFF" DockPanel.Dock="Right" Width="350" Margin="0,0,20,0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="{Binding OutOfStockVisibility, FallbackValue=Visible}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Name="OutOfStockLine1" Grid.Row="0" Margin="20,0,0,0" Style="{StaticResource font_montserrat_bold_21}" Foreground="#E42045" TextWrapping="Wrap" Text="{Binding OutOfStockLine1Text, FallbackValue=TEXT!}" />
              <TextBlock Name="OutOfStockLine2" Grid.Row="1" Margin="20,4,0,4" Style="{StaticResource font_montserrat_regular_16}" Foreground="#E42045" TextWrapping="Wrap" Text="{Binding OutOfStockLine2Text, FallbackValue=NOW!}" />
              <TextBlock Name="OutOfStockLine3" Grid.Row="2" Margin="20,0,0,0" Style="{StaticResource font_montserrat_regular_11}" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding OutOfStockLine3Text, FallbackValue=TERMS_APPLY}" />
            </Grid>
          </DockPanel>
        </Grid>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>