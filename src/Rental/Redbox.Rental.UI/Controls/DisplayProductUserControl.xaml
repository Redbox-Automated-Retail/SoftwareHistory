<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.DisplayProductUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localModels="clr-namespace:Redbox.Rental.UI.Models" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" DataContextChanged="UserControl_DataContextChanged" SizeChanged="UserControl_SizeChanged">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="ImageBorderSolidColorBrush" Color="{Binding Path=ImageBorderColor}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainGrid" Background="{Binding Path=BackgroundBrush, FallbackValue=Transparent}">
    <local:AspectRatioLayoutDecorator x:Name="MainAspectRatioLayoutDecorator" AspectRatio="0.7219512195121951" LockAspectRatio="{Binding Path=LockAspectRatio}">
      <Border Name="ImageBorder" BorderBrush="{StaticResource ImageBorderSolidColorBrush}" CornerRadius="{Binding Path=ImageBorderCornerRadius}" BorderThickness="{Binding Path=ImageBorderThickness}">
        <Grid>
          <local:Flag x:Name="Flag" Width="200" Height="60" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-30,-30,0,0" Visibility="{Binding Path=DisplayFlagVisibility}" Style="{Binding Path=FlagStyle, FallbackValue={StaticResource red_flag_style}}">
            <Viewbox Visibility="{Binding Path=DisplayFlagVisibility}">
              <TextBlock Name="FlagText" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_bold_13}" Margin="0,2,0,2" Text="{Binding Path=FlagText}" />
            </Viewbox>
          </local:Flag>
          <local:AspectRatioLayoutDecorator AspectRatio="0.7219512195121951" LockAspectRatio="{Binding Path=LockAspectRatio}" Visibility="{Binding Path=ImageBackgroundVisibility, FallbackValue=Collapsed}">
            <Grid Name="ImageBackground" Background="#1E1E1E" />
          </local:AspectRatioLayoutDecorator>
          <local:AspectRatioLayoutDecorator AspectRatio="0.7219512195121951" LockAspectRatio="{Binding Path=LockAspectRatio}">
            <Image Name="DisplayProductImage" Stretch="Fill" Source="{Binding Path=Image}" Opacity="{Binding Path=DisplayImageOpacity}">
              <UIElement.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.BrowseItemSelectedCommand}" />
              </UIElement.InputBindings>
            </Image>
          </local:AspectRatioLayoutDecorator>
          <Grid Name="BannerGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="0.14*" />
              <RowDefinition Height="0.14*" />
              <RowDefinition Height="0.14*" />
            </Grid.RowDefinitions>
            <Grid Name="Banner" Row="3" RowSpan="2" Visibility="{Binding Path=BannerVisibility}" Background="{Binding Path=BannerBackgroundBrush}">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="1.2*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Viewbox Name="BannerTextViewBox" Grid.Row="1">
                <TextBlock Name="BannerText" Foreground="#FFFFFFFF" Style="{StaticResource font_montserrat_bold_13}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Path=BannerText}" />
              </Viewbox>
            </Grid>
            <Grid Name="ComingSoonButtonGrid" Row="2" RowSpan="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="89*" />
                <RowDefinition Height="10*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="96*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <local:RoundedButton x:Name="ComingSoonButton" Command="{x:Static localbase:Commands.BrowseItemAddCommand}" CommandParameter="ComingSoon" Grid.Row="1" Grid.Column="1" UsedDefaultCornerRadius="True" Style="{Binding Path=ComingSoonButtonStyle, FallbackValue={StaticResource rubine_white_border_button_style}}" Visibility="{Binding Path=ComingSoonButtonVisibility}">
                <Grid>
                  <DockPanel LastChildFill="True">
                    <Viewbox DockPanel.Dock="Right">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="10*" />
                          <ColumnDefinition Width="90*" />
                        </Grid.ColumnDefinitions>
                        <UserControl Style="{StaticResource green_check_mark_style}" Grid.Column="1" Visibility="{Binding Path=ComingSoonButtonCheckMarkVisibility}" />
                      </Grid>
                    </Viewbox>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="25*" />
                        <RowDefinition Height="50*" />
                        <RowDefinition Height="25*" />
                      </Grid.RowDefinitions>
                      <Viewbox Grid.Row="1">
                        <TextBlock Name="ComingSoonButtonText" Style="{StaticResource font_target_small_button_overlays}" Text="{Binding Path=ComingSoonButtonText, FallbackValue=Email Me}" />
                      </Viewbox>
                    </Grid>
                  </DockPanel>
                </Grid>
              </local:RoundedButton>
            </Grid>
          </Grid>
          <local:RoundedButton x:Name="AddButton" Style="{StaticResource rubine_white_border_button_style}" Command="{x:Static localbase:Commands.BrowseItemAddCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="220" Height="68" CornerRadius="34" Margin="0,0,-25,-25" Focusable="False" Opacity="{Binding Path=AddButtonOpacity}" Visibility="{Binding Path=AddButtonVisibility, FallbackValue=Visible}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="25*" />
                <RowDefinition Height="50*" />
                <RowDefinition Height="25*" />
              </Grid.RowDefinitions>
              <Viewbox Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                  <UserControl Style="{StaticResource plus_sign_style}" />
                  <TextBlock Name="AddButtonText" VerticalAlignment="Center" Margin="5" Style="{StaticResource font_bryant_bold_18}" Text="{Binding Path=AddButtonLabelText, FallbackValue=RENT IT NOW!}" />
                </StackPanel>
              </Viewbox>
            </Grid>
          </local:RoundedButton>
          <Grid Name="CornerAddButtonShadowGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="63*" />
              <RowDefinition Height="37*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="47*" />
              <ColumnDefinition Width="53*" />
            </Grid.ColumnDefinitions>
            <Grid Name="CornerShadow" Row="1" Column="1" Visibility="{Binding Path=DisplayCornerAddButtonVisibility}">
              <UIElement.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.BrowseItemAddCommand}" />
              </UIElement.InputBindings>
              <Panel.Background>
                <LinearGradientBrush StartPoint="0.5,0.5" EndPoint="1,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#AF101010" Offset="0.75" />
                  <GradientStop Color="#BF101010" Offset="1" />
                </LinearGradientBrush>
              </Panel.Background>
            </Grid>
          </Grid>
          <Grid Name="CornerAddButtonGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="81*" />
              <RowDefinition Height="19.2*" />
              <RowDefinition Height="0.8*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="71.5*" />
              <ColumnDefinition Width="27*" />
              <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>
            <Grid Row="1" Column="1" />
            <local:RoundedButton x:Name="CornerAddButton" Grid.Row="1" Grid.Column="1" Command="{x:Static localbase:Commands.BrowseItemAddCommand}" UsedDefaultCornerRadius="True" Focusable="False" Style="{Binding Path=AddButtonStyle, FallbackValue={StaticResource rubine_no_border_button_style}}" Visibility="{Binding Path=DisplayCornerAddButtonVisibility}" />
            <Grid Row="1" Column="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="15*" />
                <RowDefinition Height="70*" />
                <RowDefinition Height="15*" />
              </Grid.RowDefinitions>
              <Viewbox Grid.Row="1">
                <TextBlock Name="CornerAddButtonText" IsHitTestVisible="False" HorizontalAlignment="Center" Style="{StaticResource font_target_large}" Foreground="#FFFFFFFF" Text="{Binding Path=CornerAddButtonText, FallbackValue=10}" Visibility="{Binding Path=AddButtonTextVisibility}" />
              </Viewbox>
            </Grid>
            <Grid Row="1" Column="1" Visibility="{Binding Path=DisplayCornerAddButtonVisibility}">
              <Grid.RowDefinitions>
                <RowDefinition Height="14*" />
                <RowDefinition Height="72*" />
                <RowDefinition Height="14*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14*" />
                <ColumnDefinition Width="72*" />
                <ColumnDefinition Width="14*" />
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Row="1" Grid.Column="1">
                <UserControl Name="CornerAddButtonPlusSign" Style="{StaticResource plus_sign_style}" IsHitTestVisible="False" Visibility="{Binding Path=AddButtonPlusSignVisibility}" />
              </Viewbox>
            </Grid>
          </Grid>
          <local:RoundedButton x:Name="CancelButton" Style="{StaticResource classic_gray_button_style}" Command="{x:Static localbase:Commands.BrowseItemCancelCommand}" BorderColor="#970E16" BorderGradientColor="#970E16" BorderThickness="10" HorizontalAlignment="Right" VerticalAlignment="Top" UsedDefaultCornerRadius="True" Width="150" Height="150" Margin="0,-50,-55,0" Visibility="{Binding Path=CancelButtonVisibility}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="20*" />
                <RowDefinition Height="60*" />
                <RowDefinition Height="20*" />
              </Grid.RowDefinitions>
              <Viewbox Grid.Row="1">
                <TextBlock Style="{StaticResource font_montserrat_bold_24}">X</TextBlock>
              </Viewbox>
            </Grid>
          </local:RoundedButton>
        </Grid>
      </Border>
    </local:AspectRatioLayoutDecorator>
    <Viewbox Name="ADAMiniCartAddButtonViewbox" Visibility="{Binding Path=ADAMiniCartAddButtonVisibility}">
      <Grid>
        <local:RoundedButton x:Name="ADAMiniCartAddButton" Style="{StaticResource rubine_white_border_button_style}" Command="{x:Static localbase:Commands.BrowseItemAddCommand}" BorderThickness="12" Width="280" Height="280" CornerRadius="140" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="15*" />
            <RowDefinition Height="70*" />
            <RowDefinition Height="15*" />
          </Grid.RowDefinitions>
          <Viewbox Grid.Row="1">
            <TextBlock Name="ADAMiniCartAddButtonText" IsHitTestVisible="False" Style="{StaticResource font_target_large}" Foreground="#FFFFFFFF" Text="{Binding Path=ADAMiniCartAddButtonText, FallbackValue=10}" />
          </Viewbox>
        </Grid>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>