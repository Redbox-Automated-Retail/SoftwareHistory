<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.Animations.SwipeCreditsUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls.Animations">
  <Grid Background="#B5121B" Width="2048">
    <Image Name="background_image" Margin="0,0,0,0" Width="1024" Height="536" VerticalAlignment="Top" HorizontalAlignment="Left" Source="pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/Credit swipe background.png" />
    <local:SwipeHandAndCardUserControl x:Name="Hand" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="675,20" />
    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="75" TextBlock.Foreground="#FFFFFFFF" Width="550">
      <TextBlock Name="TitleTextBlock" TextWrapping="Wrap" Style="{StaticResource font_target_medium_2}">Culture specific swipe title goes here at runtime</TextBlock>
      <TextBlock Name="MessageTextBlock" Style="{StaticResource font_target_small}" Text="Culture specific swipe message&#xA; goes here at runtime" />
    </StackPanel>
  </Grid>
</UserControl>