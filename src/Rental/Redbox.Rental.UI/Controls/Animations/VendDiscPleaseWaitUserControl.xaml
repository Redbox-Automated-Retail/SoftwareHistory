<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.Animations.VendDiscPleaseWaitUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls.Animations">
  <Grid Background="#B5121B">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#FFFFFFFF">
      <TextBlock Name="TitleTextBlock" Style="{StaticResource font_target_large}" Width="430" TextAlignment="Center" TextWrapping="Wrap">Culture specific title</TextBlock>
      <TextBlock Name="MessageTextBlock" Margin="20" Style="{StaticResource font_target_not_as_large_overlays}" TextAlignment="Center">Culture specific message goes here at runtime</TextBlock>
    </StackPanel>
  </Grid>
</UserControl>