<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.Animations.VendDiscAnimationUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls.Animations" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <Grid Background="#00FFFFFF" Width="2048">
    <local:RedChevronUserControl x:Name="RedChevron" VerticalAlignment="Top" HorizontalAlignment="Left" ChevronColor="#FFFFFFFF" ChevronOpacity="0.1" />
    <Redbox:GridExt RowHeights="auto,auto" VerticalAlignment="Center">
      <Redbox:GridExt Row="0" RowHeights="auto" Width="1024" HorizontalAlignment="Left">
        <StackPanel Name="VendDiscPickup" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#FFFFFFFF" Visibility="Collapsed">
          <TextBlock Name="TitleTextBlock1" Style="{StaticResource font_montserrat_bold_40}" TextWrapping="Wrap" Text="Your rentals are on their way!" />
          <TextBlock Name="MessageTextBlock1" Style="{StaticResource font_montserrat_regular_14}" TextWrapping="Wrap" Text="Your card will only be charged once." />
        </StackPanel>
      </Redbox:GridExt>
      <Redbox:GridExt Name="VendDiscServe" Row="1" RowHeights="auto,auto" HorizontalAlignment="Left" Width="1024" TextBlock.Foreground="#FFFFFFFF" Visibility="Visible">
        <Redbox:GridExt Name="MessageGridBlock2" Row="0" ColumnWidths="85,*" RowHeights="80" Margin="259,0,0,0">
          <UserControl Name="MessageCheck2" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource white_check_mark_style}" />
          <TextBlock Name="MessageTextBlock2" Grid.Column="1" Style="{StaticResource font_montserrat_bold_40}" VerticalAlignment="Center" TextWrapping="Wrap" Text="Serving up your discs" />
        </Redbox:GridExt>
        <Redbox:GridExt Name="MessageGridBlock3" Row="1" ColumnWidths="85,*" RowHeights="80" Margin="259,0,0,0">
          <UserControl Name="MessageCheck3" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource white_check_mark_style}" />
          <TextBlock Name="MessageTextBlock3" Grid.Column="1" Style="{StaticResource font_montserrat_bold_40}" VerticalAlignment="Center" TextWrapping="Wrap" Text="You've been signed out" />
        </Redbox:GridExt>
      </Redbox:GridExt>
    </Redbox:GridExt>
  </Grid>
</UserControl>