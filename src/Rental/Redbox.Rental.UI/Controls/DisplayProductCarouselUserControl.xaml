<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.DisplayProductCarouselUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localModels="clr-namespace:Redbox.Rental.UI.Models" x:Name="DisplayProductCarousel" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" DataContextChanged="UserControl_DataContextChanged">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="ImageBorderSolidColorBrush" Color="{Binding Path=ImageBorderColor, ElementName=DisplayProductCarousel, FallbackValue=Gray}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainGrid" Background="{Binding Path=BackgroundBrush, FallbackValue=Transparent}">
    <local:AspectRatioLayoutDecorator x:Name="MainAspectRatioLayoutDecorator" AspectRatio="0.6666666666666667" LockAspectRatio="{Binding Path=LockAspectRatio}">
      <Border Name="ImageBorder" BorderBrush="{StaticResource ImageBorderSolidColorBrush}" BorderThickness="{Binding Path=ImageBorderThickness, ElementName=DisplayProductCarousel, FallbackValue=0}">
        <Grid>
          <local:AspectRatioLayoutDecorator AspectRatio="0.6666666666666667" LockAspectRatio="{Binding Path=LockAspectRatio}" Visibility="{Binding Path=ImageBackgroundVisibility, FallbackValue=Collapsed}">
            <Grid Name="ImageBackground" Background="#1E1E1E" />
          </local:AspectRatioLayoutDecorator>
          <local:AspectRatioLayoutDecorator AspectRatio="0.6666666666666667" LockAspectRatio="{Binding Path=LockAspectRatio}">
            <Image Name="DisplayProductImage" Stretch="Fill" Source="{Binding Path=Image, FallbackValue='pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/movie-missing-image.png'}" Opacity="{Binding Path=DisplayImageOpacity}">
              <UIElement.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.BrowseItemSelectedCommand}" />
              </UIElement.InputBindings>
            </Image>
          </local:AspectRatioLayoutDecorator>
          <Border Name="ImageShader" Background="#FF000000" IsHitTestVisible="False" Opacity="{Binding ShaderOpacity, ElementName=DisplayProductCarousel, FallbackValue=0}" />
          <UIElement.Effect>
            <DropShadowEffect Direction="270" Color="Black" BlurRadius="25" Opacity="0" ShadowDepth="{Binding ShadowDepth, ElementName=DisplayProductCarousel, FallbackValue=10}" />
          </UIElement.Effect>
        </Grid>
      </Border>
    </local:AspectRatioLayoutDecorator>
  </Grid>
</UserControl>