<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.Rental.UI.Controls.DisplayProductCarouselUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.Rental.UI.Controls" xmlns:localbase="clr-namespace:Redbox.Rental.UI" xmlns:localModels="clr-namespace:Redbox.Rental.UI.Models" x:Name="DisplayProductCarousel" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" DataContextChanged="UserControl_DataContextChanged" SizeChanged="UserControl_SizeChanged">
  <Grid Name="MainGrid" Background="{Binding Path=BackgroundBrush, FallbackValue=Transparent}">
    <local:AspectRatioLayoutDecorator x:Name="MainAspectRatioLayoutDecorator" AspectRatio="0.6666666666666667" LockAspectRatio="{Binding Path=LockAspectRatio}">
      <Grid>
        <local:AspectRatioLayoutDecorator AspectRatio="0.6666666666666667" LockAspectRatio="{Binding Path=LockAspectRatio}" Visibility="{Binding Path=ImageBackgroundVisibility, FallbackValue=Collapsed}">
          <Grid Name="ImageBackground" Background="#1E1E1E" />
        </local:AspectRatioLayoutDecorator>
        <local:AspectRatioLayoutDecorator AspectRatio="0.6666666666666667" LockAspectRatio="{Binding Path=LockAspectRatio}">
          <Image Name="DisplayProductImage" Stretch="Fill" Source="{Binding Path=Image, FallbackValue='pack://Application:,,,/Redbox.Rental.UI;component/Assets/Images/movie-missing-image.png'}" Opacity="{Binding Path=DisplayImageOpacity}">
            <UIElement.InputBindings>
              <MouseBinding Gesture="LeftClick" Command="{x:Static localbase:Commands.BrowseItemSelectedCommand}" />
            </UIElement.InputBindings>
          </Image>
        </local:AspectRatioLayoutDecorator>
        <Border Name="ImageShader" Background="#FF000000" IsHitTestVisible="False" Opacity="{Binding ShaderOpacity, ElementName=DisplayProductCarousel, FallbackValue=0}" />
        <UIElement.Effect>
          <DropShadowEffect Direction="270" Color="Black" BlurRadius="25" ShadowDepth="{Binding ShadowDepth, ElementName=DisplayProductCarousel, FallbackValue=10}" Opacity="{Binding ShadowOpacity, ElementName=DisplayProductCarousel, FallbackValue=0.75}" />
        </UIElement.Effect>
      </Grid>
    </local:AspectRatioLayoutDecorator>
    <UIElement.OpacityMask>
      <LinearGradientBrush StartPoint="{Binding OpacityMaskStartPoint, ElementName=DisplayProductCarousel, Mode=OneWay, FallbackValue='0.5,0'}" EndPoint="{Binding OpacityMaskEndPoint, ElementName=DisplayProductCarousel, FallbackValue='-0.1,0'}">
        <GradientBrush.GradientStops>
          <GradientStop Color="Black" Offset="{Binding OpacityMaskGradientOpaqueStop, ElementName=DisplayProductCarousel, FallbackValue=0}" />
          <GradientStop Color="Transparent" Offset="{Binding OpacityMaskGradientTransparentStop, ElementName=DisplayProductCarousel, FallbackValue=0.5}" />
        </GradientBrush.GradientStops>
      </LinearGradientBrush>
    </UIElement.OpacityMask>
  </Grid>
</UserControl>