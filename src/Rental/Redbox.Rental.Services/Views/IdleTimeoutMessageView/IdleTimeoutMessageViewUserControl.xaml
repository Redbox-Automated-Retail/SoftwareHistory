<?xml version="1.0" encoding="utf-8"?>
<controls:TextToSpeechUserControl x:Class="Redbox.Rental.Services.Views.IdleTimeoutMessageView.IdleTimeoutMessageViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.Rental.Services.Views.IdleTimeoutMessageView" xmlns:Views="clr-namespace:Redbox.Rental.Services.Views" xmlns:controls="clr-namespace:Redbox.Rental.Services.Views.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="font_target_large_overlays" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="pack://Application:,,,/Redbox.Rental.Services;component/Views/Assets/Fonts/#Target Alt Regular" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontWeight" Value="Regular" />
      </Style>
      <Style x:Key="font_target_small_button_overlays" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="pack://Application:,,,/Redbox.Rental.Services;component/Views/Assets/Fonts/#Target Alt Regular" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontWeight" Value="Regular" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.CommandBindings>
    <CommandBinding Command="{x:Static local:Commands.Yes}" Executed="YesCommandBinding_Executed" />
    <CommandBinding Command="{x:Static local:Commands.No}" Executed="NoCommandBinding_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <Grid Background="#FF000000" Opacity="0.6" />
    <Grid Margin="128, 96,128, 96">
      <Border Background="#FFFFFFFF" CornerRadius="28" BorderBrush="#A21018" BorderThickness="5">
        <TextBlock Name="MessageText" Text="Culture Specific Message" Margin="62,46" Foreground="#B5121B" Style="{StaticResource font_target_large_overlays}" />
      </Border>
      <Border Name="NoButton" Margin="62,482,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="32" BorderBrush="#FFD3D3D3" BorderThickness="2" Width="191" Height="66">
        <UIElement.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{x:Static local:Commands.No}" />
        </UIElement.InputBindings>
        <Border.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#969494" Offset="0" />
            <GradientStop Color="#676666" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Name="ButtonNo_Text" Style="{StaticResource font_target_small_button_overlays}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Nope" />
      </Border>
      <Border Name="YesButton" Margin="535,482,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="32" BorderBrush="#860C13" BorderThickness="3" Width="171" Height="66">
        <UIElement.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{x:Static local:Commands.Yes}" />
        </UIElement.InputBindings>
        <Border.Background>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#B50E1B" Offset="0" />
            <GradientStop Color="#8F0E15" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <TextBlock Name="ButtonYes_Text" Style="{StaticResource font_target_small_button_overlays}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="Yup" />
      </Border>
    </Grid>
  </Grid>
</controls:TextToSpeechUserControl>