<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.ProxyService.PersonalizationServiceUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.ProxyService" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#008B8B" DockPanel.Dock="Top" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="LiveCallCheckBox" Grid.Row="0" IsChecked="{Binding Path=LiveCall}">
              <TextBlock Text="Live Call (Update Account)" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <TextBlock Text="Update Account Error" Grid.Row="1" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <ComboBox Name="UpdateAccountErrorComboBox" Grid.Row="1" Grid.Column="1" MaxDropDownHeight="200" Width="250" HorizontalAlignment="Left" Margin="0,3" SelectedItem="{Binding Path=UpdateAccountError}" />
          <TextBlock Text="Customer Profile Number" Grid.Row="2" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="CustomerProfileNumberTextbox" Grid.Row="2" Grid.Column="1" Width="180" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=CustomerProfileNumber}" />
          <TextBlock Text="Mobile Phone Number" Grid.Row="3" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="MobilePhoneNumberTextbox" Grid.Row="3" Grid.Column="1" Width="180" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=MobilePhoneNumber}" />
          <TextBlock Text="Temp Password" Grid.Row="4" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="TempPasswordTextbox" Grid.Row="4" Grid.Column="1" Width="180" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=TempPassword}" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>