<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.ProxyService.LoginResultRecommendedTitlesUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.ProxyService">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:RecommendedTitleIdTypeConverter x:Key="ConverterRecommendedTitleTypeId" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#008B8B" DockPanel.Dock="Top" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="Tivo Query Id" Grid.Row="0" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="TivoQueryIdTextbox" Grid.Row="0" Grid.Column="1" Width="300" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=TivoQueryId}" />
          <TextBlock Text="Offer Code" Grid.Row="1" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="OfferCodeTextbox" Grid.Row="1" Grid.Column="1" Width="300" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=OfferCode}" />
          <RadioButton Name="ProductGroupIdsRadioButton" Grid.Row="2" Grid.Column="1" Content="Product Group ids" Width="120" GroupName="RecommendedTitleTypeId" HorizontalAlignment="Left" IsChecked="{Binding Path=RecommendedTitleTypeId, ConverterParameter=ProductGroupID, Converter={StaticResource ConverterRecommendedTitleTypeId}}" />
          <RadioButton Name="TitleIds" Grid.Row="2" Grid.Column="1" Content="Title ids" GroupName="RecommendedTitleTypeId" Margin="150,0" HorizontalAlignment="Left" IsChecked="{Binding Path=RecommendedTitleTypeId, ConverterParameter=TitleID, Converter={StaticResource ConverterRecommendedTitleTypeId}}" />
          <TextBlock Text="Title/Group Ids" Grid.Row="3" FontSize="10" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
            <TextBox Name="TitleIdsTextbox" Width="300" Height="18" VerticalAlignment="Center" Margin="5" Text="{Binding Path=Ids}" />
            <TextBlock Text="(Comma delimited list)" FontSize="10" Margin="5" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Tags For EachTitle (Example" Grid.Row="4" FontSize="10" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1">
            <TextBox Name="TagsTextbox" Width="300" Height="18" VerticalAlignment="Center" Margin="5" Text="{Binding Path=Tags}" />
            <TextBlock Text="(Space split array list)" FontSize="10" Margin="5" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>