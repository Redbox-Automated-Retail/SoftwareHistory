<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.ProxyService.LoginResultsSubscriptionUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.ProxyService" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#008B8B" DockPanel.Dock="Top" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="15" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="Eligible Subscription Ids" Grid.Row="1" FontSize="10" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
            <TextBox Name="EligibleSubscriptionPlanIdsTextbox" Width="340" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=EligibleSubscriptionPlanIds}" />
            <TextBlock Text="(CSV)" Grid.Row="11" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0" />
          </StackPanel>
          <TextBlock Text="Active Starz Subscription Id" Grid.Row="2" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="ActiveStarzSubscriptionIdTextbox" Grid.Row="2" Grid.Column="1" Width="340" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3" Text="{Binding Path=ActiveStarzSubscriptionPlanId}" />
          <TextBlock Text="Redbox+ Subscription Id" Grid.Row="4" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="RedboxPlusSubscriptionIdTextbox" Grid.Row="4" Grid.Column="1" Width="340" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3" Text="{Binding Path=RedboxPlusSubscriptionPlanId}" />
          <TextBlock Text="Redbox+ Subscription Campaign Id" Grid.Row="5" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="RedboxPlusSubscriptionCampaignIdTextbox" Grid.Row="5" Grid.Column="1" Width="340" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3" Text="{Binding Path=RedboxPlusSubscriptionCampaignId}" />
          <TextBlock Text="Redbox+ Subscription Tier" Grid.Row="6" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <ComboBox Name="RedboxPlusSubscriptionTierComboBox" Grid.Row="6" Grid.Column="1" MaxDropDownHeight="200" Width="350" HorizontalAlignment="Left" Margin="0,3" SelectedItem="{Binding Path=RedboxPlusSubscriptionTier}" />
          <TextBlock Text="Redbox+ Subscription Status" Grid.Row="7" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <ComboBox Name="RedboxPlusSubscriptionStatusComboBox" Grid.Row="7" Grid.Column="1" MaxDropDownHeight="200" Width="350" HorizontalAlignment="Left" Margin="0,3" SelectedItem="{Binding Path=RedboxPlusSubscriptionStatus}" />
          <TextBlock Text="Redbox+ Subscription End Date" Grid.Row="8" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="RedboxPlusSubscriptionEndDateTextbox" Grid.Row="8" Grid.Column="1" Width="340" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3" Text="{Binding Path=RedboxPlusSubscriptionEndDate}" />
          <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock Text="Redbox+ Free 1-night rental available" FontSize="10" VerticalAlignment="Center" Margin="5" />
            <CheckBox Name="RedboxPlusFree1NightRentalAvailableCheckBox" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left" Margin="0,3" IsChecked="{Binding Path=RedboxPlusFree1NightRentalAvailable}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>