<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.ProxyService.MarketingServiceUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.ProxyService" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#008B8B" DockPanel.Dock="Top" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="LiveCallCheckBox" IsChecked="{Binding Path=LiveCall}">
              <TextBlock Text="Live Call (SendEmailConfirm)" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="CommunicationFailureCheckBox" IsChecked="{Binding Path=CommunicationFailure}">
              <TextBlock Text="Communication Failure" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <TextBlock Text="Confirmation Status" Grid.Row="2" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <ComboBox Name="ConfirmationStatusComboBox" Grid.Row="2" Grid.Column="1" MaxDropDownHeight="200" Width="200" HorizontalAlignment="Left" Margin="0,3" SelectedItem="{Binding Path=ConfirmationStatus}" />
          <TextBlock Text="Customer Profile Number" Grid.Row="3" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="CustomerProfileNumberTextbox" Grid.Row="3" Grid.Column="1" Width="150" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3" Text="{Binding Path=CustomerProfileNumber}" />
          <TextBlock Text="Mobile Phone Number" Grid.Row="4" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="MobilePhoneNumberTextbox" Grid.Row="4" Grid.Column="1" Width="150" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3" Text="{Binding Path=MobilePhoneNumber}" />
          <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="EmailVerifiedCheckBox" IsThreeState="True" IsChecked="{Binding Path=EmailVerified}">
              <TextBlock Text="Email Verified" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="PromptForPerksCheckBox" IsChecked="{Binding Path=PromptForPerks}">
              <TextBlock Text="Prompt For Perks" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="PromptForEarlyIdCheckBox" IsChecked="{Binding Path=PromptForEarlyId}">
              <TextBlock Text="Prompt For Early Id" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="TextClubEnabledCheckBox" IsChecked="{Binding Path=TextClubEnabled}">
              <TextBlock Text="Text Club Enabled" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>