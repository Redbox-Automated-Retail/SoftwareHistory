<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.ProxyService.LoyaltyServiceUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.ProxyService" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#008B8B" DockPanel.Dock="Top" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="LiveCallCheckBox" Grid.Row="1" IsChecked="{Binding Path=LiveCall}">
              <TextBlock Text="Live Call (Estimate Accrual points and Estimate Redemption points)" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="SimulateAccrualSuccessCheckBox" IsChecked="{Binding Path=SimulateAccrualSuccess}">
              <TextBlock Text="Simulate Accrual Success" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <TextBlock Text="Accrual Error" Grid.Row="2" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <ComboBox Name="AccrualErrorComboBox" Grid.Row="2" Grid.Column="1" MaxDropDownHeight="200" Width="250" HorizontalAlignment="Left" Margin="0,3" SelectedItem="{Binding Path=AccrualError}" />
          <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Left" Margin="0,3" Grid.ColumnSpan="2">
            <CheckBox Name="SimulateRedemptionSuccessCheckBox" IsChecked="{Binding Path=SimulateRedemptionSuccess}">
              <TextBlock Text="Simulate Redemption Success" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <TextBlock Text="Redemption Error" Grid.Row="4" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <ComboBox Name="RedemptionErrorComboBox" Grid.Row="4" Grid.Column="1" MaxDropDownHeight="200" Width="250" HorizontalAlignment="Left" Margin="0,3" SelectedItem="{Binding Path=RedemptionError}" />
          <TextBlock Text="Default Accrual Value" Grid.Row="5" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="DefaultAccrualValueTextbox" Grid.Row="5" Grid.Column="1" Width="80" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=DefaultAccrualValue}" />
          <TextBlock Text="Default Redemption Value" Grid.Row="6" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="DefaultRedemptionValueTextbox" Grid.Row="6" Grid.Column="1" Width="80" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=DefaultRedemptionValue}" />
          <TextBlock Text="Shopping Cart Item Accruals/Redemptions" Grid.Row="7" Grid.ColumnSpan="2" FontSize="10" VerticalAlignment="Center" Margin="0,10,0,0" />
          <DataGrid Name="ShoppingCartItemsDataGrid" Grid.Row="8" Grid.ColumnSpan="2" HorizontalAlignment="Left" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" ItemsSource="{Binding ItemModels}">
            <DataGrid.Columns>
              <DataGridTextColumn x:Name="ProductIdColumn" Header="Product Id" Width="120" IsReadOnly="True" Binding="{Binding ProductId}" />
              <DataGridTextColumn x:Name="ProductNameColumn" Header="Name" Width="200" IsReadOnly="True" Binding="{Binding Name}" />
              <DataGridTextColumn x:Name="AccrualPointsColumn" Header="Accrual Points" Binding="{Binding AccrualPoints}" />
              <DataGridTextColumn x:Name="RedemptionPointsColumn" Header="Redemption Points" Binding="{Binding RedemptionPoints}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>