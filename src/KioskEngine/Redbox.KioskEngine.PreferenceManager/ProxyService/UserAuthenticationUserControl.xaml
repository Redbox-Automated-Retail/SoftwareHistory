<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.ProxyService.UserAuthenticationUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.ProxyService" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#008B8B" DockPanel.Dock="Top" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="24" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3">
            <CheckBox Name="LiveCallCheckBox" Grid.Row="1" IsChecked="{Binding Path=LiveCall}">
              <TextBlock Text="Live Call" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3">
            <CheckBox Name="SimulateCommunicationsFailureCheckBox" Grid.Row="1" IsChecked="{Binding Path=SimulateCommunicationsFailure}">
              <TextBlock Text="Simulate Communications Failure" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <TextBlock Text="User Name" Grid.Row="3" Margin="30,0,0,0" />
          <TextBox Name="UserNameTextBox" Grid.Row="3" Grid.Column="1" Width="200" HorizontalAlignment="Left" />
          <TextBlock Text="Response" Grid.Row="4" Margin="30,5,0,0" />
          <ComboBox Name="ResponseComboBox" Grid.Row="4" Grid.Column="1" Width="200" Height="22" HorizontalAlignment="Left" Margin="0,3,0,0" />
          <Button Name="AddButton" Content="Add User" Grid.Row="5" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0" Click="AddButton_Click" />
          <TextBlock Text="Users" Grid.Row="6" Grid.Column="0" Margin="0,20,0,0" />
          <DataGrid Name="UserAuthenticationResponsesGrid" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Height="150" Width="500" IsReadOnly="True" SelectionMode="Single" HorizontalAlignment="Left" AutoGenerateColumns="False" ItemsSource="{Binding Path=UserAuthenticationResponses}">
            <DataGrid.Columns>
              <DataGridTextColumn x:Name="UserNameColumn" Header="User Name" Width="200" Binding="{Binding UserName}" />
              <DataGridTextColumn x:Name="ResponseColumn" Header="Authentication Response" Binding="{Binding AuthenticationResponse}" />
            </DataGrid.Columns>
          </DataGrid>
          <Button Name="DeleteButton" Content="Delete User" Grid.Row="8" Grid.Column="0" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0" Click="DeleteButton_Click" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>