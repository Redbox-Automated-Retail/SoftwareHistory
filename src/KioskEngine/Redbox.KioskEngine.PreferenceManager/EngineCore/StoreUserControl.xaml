<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.EngineCore.StoreUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.EngineCore" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#FF708090" DockPanel.Dock="Top" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <TextBlock Text="Store Number" Grid.Row="0" Margin="0,13,0,0" />
          <TextBox Name="StoreNumberTextBox" Grid.Row="0" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,13,0,0" Text="{Binding Path=StoreNumber}" />
          <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="0,23,0,3" VerticalAlignment="Bottom">
            <CheckBox Name="RunInitialSyncCheckBox" Grid.Row="1" IsChecked="{Binding Path=RunInitialSync}">
              <TextBlock Text="Run Initial Sync" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <TextBlock Text="Initial Sync Type" Grid.Row="3" />
          <ComboBox Name="InitialSyncTypeComboBox" Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding Path=InitialSyncType}">
            <ComboBoxItem Tag="Foreground">Foreground</ComboBoxItem>
            <ComboBoxItem Tag="Background">Background</ComboBoxItem>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" Margin="0,23">
            <CheckBox Name="IsStandAloneCheckBox" Grid.Row="1" IsChecked="{Binding Path=IsStandAlone}">
              <TextBlock Text="Stand Alone Mode" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>