<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.TransactionService.AuthorizeResultUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.TransactionService" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#7092BE" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3">
            <CheckBox Name="LiveCallCheckBox" Grid.Row="1" IsChecked="{Binding LiveCall}">
              <TextBlock Text="Live Call" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3">
            <CheckBox Name="SimulateCommunicationsFailureCheckBox" Grid.Row="1" IsChecked="{Binding SimulateCommunicationFailure}">
              <TextBlock Text="Simulate Communications Failure" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <TextBlock Text="Authorize Response" Grid.Row="2" Grid.Column="0" FontSize="10" VerticalAlignment="Center" />
          <ComboBox Name="AuthorizeResponseErrorComboBox" Grid.Row="2" Grid.Column="1" MaxDropDownHeight="200" Width="350" HorizontalAlignment="Left" Margin="0,3" SelectedItem="{Binding Path=AuthorizeResponseError}" />
          <TextBlock Text="Account Number" Grid.Row="4" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="AccountNumberTextbox" Grid.Row="4" Grid.Column="1" Width="350" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=AccountNumber}" />
          <CheckBox Name="HasCustomerProfileCheckBox" Grid.Row="5" VerticalAlignment="Center" Margin="0,3" IsChecked="{Binding Path=HasCustomerProfile}">
            <TextBlock Text="Has Customer Profile" FontSize="10" Margin="0,1" />
          </CheckBox>
          <TextBlock Text="Customer Profile Number" Grid.Row="6" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="CustomerProfileNumberTextbox" Grid.Row="6" Grid.Column="1" Width="350" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=CustomerProfileNumber}" />
          <TextBlock Text="Customer Profile First Name" Grid.Row="7" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="CustomerProfileFirstNameTextbox" Grid.Row="7" Grid.Column="1" Width="350" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=CustomerProfileFirstName}" />
          <TextBlock Text="Customer Profile Last Name" Grid.Row="8" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="CustomerProfileLastNameTextbox" Grid.Row="8" Grid.Column="1" Width="350" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=CustomerProfileLastName}" />
          <TextBlock Text="Email" Grid.Row="9" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="EmailTextbox" Grid.Row="9" Grid.Column="1" Width="350" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=Email}" />
          <TextBlock Text="Reference Number" Grid.Row="11" FontSize="10" VerticalAlignment="Center" />
          <TextBox Name="ReferenceNumberTextbox" Grid.Row="11" Grid.Column="1" Width="350" Height="18" VerticalAlignment="Center" Margin="0,3" HorizontalAlignment="Left" Text="{Binding Path=ReferenceNumber}" />
          <TextBlock Text="Confirmation Status" Grid.Row="12" FontSize="10" VerticalAlignment="Center" />
          <ComboBox Name="ConfirmationStatusComboBox" Grid.Row="12" Grid.Column="1" MaxDropDownHeight="200" Width="350" Margin="0,3" HorizontalAlignment="Left" SelectedItem="{Binding Path=ConfirmationStatusItem}" />
          <TextBlock Text="Note: These results apply to Authorize, PickupAuthorize, ReservationAuthorize" Grid.Row="13" Grid.Column="1" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>