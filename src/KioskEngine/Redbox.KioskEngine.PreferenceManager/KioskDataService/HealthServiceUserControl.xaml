<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.KioskDataService.HealthServiceUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.KioskDataService" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <StackPanel Orientation="Vertical">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#FFD2691E" DockPanel.Dock="Top" RefreshButtonVisibilty="Visible" SaveButtonVisibilty="Visible" />
      <StackPanel Margin="20,5,0,5">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" Margin="0,3">
            <CheckBox Name="LiveCallCheckBox" Grid.Row="1" IsChecked="{Binding LiveCall}">
              <TextBlock Text="Live Call" FontSize="10" Margin="0,1" />
            </CheckBox>
          </StackPanel>
          <TextBlock Text="Ping Period (milliseconds)" Grid.Row="1" Margin="0,20,0,0" />
          <TextBox Name="PingPeriodTextBox" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,20,0,0" Text="{Binding Path=PingPeriod}" />
          <Button Name="PingButton" Content="Ping" Width="100" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,5,0,0" Click="PingButton_Click" />
          <TextBlock Text="Local Test Configuration" Grid.Row="3" Margin="0,20,0,0" TextDecorations="Underline" />
          <TextBlock Text="SMTP Server" Grid.Row="4" />
          <TextBox Name="SMTPServerTextBox" Grid.Row="4" Grid.Column="1" Width="300" HorizontalAlignment="Left" Text="{Binding Path=SmtpServer}" />
          <TextBlock Text="Recipients" Grid.Row="5" Margin="0,5,0,0" />
          <TextBox Name="RecipientsTextBox" Grid.Row="5" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,5,0,0" Text="{Binding Path=Recipients}" />
          <Button Name="TestKioskAlertButton" Content="Test Kiosk Alert" Width="100" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" Margin="0,5,0,0" Click="TestKioskAlertButton_Click" />
        </Grid>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>