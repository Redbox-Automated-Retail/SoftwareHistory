<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Redbox.KioskEngine.PreferenceManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager" Title="Kiosk Engine Preference Manager" Height="700" Width="900" WindowStartupLocation="CenterScreen" Activated="Window_Activated">
  <UIElement.CommandBindings>
    <CommandBinding x:Name="CloseCommand" Command="ApplicationCommands.Close" Executed="CloseCommand_Executed" />
    <CommandBinding x:Name="PopOutCommand" Command="{x:Static local:PreferenceManagerCommands.PopOutCommand}" Executed="PopOutCommand_Executed" />
  </UIElement.CommandBindings>
  <Grid>
    <DockPanel LastChildFill="True">
      <Grid Name="BottomGrid" Background="#d0d0d0" DockPanel.Dock="Bottom" Height="60" VerticalAlignment="Bottom">
        <Button Name="CloseButton" Content="Close" Height="30" Width="80" HorizontalAlignment="Right" Margin="0,0,20,0" Command="ApplicationCommands.Close" />
      </Grid>
      <Grid Name="TabGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TreeView Name="NavigationTree" Grid.Column="0" SelectedItemChanged="NavigationTree_SelectedItemChanged" />
        <Grid Name="PreferencePageHostGrid" Column="2" />
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
        <Grid Name="PanelHostGrid" Column="2" />
      </Grid>
    </DockPanel>
    <Label Name="StatusLabel" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFF0000" FontSize="22" />
  </Grid>
</Window>