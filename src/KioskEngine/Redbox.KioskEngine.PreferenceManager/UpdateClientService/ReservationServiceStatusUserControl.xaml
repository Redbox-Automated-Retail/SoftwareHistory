<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.KioskEngine.PreferenceManager.UpdateClientService.ReservationServiceStatusUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.KioskEngine.PreferenceManager.UpdateClientService" xmlns:controls="clr-namespace:Redbox.KioskEngine.PreferenceManager.Controls">
  <Grid Background="#FFFFFFFF">
    <DockPanel LastChildFill="True">
      <controls:PreferencePageHeaderUserControl x:Name="PreferencePageHeaderUserControl" HeaderBackgroundColor="#709060" DockPanel.Dock="Top" />
      <ScrollViewer>
        <StackPanel Orientation="Vertical">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
              <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <Label Content="Registered with Broker Service" Grid.Row="0" Grid.Column="0" />
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
              <CheckBox VerticalAlignment="Center" IsEnabled="False" Margin="0,0,10,0" IsChecked="{Binding IsRegisteredWithBrokerService}" />
              <Button Name="RegisterButton" Content="Register" Width="100" Margin="15,0,15,0" Click="RegisterButton_Click" />
              <Button Name="UnregisterButton" Content="Unregister" Width="100" Margin="15,0,15,0" Click="UnregisterButton_Click" />
            </StackPanel>
            <Label Content="Broker Service registration DateTime" Grid.Row="1" Grid.Column="0" />
            <Label Grid.Row="1" Grid.Column="1" Content="{Binding BrokerServiceRegistrationDateTime}" />
            <Label Content="Recommendation On Pickup Enabled" Grid.Row="2" Grid.Column="0" />
            <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" IsChecked="{Binding RecommendationOnPickupEnabled}" />
            <Label Content="Authorize at Pickup Enabled" Grid.Row="3" Grid.Column="0" />
            <CheckBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" IsChecked="{Binding AuthorizeAtPickup}" />
            <Label Content="Gift Cards Enabled" Grid.Row="4" Grid.Column="0" />
            <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" IsChecked="{Binding GiftCardsEnabled}" />
            <Label Content="Kiosk Engine Version" Grid.Row="5" Grid.Column="0" />
            <Label Grid.Row="5" Grid.Column="1" Content="{Binding KioskEngineVersion}" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>