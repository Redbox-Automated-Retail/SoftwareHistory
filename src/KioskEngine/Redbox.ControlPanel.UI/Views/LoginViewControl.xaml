<?xml version="1.0" encoding="utf-8"?>
<local:ViewControl x:Class="Redbox.ControlPanel.UI.Views.LoginViewControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.ControlPanel.UI.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary />
  </FrameworkElement.Resources>
  <Grid Name="MainElement">
    <Border Width="640" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#FF000000" Background="#CDCDCD" CornerRadius="10">
      <Border CornerRadius="10">
        <Redbox:GridExt RowHeights="50,2*,3*" ColumnWidths="*">
          <Grid Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource login_text_style}" Padding="0,4,0,0" Text="{Binding Title, FallbackValue=Redbox Control Panel Login}" />
            </StackPanel>
          </Grid>
          <Grid Row="1" Background="#FFFFFFFF">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Name="ImageElem1" Source="pack://Application:,,,/Redbox.ControlPanel.UI;component/Assets/Images/redbox-logo3.jpg" VerticalAlignment="Center" Height="100" />
            </StackPanel>
          </Grid>
          <Redbox:GridExt Row="2" Background="#CDCDCD" RowHeights="auto,*,*,2*" FocusManager.IsFocusScope="True">
            <TextBlock Name="ErrorTextElem" Grid.Row="0" Style="{StaticResource login_text_style}" FontWeight="Light" Margin="0,6,0,0" Foreground="#FFFF0000" HorizontalAlignment="Center" Text="{Binding ErrorMessage, FallbackValue=...}" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,80,0" FocusManager.IsFocusScope="True">
              <TextBlock Style="{StaticResource login_text_style}" Padding="0,4,0,0" Text="User ID: " />
              <TextBox Name="UserIdElem" Style="{StaticResource login_text_box_style}" Padding="2,3,0,0" FontWeight="Light" KeyUp="UserIdElem_KeyUp" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,80,0">
              <TextBlock Style="{StaticResource login_text_style}" Padding="0,4,0,0" Text="Password: " />
              <PasswordBox Name="PasswordElem" Style="{StaticResource login_password_box_style}" Padding="2,3,0,0" FontWeight="Light" KeyUp="PasswordElem_KeyUp" />
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button Name="LoginButtonElem" FontSize="20" Margin="0,0,40,0" Width="180" Height="50" IsDefault="True" IsEnabled="{Binding EnableLogin}" Click="LoginButton_Pressed" IsEnabledChanged="LoginButtonElem_IsEnabledChanged">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Login" Margin="20,0" />
                  <Redbox:SpinControl Name="SpinElem" Visibility="Collapsed" Period="1" Radius="12" RepeatForever="True" IsAnimated="True" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Image Source="pack://Application:,,,/Redbox.ControlPanel.UI;component/Assets/Images/small_progress_indecator.png" VerticalAlignment="Center" HorizontalAlignment="Right" Height="24" />
                  </Redbox:SpinControl>
                </StackPanel>
              </Button>
              <Button Name="CloseButtonElem" Content="Close" FontSize="20" Margin="40,0,0,0" Width="180" Height="50" Click="CloseButton_Pressed" />
            </StackPanel>
          </Redbox:GridExt>
        </Redbox:GridExt>
        <UIElement.Clip>
          <RectangleGeometry Rect="0,0,638,448" RadiusX="10" RadiusY="10" />
        </UIElement.Clip>
      </Border>
    </Border>
  </Grid>
</local:ViewControl>