<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.ControlPanel.UI.Views.CloseKioskViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.ControlPanel.UI.Views" xmlns:animations1="clr-namespace:Redbox.Rental.UI.Controls.Animations;assembly=Redbox.Rental.UI">
  <Canvas Background="#00FFFFFF" Height="768" Width="1024">
    <Rectangle Fill="#FF000000" Stroke="#FF000000" Height="768" Width="1024" Opacity=".5" />
    <Grid Canvas.Left="200" Canvas.Top="150" VerticalAlignment="Center" HorizontalAlignment="Center" ShowGridLines="False">
      <Border Background="#FFFFFFFF" CornerRadius="28" BorderBrush="#A21018" BorderThickness="5">
        <Grid Width="624" Height="468" ShowGridLines="False" Background="#FFFFFFFF" Margin="20,20,20,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="10*" />
            <RowDefinition Height="40*" />
            <RowDefinition Height="20*" />
            <RowDefinition Height="20*" />
            <RowDefinition Height="5*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" />
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="20*" />
          </Grid.ColumnDefinitions>
          <animations1:SpinnerUserControl Name="Spinner" Margin="245,0,0,0" VerticalAlignment="Top" Grid.Column="1" Grid.Row="2" />
          <TextBlock Name="header_textbox" Grid.Column="0" Grid.ColumnSpan="3" Width="524" Height="Auto" HorizontalAlignment="Left" Margin="40,0,0,0" Grid.Row="0" Text="Warning!" VerticalAlignment="Top" Foreground="#970E16" FontSize="31.92" Style="{StaticResource x_text_block_style}" x:FieldModifier="public" />
          <TextBlock Name="message_text" Grid.Column="1" Grid.ColumnSpan="3" Width="524" Height="Auto" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" Text="Are You Sure" VerticalAlignment="Top" Style="{StaticResource x_text_block_style}" x:FieldModifier="public" />
          <TextBox Name="confirm_textbox" Grid.Column="1" Grid.ColumnSpan="3" Margin="68,16,96,2" Grid.Row="2" Text="" Width="337" Height="64" Style="{StaticResource x_text_box_style}" x:FieldModifier="public" TextChanged="ConfirmTextBoxTextChanged" />
          <Button Name="button_no" Content="No" Grid.Column="1" HorizontalAlignment="left" Grid.Row="3" VerticalAlignment="Bottom" Width="150" Height="75" IsDefault="True" Style="{StaticResource glass_rounded_button_style}" x:FieldModifier="public" Click="ButtonNoClick" />
          <Button Name="button_yes" Content="Yes" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Grid.Row="3" VerticalAlignment="Bottom" Width="150" Height="75" Style="{StaticResource glass_rounded_button_style}" IsDefault="True" x:FieldModifier="public" />
        </Grid>
      </Border>
    </Grid>
  </Canvas>
</UserControl>