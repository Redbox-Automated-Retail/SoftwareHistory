<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.ControlPanel.UI.Views.DisplayViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:views="clr-namespace:Redbox.ControlPanel.UI.Views;assembly=Redbox.ControlPanel.UI">
  <Canvas Background="#00FFFFFF" Height="768" Width="1024">
    <Rectangle Fill="#FF000000" Stroke="#FF000000" Height="768" Width="1024" Opacity=".5" />
    <Grid Canvas.Left="200" Canvas.Top="150" VerticalAlignment="Center" HorizontalAlignment="Center" ShowGridLines="False">
      <Border Background="#FFFFFFFF" CornerRadius="28" BorderBrush="#A21018" BorderThickness="5">
        <Grid Width="624" Height="250" ShowGridLines="False" Background="#FFFFFFFF" Margin="20,17,20,23">
          <Grid.RowDefinitions>
            <RowDefinition Height="20*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="25*" />
            <RowDefinition Height="5*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*" />
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="20*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Width="524" Height="Auto" HorizontalAlignment="Left" Margin="40,0,0,0" Grid.Row="0" Text="Display Settings" VerticalAlignment="Top" Foreground="#970E16" FontSize="31.92" Style="{StaticResource x_text_block_style}" />
          <TextBlock Grid.Column="1" Grid.ColumnSpan="1" Width="524" Height="auto" HorizontalAlignment="Left" Grid.Row="1" TextWrapping="Wrap" Text="Resolution" VerticalAlignment="Top" Style="{StaticResource x_text_block_style}" />
          <ComboBox Name="resolution_combo" Grid.Column="1" Grid.ColumnSpan="4" Width="540" Height="Auto" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top" Style="{StaticResource control_panel_display_combobox}" x:FieldModifier="public" />
          <Button Name="button_save" Content="Save" Grid.Column="1" HorizontalAlignment="left" Grid.Row="3" VerticalAlignment="Bottom" Width="150" Height="75" IsDefault="True" Style="{StaticResource control_panel_glass_rounded_button_style}" x:FieldModifier="public" Click="ButtonSaveClick" />
          <Button Content="Cancel" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Grid.Row="3" VerticalAlignment="Bottom" Width="150" Height="75" Style="{StaticResource control_panel_glass_rounded_button_style}" IsDefault="True" Click="CloseClick" />
        </Grid>
      </Border>
    </Grid>
  </Canvas>
</UserControl>