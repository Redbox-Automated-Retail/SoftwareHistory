<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Redbox.Controls">
  <Style x:Key="{x:Type local:SectionalBar}" TargetType="{x:Type local:SectionalBar}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:SectionalBar}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type local:GroupButton}" TargetType="{x:Type local:GroupButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:GroupButton}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type local:SimpleList}" TargetType="{x:Type local:SimpleList}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:SimpleList}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type local:RoundedButton}" TargetType="{x:Type local:RoundedButton}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#FFFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource RubineRedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource RubineRedBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:BorderButton}">
          <Border BorderThickness="0" Background="{Binding Path=Background, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Background="#00FFFFFF" BorderBrush="{Binding Path=BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="{Binding Path=CornerRadius, RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="{Binding Path=BorderThickness, RelativeSource={RelativeSource TemplatedParent}}">
              <UIElement.Effect>
                <DropShadowEffect Direction="300" ShadowDepth="3" Opacity="1" RenderingBias="Quality" BlurRadius="6" Color="{Binding Path=EffectColor, RelativeSource={RelativeSource TemplatedParent}}" />
              </UIElement.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <UIElement.Clip>
              <RectangleGeometry Rect="{Binding Path=BorderSize.Rect, RelativeSource={RelativeSource TemplatedParent}}" RadiusX="{Binding Path=SingleRadius, RelativeSource={RelativeSource TemplatedParent}}" RadiusY="{Binding Path=SingleRadius, RelativeSource={RelativeSource TemplatedParent}}" />
            </UIElement.Clip>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>