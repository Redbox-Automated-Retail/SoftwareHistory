<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.FMA.Views.ShowPlanogramViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Redbox.FMA.Views" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Redbox:NullToVisibilityConverter x:Key="NullToVisibility" />
      <Style x:Key="DocumentViewerStyle" TargetType="{x:Type DocumentViewer}" BasedOn="{x:Null}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DocumentViewer}">
              <Border BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Focusable="False">
                <Grid Background="{TemplateBinding Control.Background}" KeyboardNavigation.TabNavigation="Local">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ScrollViewer Name="PART_ContentHost" CanContentScroll="True" Grid.Column="0" Focusable="{TemplateBinding UIElement.Focusable}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" IsTabStop="True" Grid.Row="1" TabIndex="1" />
                  <DockPanel Grid.Row="1">
                    <FrameworkElement DockPanel.Dock="Right" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
                  </DockPanel>
                  <ContentControl Name="PART_FindToolBarHost" Visibility="Collapsed" Grid.Column="0" Focusable="{TemplateBinding UIElement.Focusable}" Grid.Row="2" TabIndex="2" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Redbox:GridExt RowHeights="50,*,50" ColumnWidths="1024" HorizontalAlignment="Left">
    <Redbox:GridExt Row="0" ColumnWidths="50,890,84" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FF8B0000">
      <Polygon Grid.Column="0" Points="0,0 0,50 50,25 0,0" Stroke="#FFFFFFFF" Stretch="Fill" StrokeThickness="1" Fill="#FFFFFFFF" HorizontalAlignment="Right" Margin="0,0,0,0" Width="50" />
      <Label Name="title_area" Grid.Column="1" Style="{StaticResource title_label_style}" Margin="40,0,0,0" IsTabStop="False" Focusable="False" Content="{Binding Name}" />
      <Button Name="close_button" Grid.Column="2" Content="X" Height="50" Width="78" Padding="0" Margin="0" HorizontalAlignment="Right" Style="{StaticResource x_flat_button_gray_style}" Background="#FFD3D3D3" IsTabStop="False" Focusable="False" Command="{Binding CloseCommand}" />
    </Redbox:GridExt>
    <DocumentViewer Grid.Row="1" Style="{StaticResource DocumentViewerStyle}" Document="{Binding XpsDocumentSource}" Visibility="{Binding XpsDocumentSource, Converter={StaticResource NullToVisibility}}" Redbox:DocumentViewerHelper.DocumentScaling="{Binding DocumentScaling}" />
    <RichTextBox Grid.Row="1" Redbox:RichTextBoxHelper.DocumentRtf="{Binding rtfDocument}" Visibility="{Binding rtfDocument, Converter={StaticResource NullToVisibility}}" />
    <Redbox:GridExt Row="2" ColumnWidths="500,*" Background="#FF8B0000">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0,0,0">
        <Button Content="Fit Height" Margin="5" Padding="5" Command="{Binding FitHeightCommand}" Visibility="{Binding XpsDocumentSource, Converter={StaticResource NullToVisibility}}" />
        <Button Content="Fit Width" Margin="5" Padding="5" Command="{Binding FitWidthCommand}" Visibility="{Binding XpsDocumentSource, Converter={StaticResource NullToVisibility}}" />
        <Button Content="Default Scale" Margin="5" Padding="5" Command="{Binding DefaultScaleCommand}" Visibility="{Binding XpsDocumentSource, Converter={StaticResource NullToVisibility}}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0">
        <Button Content="Select Planogram" Margin="5" Padding="5" HorizontalAlignment="Right" Command="{Binding SelectCommand}" />
      </StackPanel>
    </Redbox:GridExt>
  </Redbox:GridExt>
</UserControl>