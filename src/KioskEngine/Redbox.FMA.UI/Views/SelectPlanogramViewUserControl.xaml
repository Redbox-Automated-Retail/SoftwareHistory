<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Redbox.FMA.Views.SelectPlanogramViewUserControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:Redbox="clr-namespace:Redbox.Controls;assembly=Redbox.Controls" xmlns:local="clr-namespace:Redbox.FMA.Views">
  <Redbox:GridExt RowHeights="50,*, 50">
    <Redbox:GridExt Row="0" ColumnWidths="50,890,84" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FF8B0000">
      <Polygon Grid.Column="0" Points="0,0 0,50 50,25 0,0" Stroke="#FFFFFFFF" Stretch="Fill" StrokeThickness="1" Fill="#FFFFFFFF" HorizontalAlignment="Left" Margin="0,0,0,0" Width="50" />
      <Label Name="title_area" Grid.Column="1" Content="Select Planogram" Style="{StaticResource title_label_style}" Margin="40,0,0,0" IsTabStop="False" Focusable="False" />
      <Button Name="close_button" Grid.Column="2" Content="X" Height="50" Width="78" Padding="0" Margin="0" HorizontalAlignment="Right" Style="{StaticResource x_flat_button_gray_style}" IsTabStop="False" Focusable="False" Command="{Binding CloseCommand}" />
    </Redbox:GridExt>
    <ListView Grid.Row="1" ItemsSource="{Binding Planograms}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:Name="PlanogramDataTemplate">
          <Button Width="955" Height="50" Margin="0" Style="{StaticResource wp_rounded_button_style}" Background="#FFD3D3D3" Foreground="#FF000000" Content="{Binding Name}" Command="{Binding Path=DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListView>
    <Grid Row="2" Background="#FF8B0000">
      <Button Margin="40,5,5,5" Content="Force Sync" Width="100" HorizontalAlignment="Left" Command="{Binding ForceSyncCommand}" />
    </Grid>
  </Redbox:GridExt>
</UserControl>