<?xml version="1.0"?>
<resource type="table">
	<property name="name" value="tickets_strings" />
	<aspect name="content">
		<row>
			<column name="auth_text">Please wait while we authorize your transaction.</column>

			<column name="email_confirmation_text">An email confirmation will be sent within 1 minute of your purchase.&#10;Ticket delivery info is on the next screen.</column>

			<column name="max_quantity_message_title">Max quantity reached</column>
			<column name="max_quantity_message">We're sorry but you've reached the maximum number of tickets for this production.</column>
			<column name="min_quantity_message_title">Whoops</column>
			<column name="min_quantity_message">Please select at least one ticket.</column>

			<column name="sorry">Sorry</column>
			<column name="out_of_stock">Out of stock</column>
			<column name="out_of_stock_message">We couldn't find the seats available that match&#10;your selection.</column>
			<column name="no_tickets_found_message">We couldn't find the seats available that match&#10;your selection.</column>
			<column name="please_choose_another_date">Please choose another date.</column>
			<column name="no_contigious_seats_message">We couldn't find seats together that match&#10;your selection.</column>
			<column name="offline_or_fatal_transaction_message">We cannot process your tickets transaction at this time.&#10;Please try again.</column>
			<column name="cannot_process_tickets_transaction_message">We're sorry we cannot process your tickets transaction at this time.&#10;Please try again later or check redbox.com.</column>

			<column name="email_header">EMAIL ADDRESS</column>
			<column name="email_error_message">Please enter a valid email address.</column>
			<column name="email_message_print_at_home">The only way to get your tickets is to enter your email address here.</column>
			<column name="email_message_will_call">The only way to get a receipt is to enter your email address here.</column>
			<column name="email_message_receive_event_info">Receive event information by entering your email address here.</column>
			<column name="browse_button_with_arrow_text">    BROWSE</column>
			<column name="email_me">Email me </column>

			<column name="age_restrictions_header">Age Restrictions Apply</column>
			<column name="age_restrictions_text">The event you've chosen is for %s %s.&#010;&#010;You'll need a government-issued ID to enter.</column>

			<column name="are_you_sure">Are you sure?</column>
			<column name="shopping_cart_remove_tickets">If you choose to remove your tickets they will no longer be held by Redbox.</column>

			<column name="will_call_confirmation_text">You've chosen will call, which means someone will need to present&#010;an ID at the box office to pick up these tickets.&#010;&#010;Do we have that person's name right?&#010;&#010;(You can always change it on redbox.com later.)</column>

			<column name="cust_name_header">WHO'S PICKING UP THE TICKETS?</column>
			<column name="cust_name_message">Please enter the first and last name on their ID.</column>

			<column name="confirmation_header">Thanks, and enjoy!</column>
			<column name="confirmation_body_1_will_call">Check your email for your receipt.</column>
			<column name="confirmation_body_1_email">Check your email for your tickets &#038; receipt.</column>
			<column name="confirmation_body_2">Please visit www.redbox.com/tickets for info on our no hassle refund policy.</column>

			<column name="place_order_card_not_authorized">Your card could not be authorized.</column>
			<column name="place_order_not_complete">We cannot complete your tickets transaction at this time.&#010;Please try again or visit redbox.com.</column>
			<column name="place_order_authentication_issue">This kiosk is currently experiencing an authentication issue.</column>

			<column name="CANCEL">CANCEL</column>
			<column name="CONTINUE">CONTINUE</column>
			<column name="YES">YES</column>
			<column name="NO">NO</column>
			<column name="OK">OK</column>
			<column name="REMOVE">REMOVE</column>

			<column name="how_it_works_point_3">Buy your tickets (and pay only ${0} a ticket in fees)</column>
			<column name="tickets_browse_get_local_tickets2_label">for only ${0} a ticket in fees!</column>

			<column name="disclaimer_bytheway">By the way:</column>
			<column name="disclaimer_rejected_note">Unfortunately, if you click "No", you won't be able to complete this purchase, and the tickets will be removed from your cart.</column>
			<column name="more_time_prompt_message">Need more time?</column>
			<column name="no_thanks_button">NO THANKS</column>

			<column name="event_future_dates">Future dates may be available on redbox.com</column>
		</row>
	</aspect>
</resource>
