<?xml version="1.0"?>
<resource type="view">
  <property name="name" value="keypad_popup_alert_view" />
  <aspect name="content">
    <scene name="SlotPopup"
      clear="false"
      viewWindow="162,68,1024,768"
      onEnter="keypad_popup_enter"
      onLeave="keypad_popup_leave" >

		<actor
		name="lightbox"
		x="-162"
		y="-68"
		height="768"
		width="1024"
		backgroundColor="black"
		opacity="0.5"
		optionFlags="Background"
		/>
		
 		<actor
		name="background"
		x="0"
		y="0"
		width="728"
		height="644"
		backgroundColor="Gray"
		strokeWeight="3.0"
		borderColor="192,192,192"
		cornerSize="10,10"
		optionFlags="Background, DrawBorder"
        hitFlags="Enabled, Obstruction"
		/>

		<actor
		name="title_area"
		x="2"
		y="2"
		optionFlags="Background, Text, TextShadow, DrawRoundedCorners"
		backgroundColor="DarkRed"
		text="Enter # Of NR's That Can't Be Inserted"
		foregroundColor="White"
		verticalAlignment="center"
		font="medium_larger_font"
		cornerSize="10,10"
		width="721"
		height="50"
		/>

		<actor
		name="close_area"
		x="651"
		y="0"
		width="77"
		height="52"
		verticalAlignment="center"
		horizontalAlignment="center"
		foregroundColor="White"
		backgroundColor="192,192,192"
		cornerSize="10,10"
		font="medium_larger_font"
		text= "X"
		onHit="go_back"
		hitFlags="Enabled"
		optionFlags="Background, Text, DrawRoundedCorners"
		/>

      <actor
		name="slot_textbox"
		x="223"
		y="80"
		width="282"
		height="55"
		font="large_font"
		foregroundColor="black"
		backgroundColor="white"
		verticalAlignment="center"
		horizontalAlignment="center"
		strokeWeight="2.0"
		borderColor="black"
		cornerSize="10,10"
        optionFlags="Background, Text, TextShadow, DrawBorder"
		text="${keyboard:slot_textbox}"
		hitFlags="Enabled" />

      <actor
		name="1_button"
		x="193"
		y="145"
		width="114"
		height="94"
		strokeWeight="3.0"
		borderColor="64,64,64"
		backgroundColor="192,192,192"
		foregroundColor="black"
