<?xml version="1.0"?>
<resource type="stylesheet">
	<property name="name" value="style_sheet_common_fma" />
	<aspect name="content">
		<style name="red_button_style">
			<state name="enabled">
				<property name="gradientAngle" value="90" />
				<property name="borderColor" value="White" />
				<property name="backgroundColor" value="DarkRed" />
				<property name="foregroundColor" value="white" />
				<property name="strokeWeight" value="3" />
				<property name="verticalAlignment" value="center" />
				<property name="horizontalAlignment" value="center" />
				<property name="hitFlags" value="Enabled" />
				<property name="optionFlags" value="Background, DrawBorder, Text, TextShadow" />
			</state>
			<state name="disabled">
				<property name="gradientAngle" value="90" />
				<property name="borderColor" value="White" />
				<property name="backgroundColor" value="160,160,160" />
				<property name="foregroundColor" value="224,224,224" />
				<property name="strokeWeight" value="3" />
				<property name="verticalAlignment" value="center" />
				<property name="horizontalAlignment" value="center" />
				<property name="hitFlags" value="Enabled" />
				<property name="optionFlags" value="Background, DrawBorder, Text, TextShadow" />
			</state>
		</style>
		<style name="yellow_button_style">
			<state name="enabled">
				<property name="gradientAngle" value="90" />
				<property name="borderColor" value="Black" />
				<property name="backgroundColor" value="Gold" />
				<property name="foregroundColor" value="Black" />
				<property name="strokeWeight" value="3" />
				<property name="verticalAlignment" value="center" />
				<property name="horizontalAlignment" value="center" />
				<property name="hitFlags" value="Enabled" />
				<property name="optionFlags" value="Background, DrawBorder, Text" />
			</state>
			<state name="disabled">
				<property name="gradientAngle" value="90" />
				<property name="borderColor" value="White" />
				<property name="backgroundColor" value="160,160,160" />
				<property name="foregroundColor" value="224,224,224" />
				<property name="strokeWeight" value="3" />
				<property name="verticalAlignment" value="center" />
				<property name="horizontalAlignment" value="center" />
				<property name="hitFlags" value="Enabled" />
				<property name="optionFlags" value="Background, DrawBorder, Text, TextShadow" />
			</state>
		</style>
		<style name="green_button_style">
			<state name="enabled">
				<property name="gradientAngle" value="90" />
				<property name="borderColor" value="White" />
				<property name="backgroundColor" value="Green" />
				<property name="foregroundColor" value="white" />
				<property name="strokeWeight" value="3" />
				<property name="verticalAlignment" value="center" />
				<property name="horizontalAlignment" value="center" />
				<property name="hitFlags" value="Enabled" />
				<property name="optionFlags" value="Background, DrawBorder, Text, TextShadow" />
			</state>
			<state name="disabled">
				<property name="gradientAngle" value="90" />
				<property name="borderColor" value="White" />
				<property name="backgroundColor" value="160,160,160" />
				<property name="foregroundColor" value="224,224,224" />
				<property name="strokeWeight" value="3" />
				<property name="verticalAlignment" value="center" />
				<property name="horizontalAlignment" value="center" />
				<property name="hitFlags" value="Enabled" />
				<property name="optionFlags" value="Background, DrawBorder, Text, TextShadow" />
			</state>
		</style>
	</aspect>
</resource>