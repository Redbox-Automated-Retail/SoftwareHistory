<?xml version="1.0"?>
<resource type="view">
  <property name="name" value="datetime_popup_view" />
  <aspect name="content">
    <scene name="DatetimePopup"
      clear="false"
      onEnter="datetime_popup_view_enter"
      viewWindow="149,62,726,642" >

 		<actor
		name="background"
		x="0"
		y="0"
		width="726"
		height="642"
		backgroundColor="Gray"
		strokeWeight="3.0"
		borderColor="192,192,192"
		cornerSize="10,10"
		optionFlags="Background, DrawBorder"
        hitFlags="Enabled, Obstruction"
		/>

		<actor
		name="title_area"
		x="2"
		y="2"
		optionFlags="Background, Text, TextShadow, DrawRoundedCorners"
		backgroundColor="DarkRed"
		text="  Job Start Time"
		foregroundColor="White"
		verticalAlignment="center"
		font="medium_larger_font"
		cornerSize="10,10"
		width="721"
		height="50"
		/>

		<actor
		name="close_area"
		x="649"
		y="0"
		width="77"
		height="52"
		verticalAlignment="center"
		horizontalAlignment="center"
		foregroundColor="White"
		backgroundColor="192,192,192"
		cornerSize="10,10"
		font="medium_larger_font"
		text= "X"
		onHit="go_back"
		hitFlags="Enabled"
		optionFlags="Background, Text, DrawRoundedCorners"
		/>

      <actor
		name="time_groupbox"
		x="67"
		y="107"
		width="601"
		height="160"
		cornerSize="10,10"
		strokeWeight="2.0"
		borderColor="white"
		optionFlags="DrawBorder"
		visible="true"
