<?xml version="1.0"?>
<resource type="view">
	<property name="name" value="login_view" />
	<aspect name="content">
			
		<scene
			name="Login"
			width="1024"
			height="768"
			onEnter="login_view_enter"
			onLeave="login_view_leave"
			backgroundColor="white">
		
		<actor
			name="login_label"
			x="309"
			y="87"
			width="127"
			height="35"
			font="medium_large_font"
			verticalAlignment="center"
			horizontalAlignment="near"
			text="Login"
			optionFlags="Text"
			foregroundColor="black" />

		<actor
			name="password_label"
			x="309"
			y="138"
			width="127"
			height="35"
			font="medium_large_font"
			verticalAlignment="center"
			horizontalAlignment="near"
			text="Password"
			optionFlags="Text"
			foregroundColor="black" />

		<actor
			name="panel_tag"
			x="24"
			y="301"
			width="975"
			height="415"
			backgroundColor="firebrick"
			cornerSize="5,5"
			optionFlags="Background" />

		<actor
			name="message_label"
			x="269"
			y="21"
			width="499"
			height="29"
			font="message_font"
			verticalAlignment="center"
			horizontalAlignment="center"
			text="Invalid UserName/Password"
			optionFlags="Text, TextShadow"
			foregroundColor="255,128,128"
			visible="false" />

		<actor
			name="login_border"
			x="478"
			y="85"
			width="234"
			height="37"
			foregroundColor="white"
			backgroundColor="red"
			optionFlags="Background" />	

		<actor
			name="login_textbox"
			x="480"
			y="87"
			width="230"
			height="33"
			textRegion="2,0,226,33"
			font="medium_large_font"
			foregroundColor="black"
			backgroundColor="white"
			text="${keyboard:login_textbox}"
			verticalAlignment="center"
			horizontalAlignment="near"
			optionFlags="Text, Background"
			hitFlags="Enabled"
			onHit="activate_textbox" />	

		<actor
			name="password_border"
			x="478"
			y="136"
			width="234"
			height="37"
			foregroundColor="white"
			backgroundColor="black"
			optionFlags="Background" />
		
		<actor
			name="password_textbox"
			x="480"
			y="138"
			width="230"
			height="33"
			textRegion="2,0,226,33"
			font="medium_large_font"
			foregroundColor="black"
			backgroundColor="white"
			text="${keyboard:password_textbox}"
			verticalAlignment="center"
			horizontalAlignment="near"
			optionFlags="Text, Background"
			hitFlags="Enabled"
			onHit="activate_textbox" />

		<actor
			name="login_button"
			x="287"
			y="200"
			width="200"
			height="78"
			font="medium_large_font"
			hitFlags="Enabled"
			text="Login"
			foregroundColor="white"
			backgroundColor="black"
			verticalAlignment="center"
			horizontalAlignment="center"
			cornerSize="10,10"
			optionFlags="Text, Background"
			onHit="authenticate" />

		<actor
			name="cancel_button"
			x="537"
			y="200"
			width="200"
			height="78"
			font="medium_large_font"
			hitFlags="Enabled"
			text="Cancel"
			foregroundColor="Black"
			backgroundColor="LightGray"
			verticalAlignment="center"
			horizontalAlignment="center"
			cornerSize="10,10"
			strokeWeight="3.0"
			borderColor="Black"
			optionFlags="Text, Background, DrawBorder"
